{
  "name": "android-customer-visual-calibration-v4-13",
  "private": true,
  "version": "0.4.13",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:prototype": "playwright test tests/calibration-v3.spec.ts tests/calibration-v4.spec.ts tests/calibration-v4_12.spec.ts tests/calibration-v4_13.spec.ts",
    "test:card-geometry": "node --test tests/product-card-geometry.test.mjs",
    "test:android-branding": "node --test tests/android-branding.test.mjs",
    "test:mobile-runtime": "playwright test tests/mobile-runtime.spec.ts",
    "test:all": "playwright test",
    "test:runtime": "playwright test",
    "test:v4": "npm run test:prototype",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "build:native": "npm run build:native:release",
    "build:native:release": "tsc && vite build --config vite.native.config.ts --mode production",
    "build:native:debug": "tsc && vite build --config vite.native.config.ts --mode debug",
    "build:native:uat": "tsc && vite build --config vite.native.config.ts --mode uat",
    "verify:native": "node scripts/verify-native-bundle.mjs",
    "patch:capacitor": "node scripts/patch-capacitor-bridge.mjs",
    "android:sync": "npm run android:sync:release",
    "android:sync:release": "npm run patch:capacitor && npm run build:native:release && cap sync android && npm run verify:native",
    "android:sync:debug": "npm run patch:capacitor && npm run build:native:debug && cap sync android && npm run verify:native",
    "android:sync:uat": "npm run patch:capacitor && npm run build:native:uat && cap sync android && npm run verify:native",
    "android:assemble:debug": "npm run android:sync:debug && cd android && gradlew.bat assembleDebug",
    "android:assemble:release": "npm run android:sync:release && cd android && gradlew.bat assembleRelease",
    "android:bundle:release": "npm run android:sync:release && cd android && gradlew.bat bundleRelease",
    "capture:v4": "node scripts/capture-v4.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/push-notifications": "8.1.2",
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-payment-logos": "^1.1.0",
    "react-zoom-pan-pinch": "^4.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "postcss": "8.5.26",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
