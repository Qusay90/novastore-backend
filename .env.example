PORT=5000
NODE_ENV=development

# Local Postgres
DATABASE_URL=postgres://user:password@localhost:5432/novastore
DB_SSL=false

# Safe local/test backend mode for runtime QA.
# Use only a local disposable/dev database. Never point this mode at production.
# SKIP_SCHEMA_INIT=true starts the API without running create schema functions.
# NOVASTORE_ALLOW_SCHEMA_INIT=true allows schema preparation only when the DB host is local
# and the database name is not the default "postgres".
NOVASTORE_SAFE_LOCAL_BACKEND=true
SKIP_SCHEMA_INIT=true
NOVASTORE_ALLOW_SCHEMA_INIT=false
# Production remote-target attestation placeholders. Never copy local DB_SSL=false
# into production; the production DATABASE_URL must use sslmode=verify-full.
NOVASTORE_EXPECTED_DATABASE_HOST=
NOVASTORE_EXPECTED_DATABASE_NAME=
NOVASTORE_BIND_HOST=
# UI-only local development preview (explicit opt-in).
# This works only with NODE_ENV=development and must not be used for test, staging,
# UAT, or production. It replaces a configured Supabase target with the local sink
# 127.0.0.1:55432/novastore_preview, skips DB verification, and never initializes
# a schema. The UI can open, but DB-backed APIs will not work without a separately
# provisioned local preview DB.
# Do not combine this with NOVASTORE_ALLOW_REMOTE_DB=true.
# PayTR UAT and real staging require controlled remote/staging DB configuration.
# NOVASTORE_LOCAL_PREVIEW=true
# Example runtime QA command:
# npm run dev:safe
# Example local schema-prep command for a disposable DB only:
# DATABASE_URL=postgres://user:password@localhost:5432/novastore_test
# npm run dev:safe:schema

# Supabase on IPv4-only networks or Windows
# Direct hostlar (db.<project-ref>.supabase.co) bazi ortamlarda yalnizca IPv6 doner.
# Bu durumda Session Pooler kullan:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_USE_POOLER=true
# SUPABASE_REGION=eu-west-1
# SUPABASE_POOLER_MODE=session
# DB_USER=postgres.YOUR_PROJECT_REF
# DB_PORT=5432
# DB_SSL=true
# Alternatif olarak SUPABASE_POOLER_HOST=aws-0-eu-west-1.pooler.supabase.com verebilirsin.

JWT_SECRET=change_me
CLIENT_ORIGIN=http://localhost:5000
APP_BASE_URL=http://localhost:5000
# Production or custom domain example:
# CLIENT_ORIGIN=https://novastore.tr,https://www.novastore.tr
# APP_BASE_URL=https://novastore.tr
# MAIL_FROM=NovaStore Destek <destek@novastore.tr>
RESEND_API_KEY=

# Seller application authority. Supply secrets/revisions through the runtime
# configuration boundary; no legal revision is built into the application.
SELLER_APPLICATION_AUTH_SECRET=
SELLER_APPLICATION_TERMS_REVISION=
SELLER_APPLICATION_TERMS_REVISION_GENERATION=

# First-sale card checkout has one explicit provider. There is no mock payment
# provider or automatic fallback. Missing configuration fails closed.
PAYMENT_PROVIDER=paytr

# Review-ready default: never send a PayTR token request until a separately
# authorized provider-UAT/production runtime sets this exact flag to true.
PAYTR_LIVE_REQUESTS_ALLOWED=false

# PayTR provider placeholders only. Do not commit real credentials or callback
# values. PAYTR_BASE_URL is pinned by the runtime to this official origin.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_BASE_URL=https://www.paytr.com
# These three URLs must use the exact HTTPS APP_BASE_URL origin. The callback
# path is exactly /api/payments/webhook/paytr. PAYTR_SUCCESS_URL (PayTR's
# merchant_ok_url) and PAYTR_FAIL_URL must use /payment-result.html or the
# exact #/odeme/sonuc hash route, without pre-populated query/hash parameters.
PAYTR_CALLBACK_URL=
PAYTR_SUCCESS_URL=
PAYTR_FAIL_URL=
PAYTR_TEST_MODE=true
PAYTR_DEBUG_ON=false

# Exact count of trusted reverse-proxy hops between the public client and this
# Express process. Keep 0 for direct/local traffic. Render/provider activation
# must set the observed topology count explicitly; do not guess this value.
NOVASTORE_TRUST_PROXY_HOPS=0

FREE_SHIPPING_THRESHOLD=1500
DEFAULT_SHIPPING_FEE=49.9
DEFAULT_SHIPMENT_PROVIDER=Yurtici Kargo

# Owner-supplied business identity. Do not invent or commit real company values.
BUSINESS_LEGAL_COMPANY_NAME=
BUSINESS_TRADE_NAME=
BUSINESS_TAX_VKN=
# Optional until owner/legal/PayTR confirms it is required. A legal template that
# references business.taxOffice remains unpublished until this value is present.
BUSINESS_TAX_OFFICE=
BUSINESS_MERSIS_NUMBER=
BUSINESS_REGISTERED_ADDRESS=
BUSINESS_KEP_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=
CUSTOMER_PUBLIC_DOMAIN=
ADMIN_PUBLIC_DOMAIN=
SELLER_WEB_PUBLIC_DOMAIN=
CUSTOMER_ANDROID_APP_ID=
SELLER_ANDROID_APP_ID=
NOVASTORE_REQUIRE_BUSINESS_IDENTITY_FOR_PAYMENT=true

# Public legal documents are owner/legal-approved, versioned runtime content.
# Do not invent text or versions. Every document stays unpublished unless its
# approval is exact true and its version and text are both non-empty.
NOVASTORE_LEGAL_ABOUT_APPROVED=false
NOVASTORE_LEGAL_ABOUT_VERSION=
NOVASTORE_LEGAL_ABOUT_TEXT=
NOVASTORE_LEGAL_PRIVACY_APPROVED=false
NOVASTORE_LEGAL_PRIVACY_VERSION=
NOVASTORE_LEGAL_PRIVACY_TEXT=
NOVASTORE_LEGAL_KVKK_APPROVED=false
NOVASTORE_LEGAL_KVKK_VERSION=
NOVASTORE_LEGAL_KVKK_TEXT=
NOVASTORE_LEGAL_COOKIES_APPROVED=false
NOVASTORE_LEGAL_COOKIES_VERSION=
NOVASTORE_LEGAL_COOKIES_TEXT=
NOVASTORE_LEGAL_MEMBERSHIP_TERMS_APPROVED=false
NOVASTORE_LEGAL_MEMBERSHIP_TERMS_VERSION=
NOVASTORE_LEGAL_MEMBERSHIP_TERMS_TEXT=
NOVASTORE_LEGAL_PRE_INFORMATION_APPROVED=false
NOVASTORE_LEGAL_PRE_INFORMATION_VERSION=
NOVASTORE_LEGAL_PRE_INFORMATION_TEXT=
NOVASTORE_LEGAL_DISTANCE_SALE_APPROVED=false
NOVASTORE_LEGAL_DISTANCE_SALE_VERSION=
NOVASTORE_LEGAL_DISTANCE_SALE_TEXT=
NOVASTORE_LEGAL_CANCELLATION_RETURN_APPROVED=false
NOVASTORE_LEGAL_CANCELLATION_RETURN_VERSION=
NOVASTORE_LEGAL_CANCELLATION_RETURN_TEXT=
NOVASTORE_LEGAL_DELIVERY_SHIPPING_APPROVED=false
NOVASTORE_LEGAL_DELIVERY_SHIPPING_VERSION=
NOVASTORE_LEGAL_DELIVERY_SHIPPING_TEXT=
NOVASTORE_LEGAL_TRANSACTION_GUIDE_APPROVED=false
NOVASTORE_LEGAL_TRANSACTION_GUIDE_VERSION=
NOVASTORE_LEGAL_TRANSACTION_GUIDE_TEXT=
NOVASTORE_LEGAL_MARKETPLACE_DISCLOSURE_APPROVED=false
NOVASTORE_LEGAL_MARKETPLACE_DISCLOSURE_VERSION=
NOVASTORE_LEGAL_MARKETPLACE_DISCLOSURE_TEXT=
NOVASTORE_LEGAL_SELLER_AGREEMENT_APPROVED=false
NOVASTORE_LEGAL_SELLER_AGREEMENT_VERSION=
NOVASTORE_LEGAL_SELLER_AGREEMENT_TEXT=

# Payment reservation and bank transfer launch controls. Bank transfer remains
# disabled until a real account name and checksum-valid Turkish IBAN are supplied.
CARD_PAYMENT_RESERVATION_MINUTES=30
BANK_TRANSFER_RESERVATION_HOURS=24
NOVASTORE_BANK_TRANSFER_ENABLED=false
HAVALE_ACCOUNT_NAME=
HAVALE_IBAN=

# Customer return workflow. Admin write stays fail-closed unless explicitly enabled.
NOVASTORE_RETURN_WINDOW_DAYS=14
NOVASTORE_ADMIN_RETURN_WRITE_ENABLED=false

EMAIL_USER=
EMAIL_PASS=
MAIL_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push is a separate launch decision. Keep the worker disabled until its
# public key, private key, subject and delivery operations are authorized.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
WEB_PUSH_REQUEST_TIMEOUT_MS=10000
NOVASTORE_NOTIFICATION_WORKER_ENABLED=false
NOVASTORE_NOTIFICATION_WORKER_INTERVAL_MS=5000

AI_PROVIDER=mock
# AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini 429/RESOURCE_EXHAUSTED gibi kota veya gecici servis hatalarinda
# NovaBot'u ayakta tutmak icin sirali fallback provider listesi.
# Bos birakilirsa canli provider'lar son care olarak mock'a duser.
AI_PROVIDER_FALLBACK_ENABLED=true
AI_PROVIDER_FALLBACKS=mock
# AI_PROVIDER_FALLBACKS=openai,mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
