PORT=5000
NODE_ENV=development

# Local Postgres
DATABASE_URL=postgres://user:password@localhost:5432/novastore
# DB_SSL=false is accepted only for a non-production loopback database.
# Remote and production targets require certificate and hostname verification.
DB_SSL=false
# Optional PEM CA for a private database CA. Use literal \n between PEM lines.
DB_SSL_CA=

# Safe local/test backend mode for runtime QA.
# Use only a local disposable/dev database. Never point this mode at production.
# SKIP_SCHEMA_INIT=true starts the API without running create schema functions.
# NOVASTORE_ALLOW_SCHEMA_INIT=true allows schema preparation only when the DB host is local
# and the database name is not the default "postgres".
NOVASTORE_SAFE_LOCAL_BACKEND=true
SKIP_SCHEMA_INIT=true
# NOVASTORE_ALLOW_SCHEMA_INIT=false
# UI-only local development preview (explicit opt-in).
# This works only with NODE_ENV=development and must not be used for test, staging,
# UAT, or production. It replaces a configured Supabase target with the local sink
# 127.0.0.1:55432/novastore_preview, skips DB verification, and never initializes
# a schema. The UI can open, but DB-backed APIs will not work without a separately
# provisioned local preview DB.
# Do not combine this with NOVASTORE_ALLOW_REMOTE_DB=true.
# PayTR UAT and real staging require controlled remote/staging DB configuration.
# NOVASTORE_LOCAL_PREVIEW=true
# Example runtime QA command:
# npm run dev:safe
# Example local schema-prep command for a disposable DB only:
# DATABASE_URL=postgres://user:password@localhost:5432/novastore_test
# npm run dev:safe:schema

# Supabase on IPv4-only networks or Windows
# Direct hostlar (db.<project-ref>.supabase.co) bazi ortamlarda yalnizca IPv6 doner.
# Bu durumda Session Pooler kullan:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_USE_POOLER=true
# SUPABASE_REGION=eu-west-1
# SUPABASE_POOLER_MODE=session
# DB_USER=postgres.YOUR_PROJECT_REF
# DB_PORT=5432
# DB_SSL=true
# Alternatif olarak SUPABASE_POOLER_HOST=aws-0-eu-west-1.pooler.supabase.com verebilirsin.

JWT_SECRET=change_me
VERIFICATION_CODE_SECRET=replace_with_independent_32_byte_secret
# Optional independent HMAC key for public auth rate-limit buckets.
# If omitted, VERIFICATION_CODE_SECRET is used.
PUBLIC_AUTH_RATE_LIMIT_SECRET=
# Production requires a shared Render Key Value/Redis endpoint. The process
# fails closed when neither this value nor REDIS_URL is configured.
PUBLIC_AUTH_RATE_LIMIT_REDIS_URL=
PUBLIC_AUTH_RATE_LIMIT_PREFIX=novastore:public-auth:v1
PUBLIC_AUTH_RATE_LIMIT_STORE_TIMEOUT_MS=1500
CLIENT_ORIGIN=http://localhost:5000
APP_BASE_URL=http://localhost:5000
# Explicit origin allowlist used for security-sensitive links.
APP_BASE_URL_ALLOWED_ORIGINS=http://localhost:5000
# Production or custom domain example:
# CLIENT_ORIGIN=https://novastore.tr,https://www.novastore.tr
# APP_BASE_URL=https://novastore.tr
# MAIL_FROM=NovaStore Destek <destek@novastore.tr>
# Resend is used for password-reset and email-verification delivery.
# Production requires the explicit provider, API key, sender and verified-domain list.
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_VERIFIED_SENDER_DOMAINS=

# Netgsm OTP SMS uses the official XML POST endpoint. Credentials are sent in
# the XML request body; the adapter does not use an HTTP Authorization header.
# Leave SMS_PROVIDER unset until the production account, OTP package, sender title,
# IP policy and credentials have been approved. Never commit real values.
# The staging foundation rejects SMS_PROVIDER=netgsm and any NETGSM_* key,
# including blank placeholders; do not copy these entries into staging.
SMS_PROVIDER=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# Payment provider. Keep iyzico until PayTR staging is enabled.
PAYMENT_PROVIDER=iyzico

IYZICO_WEBHOOK_SECRET=
IYZICO_MOCK_MODE=true
# Local/test provider simulators only. Keep unset/false in staging and production.
# IYZICO_ALLOW_UNSIGNED_WEBHOOKS=false

# PayTR provider config placeholders only. Do not commit real secrets.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_BASE_URL=https://www.paytr.com
PAYTR_CALLBACK_URL=
PAYTR_SUCCESS_URL=
PAYTR_FAIL_URL=
PAYTR_TEST_MODE=true
PAYTR_DEBUG_ON=true

FREE_SHIPPING_THRESHOLD=1500
DEFAULT_SHIPPING_FEE=49.9
DEFAULT_SHIPMENT_PROVIDER=Yurtici Kargo

HAVALE_ACCOUNT_NAME=NovaStore Elektronik
HAVALE_IBAN=TR00 0000 0000 0000 0000 0000 00

EMAIL_USER=
EMAIL_PASS=
MAIL_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AI_PROVIDER=mock
# AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini 429/RESOURCE_EXHAUSTED gibi kota veya gecici servis hatalarinda
# NovaBot'u ayakta tutmak icin sirali fallback provider listesi.
# Bos birakilirsa canli provider'lar son care olarak mock'a duser.
AI_PROVIDER_FALLBACK_ENABLED=true
AI_PROVIDER_FALLBACKS=mock
# AI_PROVIDER_FALLBACKS=openai,mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
