)}<span>Karşılaştır (${comparedProducts.size})</span>`;});\r\n  }\r\n  function enhanceInteractions() {\r\n    document.querySelectorAll('.product-card').forEach(card=>{\r\n      if(card.querySelector('[data-action=\"compare-toggle\"]'))return;\r\n      const p=products.get(card.dataset.productId);if(!p)return;\r\n      card.insertAdjacentHTML('beforeend',`<button class=\"compare-button\" data-action=\"compare-toggle\" data-id=\"${esc(p.id)}\" aria-label=\"${esc(p.name)} karşılaştır\" aria-pressed=\"${comparedProducts.has(p.id)}\">${icon('refresh')}</button>`);\r\n      if(T.style==='grocery'&&p.variants.length===1&&p.stock>0)card.querySelector('.add-button')?.insertAdjacentHTML('beforebegin',`<div class=\"card-quantity\"><button data-action=\"card-quantity\" data-delta=\"-1\" aria-label=\"${esc(p.name)} satın alma adedini azalt\">${icon('minus')}</button><input type=\"number\" min=\"1\" max=\"${p.stock}\" step=\"1\" value=\"1\" aria-label=\"${esc(p.name)} satın alma adedi\"><button data-action=\"card-quantity\" data-delta=\"1\" aria-label=\"${esc(p.name)} satın alma adedini artır\">${icon('plus')}</button></div>`);\r\n    });\r\n    syncCompareButtons();\r\n    const slider=document.querySelector('.campaign-slider');\r\n    if(slider&&!slider.dataset.gestures){\r\n      slider.dataset.gestures='true';slider.setAttribute('aria-roledescription','kampanya slayt gösterisi');\r\n      let start=null;\r\n      slider.addEventListener('pointerdown',e=>{if(e.pointerType==='touch')start={x:e.clientX,y:e.clientY};});\r\n      slider.addEventListener('pointercancel',()=>start=null);\r\n      slider.addEventListener('pointerup',e=>{if(!start)return;const dx=e.clientX-start.x,dy=e.clientY-start.y;start=null;if(Math.abs(dx)>55&&Math.abs(dx)>Math.abs(dy)*1.5)slider.querySelector(`[data-slide-step=\"${dx<0?1:-1}\"]`)?.click();});\r\n      slider.style.touchAction='pan-y';\r\n      slider.addEventListener('keydown',e=>{if(e.target.closest('.slider-controls')&&['ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();slider.querySelector(`[data-slide-step=\"${e.key==='ArrowRight'?1:-1}\"]`)?.click();}});\r\n    }\r\n  }\r\n  function closeSearchSuggestions() {\r\n    const box=document.getElementById('search-suggestions');if(box)box.hidden=true;\r\n    document.getElementById('search-input')?.setAttribute('aria-expanded','false');\r\n  }\r\n  document.addEventListener('input',e=>{\r\n    if(e.target.id!=='search-input')return;\r\n    const input=e.target,q=input.value.toLocaleLowerCase('tr-TR').trim();\r\n    let box=document.getElementById('search-suggestions');\r\n    if(!box){input.closest('form').insertAdjacentHTML('beforeend','<div id=\"search-suggestions\" class=\"search-suggestions\" aria-label=\"Arama önerileri\"></div>');box=document.getElementById('search-suggestions');}\r\n    input.setAttribute('aria-controls','search-suggestions');\r\n    if(q.length<2){closeSearchSuggestions();return;}\r\n    const matches=T.products.filter(p=>`${p.name} ${p.category}`.toLocaleLowerCase('tr-TR').includes(q)).slice(0,5);\r\n    box.innerHTML=matches.map(p=>`<a href=\"${productURL(p.id)}\">${photo(p)}<span><strong>${esc(p.name)}</strong><small>${esc(p.category)} · ${money(p.price)}</small></span></a>`).join('')+`<a class=\"search-all\" href=\"${routeLink('catalog',{q:input.value.trim()})}\">${matches.length?'Tüm sonuçları gör':'Bu aramada ürün bulunamadı'} ${icon('arrow')}</a>`;\r\n    box.hidden=false;input.setAttribute('aria-expanded','true');\r\n  });\r\n  document.addEventListener('keydown',e=>{\r\n    if(e.key==='Escape')closeSearchSuggestions();\r\n    if(e.target.id==='search-input'&&e.key==='ArrowDown'){const a=document.querySelector('#search-suggestions:not([hidden]) a');if(a){e.preventDefault();a.focus();}}\r\n    else if(e.target.closest('#search-suggestions')&&['ArrowUp','ArrowDown'].includes(e.key)){e.preventDefault();const links=[...document.querySelectorAll('#search-suggestions a')],i=links.indexOf(e.target);if(e.key==='ArrowUp'&&i===0)document.getElementById('search-input').focus();else links[(i+(e.key==='ArrowDown'?1:-1)+links.length)%links.length]?.focus();}\r\n  });\r\n  document.addEventListener('focusin',e=>{if(!e.target.closest('#search-form'))closeSearchSuggestions();});\r\n  document.addEventListener('click',e=>{\r\n    if(!e.target.closest('#search-form')||e.target.closest('#search-suggestions a'))closeSearchSuggestions();\r\n    const cartLink=e.target.closest('.header-actions a[href=\"#/cart\"]');\r\n    if(cartLink&&!e.ctrlKey&&!e.metaKey&&!e.shiftKey&&!e.altKey){e.preventDefault();e.stopImmediatePropagation();openCartDrawer();}\r\n    const buy=e.target.closest('.product-card [data-action=\"quick-add\"]');\r\n    const quantity=buy?.closest('.product-card').querySelector('.card-quantity input');\r\n    if(quantity&&!buy.disabled){e.preventDefault();e.stopImmediatePropagation();const p=products.get(buy.dataset.id),qty=Number(quantity.value);if(!p||!Number.isSafeInteger(qty)||qty<1||qty>p.stock-productInCart(p.id)){toast('Seçtiğin adet kalan demo stoğunu aşıyor.');return;}for(let i=0;i<qty;i++)addToCart(p.id,p.variants[0]);}\r\n  },true);\r\n  document.addEventListener('submit',e=>{\r\n    if(e.target.id==='search-form')closeSearchSuggestions();\r\n    const form=e.target.closest('.quick-shop-form');if(!form)return;\r\n    e.preventDefault();const p=products.get(form.dataset.id),data=new FormData(form),qty=Number(data.get('quantity')),variant=data.get('variant');\r\n    const status=form.querySelector('.quick-shop-status');\r\n    if(!p||!p.variants.includes(variant)||!Number.isSafeInteger(qty)||qty<1||qty>p.stock-productInCart(p.id)){status.textContent='Adedi ve kalan stoğu kontrol et.';return;}\r\n    for(let i=0;i<qty;i++)addToCart(p.id,variant);\r\n    status.textContent=`${qty} adet sepete eklendi.`;\r\n    const remaining=p.stock-productInCart(p.id);form.querySelector('[name=\"quantity\"]').max=String(Math.max(1,remaining));form.querySelector('button').disabled=!remaining;\r\n    if(!form.querySelector('[data-action=\"cart-preview\"]'))form.insertAdjacentHTML('beforeend','<button type=\"button\" class=\"button secondary\" data-action=\"cart-preview\">Sepetime bak</button>');\r\n  });\r\n  document.addEventListener('click',e=>{\r\n    const b=e.target.closest('[data-action]');if(!b||b.disabled)return;\r\n    const action=b.dataset.action,id=b.dataset.id;\r\n    if(action==='card-quantity'){const input=b.closest('.card-quantity').querySelector('input'),delta=Number(b.dataset.delta);input.value=String(Math.max(1,Math.min(Number(input.max),Number(input.value)+delta)));}\r\n    if(action==='cart-preview')openCartDrawer();\r\n    if(action==='drawer-quantity'||action==='drawer-remove'){\r\n      const index=Number(b.dataset.line),l=state.cart[index];if(!l)return;\r\n      if(action==='drawer-remove'){state.cart.splice(index,1);if(!state.cart.length)state.coupon='';}\r\n      else {const delta=Number(b.dataset.delta),p=products.get(l.productId);if(![-1,1].includes(delta)||l.qty+delta<1||delta>0&&productInCart(p.id)>=p.stock)return;l.qty+=delta;}\r\n      save();updateBadges();if(['cart','checkout'].includes(currentRoute().name))renderKeepingPosition();openCartDrawer(true);\r\n    }\r\n    if(action==='compare-toggle'){\r\n      if(comparedProducts.has(id))comparedProducts.delete(id);else {if(comparedProducts.size===4){toast('Aynı anda en fazla dört ürün karşılaştırabilirsin.');return;}if(products.has(id))comparedProducts.add(id);}\r\n      syncCompareButtons();\r\n      // The tray itself is the persistent visible selection feedback; a toast\r\n      // in the same mobile area used to cover the action immediately after tap.\r\n      if(!comparedProducts.size)toast('Karşılaştırma seçimi temizlendi.');\r\n    }\r\n    if(action==='compare-open')openComparison();\r\n    if(action==='compare-remove'){comparedProducts.delete(id);syncCompareButtons();openComparison();}\r\n    if(action==='reset-confirm'){comparedProducts.clear();syncCompareButtons();}\r\n  });\r\n\r\n  // NovaBot's shared visual surface. Only an explicitly supplied host can answer as AI.\r\n  // The installer replaces this marker with the original local NovaBot avatar data URI.\r\n  const novaBotAvatar = '__NS_ASSET_c3f3d7d64ae488e7821128c3__';\r\n  function initializeNovaBot() {\r\n    if (document.getElementById('nova-assistant-launcher')) return;\r\n    const shell = document.createElement('div');\r\n    shell.className = 'nova-assistant';\r\n    shell.innerHTML = `<button id=\"nova-assistant-launcher\" type=\"button\" aria-label=\"NovaBot alışveriş asistanını aç\" aria-controls=\"nova-assistant-dialog\" aria-haspopup=\"dialog\" aria-expanded=\"false\"><img src=\"${novaBotAvatar}\" alt=\"NovaBot\" width=\"52\" height=\"52\"></button><dialog id=\"nova-assistant-dialog\" aria-labelledby=\"nova-assistant-title\"><header class=\"nova-assistant-head\"><img src=\"${novaBotAvatar}\" alt=\"\" width=\"42\" height=\"42\"><div><h2 id=\"nova-assistant-title\">NovaBot</h2><p>Nova Store alışveriş asistanı</p></div><button type=\"button\" data-nova-close aria-label=\"NovaBot penceresini kapat\">${icon('close')}</button></header><p class=\"nova-assistant-status\" role=\"status\"></p><div class=\"nova-assistant-thread\" role=\"log\" aria-label=\"NovaBot konuşması\" aria-live=\"polite\" aria-relevant=\"additions text\"></div><div class=\"nova-assistant-shortcuts\"><button type=\"button\" data-nova-guide=\"products\">Ürün bul</button><a href=\"#/cart\">Sepetim</a><a href=\"#/help\">Yardım</a><a href=\"#/support\">Destek mesajları</a></div><form class=\"nova-assistant-composer\"><label class=\"sr-only\" for=\"nova-assistant-message\">NovaBot’a mesaj yaz</label><input id=\"nova-assistant-message\" name=\"message\" maxlength=\"1000\" autocomplete=\"off\" placeholder=\"Ürün veya kategori ara…\"><button type=\"submit\" aria-label=\"NovaBot mesajını gönder\">${icon('arrow')}</button></form><footer>Şifre, kart veya kimlik bilgisi paylaşma.</footer></dialog>`;\r\n    document.body.append(shell);\r\n    const launcher = shell.querySelector('#nova-assistant-launcher');\r\n    const panel = shell.querySelector('dialog');\r\n    const thread = shell.querySelector('.nova-assistant-thread');\r\n    const status = shell.querySelector('.nova-assistant-status');\r\n    const composer = shell.querySelector('form');\r\n    const input = shell.querySelector('input');\r\n    const send = composer.querySelector('button');\r\n    let messages = [], request = null, capabilityRequest = null, timer = null, generation = 0;\r\n    let activeHost = null, activePort = null, capability = null, capabilityKnown = false, unsubscribeHost = null, ownerKey = '';\r\n    const hostNow = () => window.NovaStoreCommerceHost || null;\r\n    const hostSnapshot = () => typeof activeHost?.snapshot === 'function' ? activeHost.snapshot() : null;\r\n    const hostReady = () => activeHost && typeof activePort?.chat === 'function' && (!hostSnapshot() || hostSnapshot().phase === 'ready');\r\n    const identityKey = snapshot => snapshot ? JSON.stringify([snapshot.phase,snapshot.session?.status,snapshot.session?.id,snapshot.session?.user?.id]) : '';\r\n    const stopRequest = () => { generation++; request?.abort(); capabilityRequest?.abort(); request = null; capabilityRequest = null; clearTimeout(timer); send.disabled = false; panel.removeAttribute('aria-busy'); };\r\n    // Resolve cancellation even when a supplied port ignores AbortSignal.\r\n    const guardedRequest = (operation, signal) => new Promise((resolve,reject) => {\r\n      const abort=()=>reject(new DOMException('Request cancelled','AbortError'));\r\n      if(signal.aborted){abort();return;}\r\n      signal.addEventListener('abort',abort,{once:true});\r\n      Promise.resolve().then(operation).then(resolve,reject).finally(()=>signal.removeEventListener('abort',abort));\r\n    });\r\n    const writeMessage = (role, text, links = [], suggestions = []) => {\r\n      const entry = document.createElement('article');\r\n      entry.className = `nova-assistant-message is-${role}`;\r\n      const label = document.createElement('strong'); label.textContent = role === 'user' ? 'Sen' : 'NovaBot';\r\n      const paragraph = document.createElement('p'); paragraph.textContent = String(text).slice(0,6000);\r\n      entry.append(label, paragraph);\r\n      if (links.length) {\r\n        const list = document.createElement('div'); list.className = 'nova-assistant-products';\r\n        links.slice(0,3).forEach(p => {\r\n          const link = document.createElement('a'); link.href = productURL(p.id);\r\n          const title = document.createElement('strong'); title.textContent = p.name;\r\n          const detail = document.createElement('span'); detail.textContent = `${money(p.price)} · ${p.stock > 0 ? 'Ürünü gör' : 'Stokta yok'}`;\r\n          link.append(title,detail);list.append(link);\r\n        });\r\n        entry.append(list);\r\n      }\r\n      suggestions.filter(x => typeof x === 'string' && x.trim()).slice(0,3).forEach(suggestion => {\r\n        const button=document.createElement('button'); button.type='button';button.className='nova-assistant-suggestion';button.textContent=suggestion.slice(0,100);\r\n        button.addEventListener('click',()=>submitMessage(suggestion.slice(0,1000)));entry.append(button);\r\n      });\r\n      thread.append(entry); messages.push({role, message:paragraph.textContent});\r\n      if(messages.length > 30) { messages.shift(); thread.firstElementChild?.remove(); }\r\n      thread.scrollTop = thread.scrollHeight;\r\n    };\r\n    const renderStatus = () => {\r\n      if (!activeHost) status.textContent = 'Demo rehberi · Yapay zekâ servisi bağlı değil.';\r\n      else if (!hostReady()) status.textContent = 'NovaBot servisi bu mağazada henüz kullanılamıyor.';\r\n      else if (!capabilityKnown) status.textContent = 'NovaBot bağlantısı kontrol ediliyor…';\r\n      else if (!capability) status.textContent = 'NovaBot bağlantısı doğrulanamadı. Daha sonra yeniden dene.';\r\n      else status.textContent = capability.provider?.ready === true ? 'Mağazanın NovaBot servisine bağlı.' : 'Mağazanın temel yardım servisine bağlı.';\r\n      input.disabled = Boolean(activeHost && (!hostReady() || !capabilityKnown || !capability));\r\n      send.disabled = input.disabled || Boolean(request);\r\n      input.placeholder = activeHost ? 'Ürün veya destek hakkında sor…' : 'Demo ürünlerinde ara…';\r\n    };\r\n    const refreshPort = () => {\r\n      stopRequest();unsubscribeHost?.();unsubscribeHost=null;activeHost=hostNow(); activePort=activeHost?.assistant || null; capability=null;capabilityKnown=false;\r\n      ownerKey=identityKey(hostSnapshot());\r\n      if(typeof activeHost?.subscribe==='function')unsubscribeHost=activeHost.subscribe(snapshot=>{\r\n        const key=identityKey(snapshot);if(key!==ownerKey)refreshPort();\r\n      });\r\n      messages=[];thread.replaceChildren();renderStatus();\r\n      writeMessage('assistant', activeHost ? 'Merhaba. Ürünler ve mağaza desteği hakkında yardımcı olabilirim. İşlemler mağazanın izinleriyle sınırlıdır.' : 'Merhaba, ben NovaBot. Bu önizlemede yerel demo rehberi olarak çalışıyorum. Bir ürün veya kategori yazabilir, sepetine ve yardım sayfasına geçebilirsin.');\r\n      if (!hostReady()) return;\r\n      if (typeof activePort.getCapability !== 'function') { capabilityKnown=true;renderStatus();return; }\r\n      const controller=new AbortController();capabilityRequest=controller;const epoch=generation;\r\n      const timeout=setTimeout(()=>controller.abort(),15000);\r\n      guardedRequest(()=>activePort.getCapability({signal:controller.signal}),controller.signal).then(value=>{\r\n        if(epoch !== generation || controller.signal.aborted)return;\r\n        capability=value && typeof value === 'object' && value.available !== false ? value : null;\r\n      }).catch(()=>{ if(epoch===generation)capability=null; }).finally(()=>{\r\n        clearTimeout(timeout);if(epoch!==generation)return;capabilityRequest=null;capabilityKnown=true;renderStatus();\r\n      });\r\n    };\r\n    const guideReply = raw => {\r\n      const q=raw.toLocaleLowerCase('tr-TR').trim();\r\n      if(/sepet/.test(q)) return writeMessage('assistant',`Demo sepetinde ${cartCount()} ürün var. Sepetim bağlantısından ürünleri ve miktarları kontrol edebilirsin. Bu önizlemede gerçek sipariş oluşturulmaz.`);\r\n      if(/sipariş|kargo|ödeme|iade|yardım|destek/.test(q)) return writeMessage('assistant','Bu koleksiyondaki ödeme ve siparişler örnektir. Gerçek teslimat veya destek talebi oluşturulmaz. Demo akışları için Yardım sayfasını, kayıtlarını görmek için Hesabım bölümünü kullanabilirsin.');\r\n      const words=q.split(/\\s+/).filter(w=>w.length>1);\r\n      const found=T.products.filter(p=>words.some(w=>`${p.name} ${p.category}`.toLocaleLowerCase('tr-TR').includes(w))).slice(0,3);\r\n      writeMessage('assistant',found.length?'Demo kataloğunda bu seçimleri buldum. Ayrıntıları görmek için ürüne dokunabilirsin.':'Bu kelimelerle eşleşen demo ürünü bulamadım. Ürün adı veya kategorisini yazarak tekrar deneyebilirsin.',found);\r\n    };\r\n    const submitMessage = async raw => {\r\n      const text=String(raw||'').trim().slice(0,1000);if(!text||request)return;\r\n      if(hostNow()!==activeHost || (hostNow()?.assistant||null)!==activePort || identityKey(hostSnapshot())!==ownerKey)refreshPort();\r\n      if(activeHost && (!hostReady() || !capabilityKnown || !capability)) {renderStatus();return;}\r\n      const history=messages.slice(-16);writeMessage('user',text);input.value='';\r\n      if(!activeHost){guideReply(text);return;}\r\n      const controller=new AbortController();request=controller;const epoch=generation;\r\n      send.disabled=true;panel.setAttribute('aria-busy','true');status.textContent='NovaBot yanıtı hazırlanıyor…';\r\n      timer=setTimeout(()=>controller.abort(),20000);\r\n      try {\r\n        const response=await guardedRequest(()=>activePort.chat({message:text,history},{signal:controller.signal}),controller.signal);\r\n        if(epoch!==generation||controller.signal.aborted)return;\r\n        if(typeof response?.reply!=='string'||!response.reply.trim())throw new Error('Empty assistant response');\r\n        // Product references must belong to this storefront; responses cannot inject markup or destinations.\r\n        const refs=Array.isArray(response.products)?response.products.map(p=>products.get(String(p?.id??p))).filter(Boolean):[];\r\n        writeMessage('assistant',response.reply,refs,Array.isArray(response.suggestions)?response.suggestions:[]);\r\n        if(response.requiresConfirmation)writeMessage('assistant','Bu işlem NovaBot üzerinden otomatik uygulanmadı. Ürün veya hesap sayfasından işlemi inceleyip kendin tamamlayabilirsin.');\r\n      } catch(error) {\r\n        if(epoch===generation)writeMessage('assistant',controller.signal.aborted?'Yanıt zamanında alınamadı. Daha sonra yeniden deneyebilirsin.':'NovaBot servisine şu anda ulaşılamıyor. İşlem yapılmadı; daha sonra yeniden deneyebilirsin.');\r\n      } finally {\r\n        if(epoch===generation){clearTimeout(timer);request=null;panel.removeAttribute('aria-busy');renderStatus();}\r\n      }\r\n    };\r\n    const close=()=>{stopRequest();panel.close();launcher.setAttribute('aria-expanded','false');renderStatus();launcher.focus({preventScroll:true});};\r\n    launcher.addEventListener('click',()=>{\r\n      if(hostNow()!==activeHost||(hostNow()?.assistant||null)!==activePort || identityKey(hostSnapshot())!==ownerKey || (activeHost&&!capability))refreshPort();\r\n      panel.showModal();launcher.setAttribute('aria-expanded','true');\r\n      const target=matchMedia('(pointer:fine)').matches&&!input.disabled?input:panel.querySelector('[data-nova-close]');\r\n      target.focus({preventScroll:true});\r\n    });\r\n    shell.querySelector('[data-nova-close]').addEventListener('click',close);\r\n    panel.addEventListener('cancel',event=>{event.preventDefault();close();});\r\n    panel.addEventListener('click',event=>{\r\n      if(event.target===panel){const r=panel.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)close();}\r\n      if(event.target.closest('a'))close();\r\n    });\r\n    shell.querySelector('[data-nova-guide]').addEventListener('click',()=>{\r\n      if(!activeHost)writeMessage('assistant',`Bu demoda ${T.cats.join(', ')} kategorileri var. Bir ürün veya kategori adı yazabilirsin.`);\r\n      input.focus({preventScroll:true});\r\n    });\r\n    composer.addEventListener('submit',event=>{event.preventDefault();submitMessage(input.value);});\r\n    window.addEventListener('hashchange',()=>{if(panel.open)close();});\r\n    window.NovaStoreThemeAssistant=Object.freeze({version:'1.0.0',refreshPort,close});\r\n    refreshPort();\r\n  }\r\n\r\n  // Hosted mode consumes one already-authorized owner. No endpoint or token is inferred here.\r\n  let renderedHostSnapshot = initialHostSnapshot;\r\n  function syncHostSnapshot(snapshot) {\r\n    const previous=renderedHostSnapshot;renderedHostSnapshot=snapshot;\r\n    T.products=[...snapshot.products];T.cats=[...new Set(snapshot.categories.map(c=>c.name))];\r\n    products.clear();for(const p of T.products)products.set(p.id,p);\r\n    state={cart:snapshot.cart.map(l=>({...l})),favorites:[...snapshot.favorites],coupon:'',session:snapshot.session.status==='authenticated',orders:[]};\r\n    if(document.getElementById('main-content')&&previous&&(previous.products!==snapshot.products||previous.cart!==snapshot.cart||previous.favorites!==snapshot.favorites||previous.session!==snapshot.session))renderKeepingPosition();\r\n    updateHostAvailability();\r\n    if(snapshot.error&&document.getElementById('toast'))toast(snapshot.error.message||'Mağaza işlemi tamamlanamadı.');\r\n  }\r\n  async function runHost(action,element) {\r\n    if(!hostBridge)return;\r\n    if(element)element.disabled=true;\r\n    try {return await action();}catch(error){toast(error?.message||'Mağaza işlemi tamamlanamadı.');return false;}\r\n    finally {if(element?.isConnected)element.disabled=false;updateHostAvailability();}\r\n  }\r\n  function updateHostAvailability() {\r\n    if(!hostBridge)return;\r\n    const snapshot=hostBridge.snapshot();\r\n    const blocked=Boolean(snapshot.pending||snapshot.phase!=='ready'||snapshot.readOnlyPreview||snapshot.session.status==='unverified'||snapshot.cartSync==='pending');\r\n    document.querySelectorAll('[data-action=\"quick-add\"],[data-action=\"favorite\"],[data-action=\"quantity\"],[data-action=\"remove-item\"],[data-action=\"host-checkout\"],#product-form button[type=\"submit\"]').forEach(button=>{\r\n      const action=button.dataset.action,product=products.get(button.dataset.id||currentRoute().id);\r\n      let unavailable=false;\r\n      if(action==='quick-add'||button.form?.id==='product-form'){\r\n        const remaining=product?product.stock-(snapshot.cart.find(line=>line.productId===product.id)?.qty||0):0;\r\n        unavailable=!product||remaining<=0||Boolean(product.purchaseRequiresHostSelection&&!product.canOpenProduct);\r\n      } else if(action==='quantity'){\r\n        const line=snapshot.cart[Number(button.dataset.line)],p=line&&products.get(line.productId),delta=Number(button.dataset.delta);\r\n        unavailable=!p||line.qty+delta<1||line.qty+delta>p.stock||p.purchaseRequiresHostSelection;\r\n      } else if(action==='host-checkout')unavailable=!snapshot.cart.length;\r\n      button.disabled=blocked||unavailable;\r\n    });\r\n  }\r\n  function hostedCustomerPage(route) {if(T.style==='classic'&&route==='account')return classicAccount();return legacyClassicHostedCustomerPage(route);}\r\n  function legacyClassicHostedCustomerPage(route) {\r\n    const customer=hostBridge.snapshot().session;\r\n    return `<div class=\"container page\">${breadcrumbs('Hesabım')}<h1 class=\"page-title\">${route==='orders'?'Siparişlerim':'Hesabım'}</h1><section class=\"profile-card\"><h2>${customer.status==='authenticated'?`Merhaba${customer.user?.fullName?', '+esc(customer.user.fullName):''}`:'Mağaza hesabın'}</h2><p>Hesap, adres ve sipariş işlemleri mağazanın güvenli hesap alanında yönetilir.</p><button class=\"button\" data-action=\"host-account\">${customer.status==='authenticated'?'Hesabıma git':'Giriş yap'}</button></section></div>`;\r\n  }\r\n  function hostedCart() {\r\n    const subtotal=state.cart.reduce((n,l)=>n+products.get(l.productId).price*l.qty,0);\r\n    const lines=state.cart.map((l,i)=>{const p=products.get(l.productId);return `<article class=\"cart-item\"><a href=\"${productURL(p.id)}\">${photo(p)}</a><div><h2><a href=\"${productURL(p.id)}\">${esc(p.name)}</a></h2><p>${money(p.price)}</p><div class=\"qty-control\"><button data-action=\"quantity\" data-line=\"${i}\" data-delta=\"-1\" aria-label=\"${esc(p.name)} adedini azalt\" ${l.qty<=1?'disabled':''}>${icon('minus')}</button><span>${l.qty}</span><button data-action=\"quantity\" data-line=\"${i}\" data-delta=\"1\" aria-label=\"${esc(p.name)} adedini artır\" ${l.qty>=p.stock?'disabled':''}>${icon('plus')}</button></div></div><strong>${money(p.price*l.qty)}</strong><button data-action=\"remove-item\" data-line=\"${i}\" aria-label=\"${esc(p.name)} sepetten çıkar\">${icon('trash')}</button></article>`;}).join('');\r\n    return `<div class=\"container page\">${breadcrumbs('Sepetim')}<h1 class=\"page-title\">Sepetim</h1>${state.cart.length?`<div class=\"cart-layout\"><section>${lines}</section><aside class=\"summary-card\"><h2>Sipariş özeti</h2><p>Ürün tutarı <strong>${money(subtotal)}</strong></p><p>Kargo, kuponlar ve son tutar ödeme adımında mağaza tarafından doğrulanır.</p><button data-action=\"host-checkout\" class=\"button full\">Ödemeye geç</button><p class=\"muted\">Bu ekranda ödeme bilgisi alınmaz.</p></aside></div>`:empty('Sepetin henüz boş.','Beğendiğin ürünleri koleksiyondan seçebilirsin.','Alışverişe başla','#/catalog','bag')}</div>`;\r\n  }\r\n  function hostedDetail(id) {if(T.style==='classic')return classicDetail(id);return legacyClassicHostedDetail(id);}\r\n  function legacyClassicHostedDetail(id) {\r\n    const p=products.get(id);if(!p)return notFound();\r\n    return `<div class=\"container page\">${breadcrumbs(p.name)}<div class=\"detail-layout\"><section aria-label=\"Ürün görseli\"><div class=\"detail-image\">${photo(p)}<button class=\"favorite-button\" data-action=\"favorite\" data-id=\"${esc(p.id)}\" aria-label=\"${esc(p.name)} favori seçimini değiştir\" aria-pressed=\"${state.favorites.includes(p.id)}\">${icon('heart')}</button></div></section><section class=\"detail-info\"><a class=\"eyebrow\" href=\"${routeLink('catalog',{category:p.category})}\">${esc(p.category)}</a><h1>${esc(p.name)}</h1>${priceMarkup(p)}<p>${esc(p.description)}</p>${p.reviews?`<p>${p.rating.toFixed(1)} / 5 · ${p.reviews} değerlendirme</p>`:''}<p>${p.stock>0?`${p.stock} adet stokta`:'Stokta yok'}</p><form id=\"product-form\"><label class=\"field\">Adet<input name=\"quantity\" type=\"number\" min=\"1\" max=\"${Math.max(1,p.stock)}\" step=\"1\" value=\"1\" required></label><button type=\"submit\" data-host-mutation class=\"button full\" ${p.stock<=0||p.purchaseRequiresHostSelection&&!p.canOpenProduct?'disabled':''}>${p.purchaseRequiresHostSelection?'Seçenekleri mağazada seç':'Sepete ekle'}</button></form>${p.features?.length?`<ul>${p.features.map(f=>`<li>${esc(f)}</li>`).join('')}</ul>`:''}<p class=\"muted\">Son fiyat, stok ve teslimat koşulları ödeme adımında doğrulanır.</p></section></div></div>`;\r\n  }\r\n  function hostedFavorites(){const list=T.products.filter(p=>state.favorites.includes(p.id));return `<div class=\"container page\">${breadcrumbs('Favorilerim')}<h1 class=\"page-title\">Favorilerim</h1>${list.length?productGrid(list):empty('Henüz favorin yok.','Beğendiğin ürünleri kalp simgesiyle kaydedebilirsin.','Ürünleri keşfet','#/catalog','heart')}</div>`;}\r\n  function hostedServices(){return `<nav class=\"service-strip\" aria-label=\"Mağaza hizmetleri\"><a href=\"#/account\">${icon('user')}Hesabım</a><a href=\"#/cart\">${icon('bag')}Sepetim</a><a href=\"#/help\">${icon('info')}Yardım ve destek</a></nav>`;}\r\n  function hostedHelp(){return `<div class=\"container page\">${breadcrumbs('Yardım')}<h1 class=\"page-title\">Yardım ve destek</h1><section class=\"profile-card\"><h2>Alışverişinde yanındayız.</h2><p>Ürünleri arayabilir, karşılaştırabilir ve sepetinde düzenleyebilirsin. Sipariş, adres, teslimat ve iade işlemleri mağazanın güvenli hesap alanında yönetilir.</p><button class=\"button\" data-action=\"host-account\">Mağaza hesabını aç</button><p>NovaBot'u sağ alttaki simgesinden açabilirsin. Bağlantı durumunu asistanın içinde görebilirsin.</p></section></div>`;}\r\n  function hostedFooter(){return `<footer class=\"site-footer footer-${T.style}\"><div class=\"container\"><div class=\"footer-top\"><div class=\"footer-brand\"><a class=\"brand\" href=\"#/home\">Nova Store</a><p>${esc(T.tag)}</p></div><nav class=\"footer-links\" aria-label=\"Mağaza\"><a href=\"#/catalog\">Ürünler</a><a href=\"#/favorites\">Favorilerim</a><a href=\"#/account\">Hesabım</a><a href=\"#/help\">Yardım</a></nav></div><div class=\"footer-bottom\"><span>Nova Store</span><a href=\"#/orders\">Siparişlerim</a></div></div></footer>`;}\r\n  function decorateHostedPage() {\r\n    if(!hostBridge)return;\r\n    document.body.dataset.commerce='host';\r\n    const ribbon=document.querySelector('.demo-ribbon');if(ribbon)ribbon.textContent='Nova Store · Mağaza';\r\n    document.querySelectorAll('[data-action=\"coupon-info\"],.demo-payment-notice,.demo-note').forEach(el=>el.hidden=true);\r\n    const subtitle=document.querySelector('.catalog-layout')?.previousElementSibling;\r\n    if(subtitle?.classList.contains('page-subtitle'))subtitle.textContent=`Mağazada ${T.products.length} ürün.`;\r\n    document.querySelectorAll('.product-card').forEach(card=>{\r\n      const p=products.get(card.dataset.productId),buy=card.querySelector('.add-button');if(!p||!buy)return;\r\n      buy.dataset.hostMutation='true';\r\n      if(p.purchaseRequiresHostSelection){buy.setAttribute('aria-label',`${p.name}: seçenekleri mağazada seç`);buy.innerHTML=`${icon('arrow')}<span>Seçenekleri seç</span>`;buy.disabled=!p.canOpenProduct;}\r\n    });\r\n    updateHostAvailability();\r\n  }\r\n  function bindHostedActions() {\r\n    if(!hostBridge)return;\r\n    // Registered before demo listeners. None of the demo mutations can run in hosted mode.\r\n    document.addEventListener('click',e=>{\r\n      const link=e.target.closest('a[href]'),b=e.target.closest('[data-action]');\r\n      if(link&&/^#\\/(checkout|success)(?:[/?]|$)/.test(link.getAttribute('href'))){e.preventDefault();e.stopImmediatePropagation();runHost(()=>hostBridge.openCheckout());return;}\r\n      if(link?.matches('.header-actions a[href=\"#/cart\"]')){e.preventDefault();e.stopImmediatePropagation();navigate('cart');return;}\r\n      if(!b||b.disabled)return;\r\n      const a=b.dataset.action,id=b.dataset.id,p=products.get(id),handled=['favorite','quick-add','quantity','drawer-quantity','remove-item','drawer-remove','remove-coupon','coupon-info','session','reset-dialog','reset-confirm','host-account','host-checkout','cart-preview','quick-view','delivery-info','privacy-info'];\r\n      if(!handled.includes(a))return;e.preventDefault();e.stopImmediatePropagation();\r\n      if(a==='favorite'){runHost(()=>hostBridge.setFavorite(id,!state.favorites.includes(id)),b);return;}\r\n      if(a==='quick-add'){\r\n        if(!p)return;\r\n        if(p.purchaseRequiresHostSelection){runHost(()=>hostBridge.openProduct(id),b);return;}\r\n        const raw=b.closest('.product-card')?.querySelector('.card-quantity input')?.value;\r\n        runHost(async()=>{await hostBridge.addToCart(id,'Standart',raw?Number(raw):1);confirmCartAddition(p);},b);return;\r\n      }\r\n      if(a==='quick-view'){navigate(productURL(id));return;}\r\n      if(['quantity','drawer-quantity','remove-item','drawer-remove'].includes(a)){\r\n        const line=state.cart[Number(b.dataset.line)];if(!line)return;\r\n        const qty=['remove-item','drawer-remove'].includes(a)?0:line.qty+Number(b.dataset.delta);\r\n        runHost(()=>hostBridge.setQuantity(line.productId,qty),b);return;\r\n      }\r\n      if(a==='cart-preview'){navigate('cart');return;}\r\n      if(a==='host-checkout'){runHost(()=>hostBridge.openCheckout(),b);return;}\r\n      if(a==='host-account'||a==='session'){runHost(()=>hostBridge.openAccount(),b);return;}\r\n      if(a==='delivery-info'||a==='privacy-info'){showDialog('Mağaza bilgileri','<p>Teslimat, iade ve hesap bilgilerini mağazanın hesap ve ödeme alanında inceleyebilirsin.</p>');return;}\r\n      toast('Bu işlem mağazanın hesap veya ödeme alanında yönetilir.');\r\n    },true);\r\n    document.addEventListener('submit',e=>{\r\n      const form=e.target;\r\n      if(['search-form','filter-form'].includes(form.id))return;\r\n      if(form.classList.contains('nova-bot-form'))return;\r\n      if(!['product-form','coupon-form','checkout-form'].includes(form.id)&&!form.classList.contains('quick-shop-form'))return;\r\n      e.preventDefault();e.stopImmediatePropagation();\r\n      if(form.id==='product-form'){\r\n        const id=currentRoute().id,p=products.get(id);if(!p)return;\r\n        if(p.purchaseRequiresHostSelection){runHost(()=>hostBridge.openProduct(id));return;}\r\n        const count=Number(new FormData(form).get('quantity')||1);\r\n        runHost(async()=>{await hostBridge.addToCart(id,'Standart',count);confirmCartAddition(p);},form.querySelector('button[type=submit]'));return;\r\n      }\r\n      if(form.id==='checkout-form'){runHost(()=>hostBridge.openCheckout());return;}\r\n      toast('Kuponlar ve son fiyat mağazanın ödeme alanında doğrulanır.');\r\n    },true);\r\n    window.addEventListener('pagehide',()=>hostBridge.dispose(),{once:true});\r\n  }\r\n\r\n  // Nova Classic presentation. The shared controller owns every commerce action.\r\n  function classicProducts() { return Array.isArray(T.products) ? T.products.filter(Boolean) : []; }\r\n  function classicCategories() { return Array.isArray(T.cats) ? T.cats.filter(c => typeof c === 'string' && c.trim()) : []; }\r\n  function classicCategoryIcon(category) {\r\n    return icon(({Mobilya:'home',Mutfak:'box',Aksesuar:'spark',Moda:'shirt',Saatler:'clock',Aydınlatma:'lamp',Oyuncak:'gift','El Yapımı':'leaf',Minimal:'grid',Elektronik:'headphones',Bahçe:'leaf'})[category] || 'grid');\r\n  }\r\n  function classicImage(source, alt, extra='') {\r\n    return source ? `<img src=\"${esc(source)}\" alt=\"${esc(alt)}\" decoding=\"async\" ${extra}>` : '';\r\n  }\r\n  function classicCartSubtotal() {\r\n    const catalog=classicProducts();\r\n    return (state.cart || []).reduce((total,line) => {\r\n      const p=catalog.find(product => product.id===line.productId);\r\n      return total+(p ? p.price*line.qty : 0);\r\n    },0);\r\n  }\r\n  function classicHeader() {\r\n    const categories=classicCategories();\r\n    const search=`<form id=\"search-form\" class=\"search-form classic-search\" role=\"search\"><label class=\"sr-only\" for=\"search-input\">Ürün veya kategori ara</label><input id=\"search-input\" name=\"q\" type=\"search\" placeholder=\"Ürün ara\" maxlength=\"100\" autocomplete=\"off\"><label class=\"sr-only\" for=\"classic-search-category\">Aranacak kategori</label><select id=\"classic-search-category\" name=\"category\" aria-label=\"Aranacak kategori\"><option value=\"\">Tüm kategoriler</option>${categories.map(c=>`<option value=\"${esc(c)}\">${esc(c)}</option>`).join('')}</select><button type=\"submit\" aria-label=\"Ara\">${icon('search')}</button></form>`;\r\n    const actions=`<nav class=\"header-actions classic-header-actions\" aria-label=\"Hesap ve alışveriş\"><a class=\"classic-account-link\" href=\"#/account\">${icon('user')}<span>${state.session?'Hesabım':'Giriş / Kayıt'}</span></a><a class=\"header-action classic-header-icon\" href=\"#/favorites\" aria-label=\"Favorilerim\">${icon('heart')}<span class=\"count\" data-badge=\"favorite\" hidden>0</span></a><button class=\"header-action classic-header-icon\" data-action=\"classic-compare-open\" aria-label=\"Ürünleri karşılaştır\">${icon('refresh')}<span class=\"count\" data-classic-compare-count hidden>0</span></button><a class=\"header-action classic-header-cart\" href=\"#/cart\" aria-label=\"Sepetim\"><span class=\"classic-bag-icon\">${icon('bag')}<span class=\"count\" data-badge=\"cart\" hidden>0</span></span><strong data-classic-cart-subtotal>${money(classicCartSubtotal())}</strong></a></nav>`;\r\n    const navLinks=[['home','Ana sayfa'],['catalog','Mağaza'],['journal','İlham'],['about','Hakkımızda'],['contact','İletişim']];\r\n    return `<a href=\"#main-content\" class=\"skip-link\">İçeriğe atla</a><button hidden class=\"compare-tray classic-floating-compare\" data-action=\"compare-open\">Karşılaştır</button><header class=\"site-header header-classic classic-header\"><div class=\"classic-topbar\"><div class=\"classic-shell\"><div class=\"classic-topbar-left\"><span>Türkçe</span><span>Türkiye</span><span class=\"classic-top-message\">Nova Store ile yaşam alanına yeni bir dokunuş.</span></div><nav aria-label=\"Mağaza bilgileri\"><a href=\"#/journal\">İlham rehberi</a><a href=\"#/contact\">İletişim</a><a href=\"#/help\">Sık sorulanlar</a>${hostBridge?'':`<button data-action=\"theme-library\">Tema koleksiyonu</button>`}</nav></div></div><div class=\"classic-shell classic-header-main\"><button class=\"classic-mobile-menu\" data-action=\"classic-category-toggle\" aria-controls=\"classic-category-menu\" aria-expanded=\"false\" aria-label=\"Kategorileri aç\">${icon('menu')}</button><a class=\"classic-brand\" href=\"#/home\" aria-label=\"Nova Store ana sayfa\">Nova Store</a>${search}${actions}</div><div class=\"classic-navigation\"><div class=\"classic-shell\"><button class=\"classic-browse\" data-action=\"classic-category-toggle\" aria-controls=\"classic-category-menu\" aria-expanded=\"false\">${icon('menu')}<span>Kategorileri keşfet</span>${icon('chevron')}</button><nav class=\"classic-main-nav\" aria-label=\"Ana menü\">${navLinks.map(([path,label])=>`<a href=\"#/${path}\" data-classic-menu=\"${path}\">${label}${['home','catalog','journal'].includes(path)?icon('chevron'):''}</a>`).join('')}</nav><a class=\"classic-nav-feature\" href=\"${routeLink('catalog',{sort:'recommended'})}\">Yeni koleksiyon ${icon('arrow')}</a><a class=\"classic-nav-help\" href=\"#/help\">Alışveriş rehberi</a></div></div></header>`;\r\n  }\r\n  function classicProductCard(p) {\r\n    if(!p)return '';\r\n    const favorite=(state.favorites || []).includes(p.id);\r\n    const needsChoice=Boolean(p.purchaseRequiresHostSelection)||(Array.isArray(p.variants)&&p.variants.length>1);\r\n    const available=p.stock>0;\r\n    const label=!available?'Stokta yok':needsChoice?'Seçenekleri gör':'Sepete ekle';\r\n    const gallery=Array.isArray(p.gallery)?p.gallery:[];\r\n    const hover=p.imageHover||gallery.map(item=>typeof item==='string'?item:item?.src||item?.url).find(src=>src&&src!==p.image&&src!==p.imageUrl);\r\n    const badge=p.stock===0?'Tükendi':p.oldPrice>p.price?`−%${Math.round((1-p.price/p.oldPrice)*100)}`:p.badge;\r\n    const title=esc(p.name),id=esc(p.id);\r\n    const description=p.description||p.desc||'';\r\n    return `<article class=\"product-card card-classic classic-card\" data-product-id=\"${id}\" data-price=\"${p.price}\"><div class=\"classic-card-visual\"><a href=\"${productURL(p.id)}\" class=\"product-visual-link\" aria-label=\"${title} ürününü incele\"><div class=\"product-visual classic-product-visual ${hover?'classic-has-hover-image':''}\"><div class=\"classic-card-front\">${photo(p,'loading=\"lazy\" decoding=\"async\"')}</div>${hover?classicImage(hover,`${p.name} — farklı açı`,'class=\"classic-card-hover-image\" loading=\"lazy\"'):''}</div></a>${badge?`<span class=\"product-badge classic-badge\">${esc(badge)}</span>`:''}<div class=\"classic-compare-line\"><button class=\"compare-button\" data-action=\"compare-toggle\" data-id=\"${id}\" aria-label=\"${title}: karşılaştırma seçimini değiştir\" aria-pressed=\"false\">${icon('refresh')}</button></div></div><div class=\"product-meta classic-card-meta\"><h3><a href=\"${productURL(p.id)}\">${title}</a></h3><a class=\"classic-card-category\" href=\"${routeLink('catalog',{category:p.category})}\">${esc(p.category)}</a>${priceMarkup(p)}</div><div class=\"classic-card-extra\">${description?`<p class=\"classic-card-description\">${esc(description)}</p>`:''}<div class=\"classic-card-actions\"><button class=\"favorite-button\" data-action=\"favorite\" data-id=\"${id}\" aria-label=\"${title}: ${favorite?'favorilerden çıkar':'favorilere ekle'}\" aria-pressed=\"${favorite}\">${icon('heart')}</button><button class=\"add-button\" data-action=\"quick-add\" data-id=\"${id}\" aria-label=\"${title}: ${label.toLocaleLowerCase('tr-TR')}\" ${!available?'disabled':''}>${icon('bag')}<span>${label}</span></button><button class=\"quick-view\" data-action=\"quick-view\" data-id=\"${id}\" aria-label=\"${title}: hızlı görünüm\">${icon('search')}</button></div></div></article>`;\r\n  }\r\n  function classicCategoryRail() {\r\n    return `<aside id=\"classic-category-menu\" class=\"classic-category-rail\" aria-label=\"Ürün kategorileri\"><nav>${classicCategories().map((category,index)=>`<a href=\"${routeLink('catalog',{category})}\" data-classic-category=\"${esc(category)}\" data-category-index=\"${index}\">${classicCategoryIcon(category)}<span>${esc(category)}</span>${icon('chevron')}</a>`).join('')}</nav></aside>`;\r\n  }\r\n  function classicHeroSource(p) { return hostBridge?p.imageUrl:(T.heroImages?.[p.id]||p.image); }\r\n  function classicHero() {\r\n    const list=classicProducts().slice(0,4),p=list[0];\r\n    if(!p)return '';\r\n    const headline=hostBridge?p.name:(T.hero||'Yalın çizgiler.\\nDoğal konfor.');\r\n    const copy=hostBridge?(p.description||p.desc||'Mağaza koleksiyonunu keşfet.'):(T.sub||'Evinin en sevdiğin köşesi için doğal dokular ve zamansız tasarımlar.');\r\n    const visual=classicHeroSource(p)?classicImage(classicHeroSource(p),p.name,'fetchpriority=\"high\"'):photo(p,'fetchpriority=\"high\"');\r\n    return `<section class=\"classic-hero\" aria-label=\"Öne çıkan koleksiyon\" aria-roledescription=\"kampanya slayt gösterisi\" data-classic-slide=\"0\"><div class=\"classic-hero-copy\"><h1 data-classic-hero-title>${esc(headline).replace(/\\n/g,'<br>')}</h1><p data-classic-hero-description>${esc(copy)}</p><div class=\"classic-hero-thumbs\" aria-label=\"Öne çıkan ürünler\">${list.map((product,index)=>`<button data-action=\"classic-hero-dot\" data-slide=\"${index}\" aria-label=\"${esc(product.name)} kampanyasını göster\" aria-pressed=\"${index===0}\">${classicHeroSource(product)?classicImage(classicHeroSource(product),product.name,'loading=\"lazy\"'):photo(product,'loading=\"lazy\"')}</button>`).join('')}</div><a class=\"classic-hero-price\" href=\"${productURL(p.id)}\" data-classic-hero-link>${priceMarkup(p)}<span>Ürünü incele ${icon('arrow')}</span></a></div><a class=\"classic-hero-image\" href=\"${productURL(p.id)}\" data-classic-hero-visual aria-label=\"${esc(p.name)} ürününü incele\">${visual}</a><button class=\"classic-hero-arrow classic-hero-prev\" data-action=\"classic-hero-prev\" aria-label=\"Önceki kampanya\">${icon('chevron')}</button><button class=\"classic-hero-arrow classic-hero-next\" data-action=\"classic-hero-next\" aria-label=\"Sonraki kampanya\">${icon('chevron')}</button><div class=\"classic-hero-dots\" aria-label=\"Kampanya seçimi\">${list.map((product,index)=>`<button data-action=\"classic-hero-dot\" data-slide=\"${index}\" aria-label=\"${index+1}. kampanya: ${esc(product.name)}\" aria-pressed=\"${index===0}\"><span></span></button>`).join('')}<button class=\"classic-hero-playback\" data-action=\"classic-hero-playback\" aria-label=\"Otomatik slayt gösterisini durdur\">Duraklat</button></div></section>`;\r\n  }\r\n  function classicCategoryTiles() {\r\n    const catalog=classicProducts(),available=classicCategories();\r\n    const preferred=hostBridge?available:['Mobilya','Saatler','Aksesuar','Aydınlatma','Elektronik',...available];\r\n    const categories=[...new Set(preferred)].filter(category=>available.includes(category)).slice(0,5);\r\n    if(!categories.length)return '';\r\n    return `<section class=\"classic-section classic-category-section\" aria-labelledby=\"classic-category-heading\"><div class=\"classic-section-heading\"><span>YAŞAM ALANINA YENİ FİKİRLER</span><h2 id=\"classic-category-heading\">Öne çıkan kategoriler</h2><p>Sevdiğin parçaları bir araya getir. Kendine ait bir alan oluştur.</p></div><nav class=\"classic-category-tiles\" aria-label=\"Öne çıkan kategoriler\">${categories.map((category,index)=>{\r\n      const matches=catalog.filter(p=>p.category===category),product=matches[0];\r\n      const configured=T.categoryImages;\r\n      const image=!hostBridge?(Array.isArray(configured)?configured[available.indexOf(category)]:configured?.[category]):'';\r\n      const visual=image?classicImage(image,category,'loading=\"lazy\"'):product?photo(product,'loading=\"lazy\"'):'';\r\n      return `<a class=\"classic-category-tile ${index===0?'classic-category-large':''} ${visual?'':'classic-category-text-only'}\" href=\"${routeLink('catalog',{category})}\">${visual?`<div class=\"classic-category-image\">${visual}</div>`:''}<span class=\"classic-category-caption\"><strong>${esc(category)}</strong><small>${matches.length?`${matches.length} ürün`:'Koleksiyonu keşfet'}</small></span></a>`;\r\n    }).join('')}</nav></section>`;\r\n  }\r\n  function classicJournalCards() {\r\n    const catalog=classicProducts();\r\n    const articles=[\r\n      {id:'dogal-dokular',title:'Doğal dokularla daha sıcak bir ev',category:'EV & YAŞAM',copy:'Ahşap, yumuşak kumaşlar ve gün ışığı. Yaşam alanına sakin bir dokunuş katmanın yolları.',product:catalog[1]||catalog[0]},\r\n      {id:'calisma-kosesi',title:'Küçük bir alanda iyi bir çalışma köşesi',category:'TASARIM REHBERİ',copy:'Her parçanın bir işlevi, her köşenin bir hikâyesi olsun. Sana yer açan küçük seçimler.',product:catalog[4]||catalog[1]||catalog[0]},\r\n      {id:'isigin-dengesi',title:'Bir odayı değiştiren küçük ayrıntılar',category:'İLHAM',copy:'Aydınlatmadan aksesuarlara; evinin karakterini tamamlayan ayrıntıları birlikte keşfedelim.',product:catalog[5]||catalog[0]}\r\n    ];\r\n    return `<section class=\"classic-section classic-journal\" aria-labelledby=\"classic-journal-heading\"><div class=\"classic-section-heading\"><span>NOVA STORE İLHAM REHBERİ</span><h2 id=\"classic-journal-heading\">Biraz ilham, yeni bir başlangıç</h2><p>İyi hissettiren mekanlar için fikirler, malzemeler ve küçük ayrıntılar.</p></div><div class=\"classic-journal-grid\">${articles.map((article,index)=>`<article class=\"classic-journal-card\"><a class=\"classic-journal-image\" href=\"#/journal/${article.id}\" aria-label=\"${article.title}\">${!hostBridge&&T.journalImages?.[index]?classicImage(T.journalImages[index],article.title,'loading=\"lazy\"'):article.product?photo(article.product,'loading=\"lazy\"'):''}</a><div class=\"classic-journal-copy\"><span class=\"classic-journal-category\">${article.category}</span><h3><a href=\"#/journal/${article.id}\">${article.title}</a></h3><span class=\"classic-journal-author\">Nova Store Tasarım Ekibi</span><p>${article.copy}</p><a class=\"classic-read-more\" href=\"#/journal/${article.id}\">Devamını oku ${icon('arrow')}</a></div></article>`).join('')}</div></section>`;\r\n  }\r\n  function classicHome() {\r\n    const catalog=classicProducts();\r\n    if(!catalog.length)return `<div class=\"classic-shell classic-home\"><section class=\"classic-empty\" aria-live=\"polite\">${icon('box')}<h1>Bu koleksiyonda henüz ürün yok.</h1><p>Mağazanın yayınlanan ürünleri burada görünür.</p><a class=\"classic-button\" href=\"#/catalog\">Mağazayı incele ${icon('arrow')}</a></section></div>`;\r\n    // Host acknowledgements rebuild the page; preserve the currently selected collection.\r\n    const activeSelection=['bestsellers','featured','sales'].includes(classicProductTab)?classicProductTab:'bestsellers';\r\n    const selection=activeSelection==='sales'?catalog.filter(p=>p.oldPrice>p.price):activeSelection==='bestsellers'?[...catalog].sort((a,b)=>b.rating-a.rating):catalog;\r\n    const selectionMarkup=selection.length?productGrid(selection.slice(0,T.featuredCount||8)):'<div class=\"product-grid\"><p>Bu seçkide henüz ürün yok.</p></div>';\r\n    const spotlight=catalog.find(p=>p.id===T.spotlightProductId)||catalog[3]||catalog[0];\r\n    const storyProduct=catalog[1]||catalog[0];\r\n    const spotlightVisual=!hostBridge&&T.spotlightImage?classicImage(T.spotlightImage,spotlight.name,'loading=\"lazy\"'):photo(spotlight,'loading=\"lazy\"');\r\n    const storyVisual=!hostBridge&&T.storyImage?classicImage(T.storyImage,'Nova Store — doğal dokular ve yaşam alanları','loading=\"lazy\"'):photo(storyProduct,'loading=\"lazy\"');\r\n    const details=Array.isArray(spotlight.details)?spotlight.details.filter(item=>Array.isArray(item)&&item.length===2).slice(0,3):[];\r\n    return `<div class=\"classic-home\"><div class=\"classic-hero-band\"><div class=\"classic-shell classic-stage\">${classicCategoryRail()}${classicHero()}</div></div><div class=\"classic-shell\">${classicCategoryTiles()}<section class=\"classic-section classic-featured\" aria-labelledby=\"classic-featured-heading\"><div class=\"classic-section-heading\"><span>İYİ TASARIM, HER GÜN</span><h2 id=\"classic-featured-heading\">Öne çıkan ürünler</h2><p>${hostBridge?'Mağazanın koleksiyonunu keşfet.':'Doğal malzemeler, yalın çizgiler ve sevdiğin küçük ayrıntılar.'}</p></div><div class=\"classic-product-tabs\" role=\"group\" aria-label=\"Ürün seçkisi\"><button data-action=\"classic-product-tab\" data-tab=\"bestsellers\" aria-pressed=\"${activeSelection==='bestsellers'}\">Çok sevilenler</button><button data-action=\"classic-product-tab\" data-tab=\"featured\" aria-pressed=\"${activeSelection==='featured'}\">Öne çıkanlar</button><button data-action=\"classic-product-tab\" data-tab=\"sales\" aria-pressed=\"${activeSelection==='sales'}\">Fırsatlar</button></div><div id=\"classic-featured-products\" aria-live=\"polite\">${selectionMarkup}</div><a class=\"classic-collection-link\" href=\"#/catalog\">Tüm ürünleri keşfet ${icon('arrow')}</a></section></div><section class=\"classic-spotlight-band\"><div class=\"classic-shell classic-spotlight\"><a class=\"classic-spotlight-image\" href=\"${productURL(spotlight.id)}\" aria-label=\"${esc(spotlight.name)} ürününü incele\">${spotlightVisual}</a><div class=\"classic-spotlight-copy\"><span class=\"classic-eyebrow\">${esc(spotlight.category)} KOLEKSİYONU</span><h2>${esc(spotlight.name)}</h2><p>${esc(spotlight.description||spotlight.desc||'Koleksiyonun ayrıntılarını keşfet.')}</p>${details.length?`<dl>${details.map(([key,value])=>`<div><dt>${esc(key)}</dt><dd>${esc(value)}</dd></div>`).join('')}</dl>`:''}${priceMarkup(spotlight)}<a class=\"classic-button\" href=\"${productURL(spotlight.id)}\">Ürünü keşfet ${icon('arrow')}</a></div></div></section><div class=\"classic-shell\"><section class=\"classic-section classic-story\"><div class=\"classic-story-copy\"><span class=\"classic-eyebrow\">NOVA STORE HİKÂYESİ</span><h2>Güzel bir ev,<br>iyi seçimlerle başlar.</h2><p>Bir sandalyenin sıcak dokusu, çalışma köşendeki küçük bir ayrıntı, akşamı yumuşatan bir ışık. Yaşam alanını senin yapan şeyler, seçtiğin parçalarda saklı.</p><p>Nova Store'da tasarımı günlük yaşamın bir parçası olarak görüyoruz. Birlikte, kendine ait bir alan oluşturalım.</p><a class=\"classic-read-more\" href=\"#/about\">Bizi tanı ${icon('arrow')}</a></div><a class=\"classic-story-image\" href=\"#/about\" aria-label=\"Nova Store hikâyesini keşfet\">${storyVisual}</a></section>${classicJournalCards()}<nav class=\"classic-brand-strip\" aria-label=\"Nova Store koleksiyonları\">${classicCategories().slice(0,5).map(category=>`<a href=\"${routeLink('catalog',{category})}\"><strong>Nova Store</strong><span>${esc(category)}</span></a>`).join('')}</nav></div></div>`;\r\n  }\r\n  function classicFooter() {\r\n    const categories=classicCategories();\r\n    const catalog=classicProducts();\r\n    const newsletter=hostBridge?`<div class=\"classic-newsletter-copy\"><span class=\"classic-eyebrow\">NOVA STORE</span><h2>Koleksiyonları birlikte keşfedelim.</h2><p>Ürünler ve alışverişinle ilgili her adımda yanındayız.</p></div><a class=\"classic-button\" href=\"#/help\">Yardım merkezi ${icon('arrow')}</a>`:`<div class=\"classic-newsletter-copy\"><span class=\"classic-eyebrow\">YENİ FİKİRLERE YER AÇ</span><h2>Nova Store'dan ilham al.</h2><p>Yeni koleksiyonlar ve yaşam alanına iyi gelecek fikirler.</p></div><form id=\"classic-newsletter-form\" class=\"classic-newsletter-form\" data-classic-newsletter><label class=\"sr-only\" for=\"classic-newsletter-email\">E-posta adresin</label><div><input id=\"classic-newsletter-email\" name=\"email\" type=\"email\" autocomplete=\"email\" maxlength=\"254\" placeholder=\"E-posta adresin\" required><button class=\"classic-button\" type=\"submit\">Kaydol</button></div><small>Demo formu. E-posta gönderimi yapılmaz.</small><p class=\"classic-newsletter-status\" role=\"status\"></p></form>`;\r\n    const posts=[['dogal-dokular','Doğal dokularla daha sıcak bir ev',catalog[1]||catalog[0]],['isigin-dengesi','Bir odayı değiştiren küçük ayrıntılar',catalog[5]||catalog[0]]];\r\n    return `<section id=\"classic-newsletter\" class=\"classic-newsletter\"><div class=\"classic-shell\">${newsletter}</div></section><footer class=\"site-footer footer-classic classic-footer\"><div class=\"classic-shell\"><div class=\"classic-footer-grid\"><div class=\"classic-footer-about\"><a class=\"classic-brand\" href=\"#/home\">Nova Store</a><p>Doğal dokular, iyi düşünülmüş ayrıntılar ve günlük yaşamına eşlik eden tasarımlar.</p><a href=\"#/contact\">${icon('pin')}Mağaza ve iletişim bilgileri</a><a href=\"#/help\">${icon('headphones')}Yardım merkezine ulaşın</a><a href=\"#/journal\">${icon('book')}İlham rehberini keşfedin</a></div><section class=\"classic-footer-journal\"><h2>Son yazılar</h2>${posts.map(([id,title,product])=>`<a href=\"#/journal/${id}\">${product?photo(product,'loading=\"lazy\"'):''}<span><strong>${title}</strong><small>Nova Store İlham Rehberi</small></span></a>`).join('')}</section><nav aria-label=\"Nova Store\"><h2>Nova Store</h2><a href=\"#/about\">Hakkımızda</a><a href=\"#/catalog\">Mağazamız</a><a href=\"#/journal\">İlham rehberi</a><a href=\"#/contact\">İletişim</a></nav><nav aria-label=\"Müşteri hesabı\"><h2>Hesabım</h2><a href=\"#/account\">Hesap bilgilerim</a><a href=\"#/orders\">Siparişlerim</a><a href=\"#/favorites\">Favorilerim</a><a href=\"#/cart\">Sepetim</a><a href=\"#/help\">Yardım merkezi</a></nav><nav aria-label=\"Kategoriler\"><h2>Kategoriler</h2>${categories.slice(0,5).map(category=>`<a href=\"${routeLink('catalog',{category})}\">${esc(category)}</a>`).join('')}</nav></div><div class=\"classic-footer-bottom\"><span><strong>Nova Store</strong> · 2026</span><span>${hostBridge?'Mağazanın güncel koşulları hesap ve ödeme alanında sunulur.':'Bağımsız tema demosu · Gerçek satış veya ödeme yapılmaz.'}</span><button data-action=\"privacy-info\">Gizlilik bilgisi</button></div></div></footer>`;\r\n  }\r\n\r\n  // Nova Classic page adapters. No second cart, account or payment owner.\r\n  let classicHeroIndex=0, classicProductTab='bestsellers', classicColumns='4';\r\n  const classicArticles=[\r\n    ['dogal-dokular','Doğal dokularla daha sıcak bir ev','Ahşap, keten ve gün ışığıyla yaşam alanını sadeleştir.','Büyük bir değişim için her parçayı yenilemek gerekmez. Ahşabın sıcaklığını açık renk bir dokuyla eşleştir; kullandığın alanlara nefes alacak boşluk bırak. Önce odanın gün içinde en çok kullandığın köşesini düşün.','Mobilya'],\r\n    ['calisma-kosesi','Küçük bir alanda iyi bir çalışma köşesi','Her eşyanın bir yeri, her günün sakin bir başlangıcı olsun.','Masa üstünde yalnız günlük kullandığın araçlara yer ver. Bir düzenleyici, doğru yükseklikte bir sandalye ve yandan gelen ışık alanı daha kullanışlı yapar. Ölçüleri alışverişten önce kendi alanınla karşılaştır.','Aksesuar'],\r\n    ['isigin-dengesi','Işığın dengesi, evin ruhu','Yumuşak ışık ve küçük detaylarla akşamlarını yeniden düzenle.','Tek bir güçlü ışık yerine farklı köşelerde yumuşak ışık kaynaklarını birlikte düşün. Cam ve doğal dokular günün değişen ışığına farklı karşılık verir. Dekoratif ürünleri kullanım talimatlarına uygun kullan.','Aydınlatma']\r\n  ];\r\n  function classicPageBanner(title){return `<section class=\"classic-page-banner\">${!hostBridge&&T.storyImage?`<img src=\"${esc(T.storyImage)}\" alt=\"Nova Store yaşam alanı koleksiyonu\">`:''}<div><h1>${esc(title)}</h1><nav aria-label=\"Sayfa yolu\"><a href=\"#/home\">Ana sayfa</a><span>/</span><span>${esc(title)}</span></nav></div></section>`;}\r\n  function classicCatalog(params){\r\n    let html=legacyClassicCatalog(params),f=getFilters(params);\r\n    const title=f.q?`“${f.q}” için sonuçlar`:f.category||'Mağaza';\r\n    html=html.replace(/<h1 class=\"page-title\">[\\s\\S]*?<\\/h1>/,'').replace(/<p class=\"page-subtitle\">[\\s\\S]*?<\\/p>/,'');\r\n    const controls=`<div class=\"classic-view-controls\" aria-label=\"Ürün düzeni\">${[['3','3 sütun'],['4','4 sütun'],['list','Liste görünümü']].map(([v,label])=>`<button data-action=\"classic-columns\" data-columns=\"${v}\" aria-label=\"${label}\" aria-pressed=\"${classicColumns===v}\">${icon(v==='list'?'menu':'grid')}${v==='list'?'':v}</button>`).join('')}</div>`;\r\n    html=html.replace('<div class=\"catalog-toolbar\">','<div class=\"catalog-toolbar\">'+controls);\r\n    html=html.replace('<div class=\"product-grid\">',`<div class=\"product-grid\" data-classic-columns=\"${classicColumns}\">`);\r\n    html=html.replace(/<aside class=\"filter-panel\"[\\s\\S]*?<\\/aside>/,()=>classicFilterPanel(f));\r\n    html=html.replace(/<div class=\"active-filters\">[\\s\\S]*?<\\/div>/,'');\r\n    const selected=[['q',f.q&&'Arama: '+f.q],['category',f.category],['min',f.min!==''&&'En az '+money(Number(f.min)*100)],['max',f.max!==''&&'En çok '+money(Number(f.max)*100)],['stock',f.stock&&'Yalnız stoktakiler']].filter(([,label])=>label);\r\n    if(selected.length){const chips=selected.map(([key,label])=>{const next=new URLSearchParams(params);next.delete(key);return `<a href=\"${routeLink('catalog',Object.fromEntries(next))}\" aria-label=\"${esc(label)} filtresini kaldır\">${esc(label)} ${icon('close')}</a>`;}).join('');html=html.replace('<section class=\"catalog-products\" aria-label=\"Ürün listesi\">',`<section class=\"catalog-products\" aria-label=\"Ürün listesi\"><nav class=\"classic-filter-chips\" aria-label=\"Seçili filtreler\">${chips}<a href=\"#/catalog\">Tümünü temizle</a></nav>`);}\r\n    return classicPageBanner(title)+html;\r\n  }\r\n  function classicFilterPanel(f){\r\n    const desktop=document.body.dataset.mode==='web'&&innerWidth>760,counts=new Map(T.cats.map(category=>[category,T.products.filter(p=>p.category===category).length]));\r\n    const count=filterProducts(f).length,active=[f.category,f.min!==''||f.max!=='',f.stock].filter(Boolean).length;\r\n    return `<aside class=\"filter-panel classic-filter-panel\" aria-label=\"Ürün filtreleri\"><details ${desktop?'open':''}><summary>${icon('filter')} Filtreler ${active?`<span>${active}</span>`:''}</summary><form id=\"filter-form\" class=\"filter-form\"><label class=\"field\">Kategori<select name=\"category\"><option value=\"\">Tüm kategoriler (${T.products.length})</option>${T.cats.map(category=>`<option value=\"${esc(category)}\" ${f.category===category?'selected':''}>${esc(category)} (${counts.get(category)})</option>`).join('')}</select></label><div class=\"classic-filter-categories\">${T.cats.filter(c=>counts.get(c)>0).map(category=>`<button type=\"button\" data-action=\"classic-filter-category\" data-category=\"${esc(category)}\" aria-pressed=\"${f.category===category}\"><span>${esc(category)}</span><small>${counts.get(category)}</small></button>`).join('')}</div><fieldset><legend>Fiyat aralığı</legend><div class=\"range-fields\"><label class=\"field\">En az (₺)<input name=\"min\" type=\"number\" min=\"0\" max=\"10000000\" step=\"0.01\" value=\"${f.min}\" placeholder=\"0\"></label><label class=\"field\">En çok (₺)<input name=\"max\" type=\"number\" min=\"0\" max=\"10000000\" step=\"0.01\" value=\"${f.max}\" placeholder=\"Sınır yok\"></label></div><div class=\"classic-price-presets\">${[['','1500','1.500 ₺ altı'],['1500','5000','1.500–5.000 ₺'],['5000','','5.000 ₺ üzeri']].map(([min,max,label])=>`<button type=\"button\" data-action=\"classic-price-range\" data-min=\"${min}\" data-max=\"${max}\">${label}</button>`).join('')}</div></fieldset><label class=\"checkbox-field\"><input type=\"checkbox\" name=\"stock\" ${f.stock?'checked':''}>Yalnız stoktakiler</label><p data-classic-filter-count role=\"status\">${count} ürün bu filtrelerle eşleşiyor.</p><button class=\"button full\" type=\"submit\">Filtreleri uygula</button><p id=\"filter-error\" class=\"form-error\" role=\"alert\"></p><a class=\"text-link\" href=\"#/catalog\">Filtreleri temizle ${icon('refresh')}</a></form></details></aside>`;\r\n  }\r\n  function classicUpdateFilterCount(){\r\n    const form=document.getElementById('filter-form');if(!form)return;const data=new FormData(form),min=String(data.get('min')||''),max=String(data.get('max')||''),invalid=min!==''&&max!==''&&Number(min)>Number(max),params=new URLSearchParams(currentRoute().params);\r\n    for(const name of ['category','min','max']){const value=String(data.get(name)||'');if(value)params.set(name,value);else params.delete(name);}if(data.get('stock'))params.set('stock','1');else params.delete('stock');\r\n    const status=form.querySelector('[data-classic-filter-count]');if(status)status.textContent=invalid?'Fiyat aralığını kontrol et.':`${filterProducts(getFilters(params)).length} ürün bu filtrelerle eşleşiyor.`;\r\n    form.querySelectorAll('[data-action=\"classic-filter-category\"]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.category===data.get('category'))));\r\n  }\r\n  function classicImages(p){return hostBridge?(p.imageUrl?[p.imageUrl]:[]):[...new Set((p.gallery?.length?p.gallery:[p.image]).filter(Boolean))];}\r\n  function classicDetail(id){\r\n    const p=products.get(id);if(!p)return notFound();\r\n    const images=classicImages(p), idx=T.products.findIndex(x=>x.id===id), remaining=Math.max(0,p.stock-productInCart(id));\r\n    const tabs=[['description','Açıklama'],['specs','Ek bilgiler'],['reviews','Değerlendirmeler'],['brand','Nova Store'],['delivery','Teslimat ve iade']];\r\n    const specs=hostBridge?(p.features||[]).map((v,i)=>['Özellik '+(i+1),v]):p.details||[];\r\n    const form=`<form id=\"product-form\" data-id=\"${esc(id)}\">${!hostBridge?`<fieldset class=\"variant-fieldset\"><legend>${p.variants.length>1?'Ölçü / seçenek':'Seçenek'}</legend><div class=\"variant-options\">${p.variants.map((v,i)=>`<label class=\"variant-option\"><input type=\"radio\" name=\"variant\" value=\"${esc(v)}\" ${i===0?'checked':''} required><span>${esc(v)}</span></label>`).join('')}</div></fieldset>`:''}<div class=\"classic-buy-row\"><div class=\"classic-quantity\"><button type=\"button\" data-action=\"classic-quantity\" data-delta=\"-1\" aria-label=\"Adedi azalt\">−</button><label class=\"sr-only\" for=\"classic-product-quantity\">Adet</label><input id=\"classic-product-quantity\" name=\"quantity\" type=\"number\" min=\"1\" max=\"${Math.max(1,remaining)}\" step=\"1\" value=\"1\" required><button type=\"button\" data-action=\"classic-quantity\" data-delta=\"1\" aria-label=\"Adedi artır\">+</button></div><button type=\"submit\" class=\"button\" ${!remaining||p.purchaseRequiresHostSelection&&!p.canOpenProduct?'disabled':''}>${p.purchaseRequiresHostSelection?'Seçenekleri mağazada seç':remaining?'Sepete ekle':'Stokta yok'}</button></div><p class=\"classic-stock\" role=\"status\">${remaining?`${remaining} adet eklenebilir`:'Stokta yok'}</p></form>`;\r\n    return `<div class=\"container classic-detail page\"><div class=\"classic-detail-layout\"><section class=\"classic-gallery\" aria-label=\"Ürün görselleri\"><div class=\"classic-thumbnails\">${images.map((src,i)=>`<button data-action=\"classic-image\" data-index=\"${i}\" data-id=\"${esc(id)}\" aria-label=\"${i+1}. ürün görseli\" aria-pressed=\"${i===0}\"><img src=\"${esc(src)}\" alt=\"${esc(p.name)} ${i+1}. görünüm\"></button>`).join('')}</div><div class=\"classic-detail-image\" id=\"detail-image\">${images.length?`<img src=\"${esc(images[0])}\" alt=\"${esc(p.name)}\" fetchpriority=\"high\">`:'<span>Görsel henüz eklenmemiş</span>'}<button class=\"classic-zoom\" data-action=\"classic-zoom\" data-id=\"${esc(id)}\" aria-label=\"Ürün görselini büyüt\">${icon('search')}</button></div></section><section class=\"detail-info\"><div class=\"classic-detail-top\">${breadcrumbs(p.name)}<nav aria-label=\"Ürün gezinmesi\">${idx>0?`<a href=\"${productURL(T.products[idx-1].id)}\" aria-label=\"Önceki ürün\">‹</a>`:''}<a href=\"#/catalog\" aria-label=\"Mağazaya dön\">${icon('grid')}</a>${idx<T.products.length-1?`<a href=\"${productURL(T.products[idx+1].id)}\" aria-label=\"Sonraki ürün\">›</a>`:''}</nav></div><h1>${esc(p.name)}</h1>${priceMarkup(p)}<p class=\"detail-desc\">${esc(p.description)}</p>${form}<div class=\"classic-detail-actions\"><button class=\"compare-button\" data-action=\"compare-toggle\" data-id=\"${esc(id)}\" aria-pressed=\"${comparedProducts.has(id)}\">${icon('refresh')} Karşılaştır</button><button class=\"favorite-button\" data-action=\"favorite\" data-id=\"${esc(id)}\" aria-pressed=\"${state.favorites.includes(id)}\">${icon('heart')} Favorilere ekle</button><button data-action=\"classic-size\" data-id=\"${esc(id)}\">${icon('grid')} Ölçü bilgisi</button></div><div class=\"classic-product-meta\"><p><strong>Ürün kodu:</strong> ${esc(hostBridge?p.hostProductId||p.id:'NS-CL-'+id.slice(-2).padStart(3,'0'))}</p><p><strong>Kategori:</strong> <a href=\"${routeLink('catalog',{category:p.category})}\">${esc(p.category)}</a></p><p>${hostBridge?'Son fiyat ve stok mağazada doğrulanır.':'Ürün, fiyat ve stok temsili demo verisidir.'}</p></div></section></div><section class=\"classic-detail-tabs\"><div role=\"tablist\" aria-label=\"Ürün bilgileri\">${tabs.map(([key,label],i)=>`<button role=\"tab\" id=\"classic-tab-${key}\" aria-controls=\"classic-panel-${key}\" aria-selected=\"${i===0}\" tabindex=\"${i===0?'0':'-1'}\" data-action=\"classic-detail-tab\" data-tab=\"${key}\">${label}</button>`).join('')}</div><div id=\"classic-panel-description\" role=\"tabpanel\" aria-labelledby=\"classic-tab-description\"><div class=\"classic-description\"><div><h2>Günlük yaşamına eşlik eder.</h2><p>${esc(p.description)}</p><p>${hostBridge?'Ürün bilgileri mağaza kataloğundan alınır.':'Nova Store Classic koleksiyonu için hazırlanmış temsili üründür. Fotoğraflar özgün olarak üretilmiş görselleştirmelerdir.'}</p></div><div><h3>Detaylarda saklı</h3>${specs.length?`<dl>${specs.map(([k,v])=>`<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('')}</dl>`:'<p>Ek bilgiler mağaza kataloğunda bulunmuyor.</p>'}</div></div></div><div id=\"classic-panel-specs\" role=\"tabpanel\" aria-labelledby=\"classic-tab-specs\" hidden><dl class=\"classic-specs\">${specs.map(([k,v])=>`<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('')||'<p>Ek bilgi henüz eklenmemiş.</p>'}</dl></div><div id=\"classic-panel-reviews\" role=\"tabpanel\" aria-labelledby=\"classic-tab-reviews\" hidden><h2>Müşteri değerlendirmeleri</h2><p>${hostBridge?'Doğrulanmış değerlendirmeler mağazanın ürün sayfasında yönetilir.':'Bu demo üründe yayımlanmış müşteri yorumu bulunmuyor.'}</p>${hostBridge&&p.canOpenProduct?`<button class=\"button\" data-action=\"classic-host-product\" data-id=\"${esc(id)}\">Mağaza ürün sayfasını aç</button>`:'<a class=\"text-link\" href=\"#/account\">Hesabımı incele</a>'}</div><div id=\"classic-panel-brand\" role=\"tabpanel\" aria-labelledby=\"classic-tab-brand\" hidden><h2>Nova Store</h2><p>Yaşamına iyi gelen seçimler. Doğal çizgiler, sade detaylar ve kullanışlı parçalar.</p><a href=\"#/about\">Koleksiyonun hikâyesi</a></div><div id=\"classic-panel-delivery\" role=\"tabpanel\" aria-labelledby=\"classic-tab-delivery\" hidden><h2>Teslimat ve iade</h2><p>${hostBridge?'Teslimat, iade koşulları ve son ücret mağazanın ödeme alanında doğrulanır.':`Demo kargo ${money(T.shippingFee)}. İndirim sonrası ${money(T.freeShipping)} üzerindeki ürün tutarında ücretsiz. Gerçek gönderim veya iade işlemi yapılmaz.`}</p><button class=\"button secondary\" data-action=\"delivery-info\">Koşulları incele</button></div></section>${classicBundle(p)}<section class=\"classic-related\"><h2>Bunlar da hoşuna gidebilir</h2>${productGrid(T.products.filter(x=>x.id!==id).slice(0,4))}</section><div class=\"classic-sticky-buy\" hidden><strong>${esc(p.name)}</strong>${priceMarkup(p)}<button class=\"button\" data-action=\"classic-back-to-purchase\">${p.purchaseRequiresHostSelection?'Seçenekleri gör':'Ürünü seç'}</button></div></div>`;\r\n  }\r\n  function classicBundle(p){\r\n    if(hostBridge)return '';\r\n    const list=[p,...T.products.filter(x=>x.id!==p.id&&x.stock>0&&x.variants.length===1).slice(0,2)];\r\n    if(list.length<2)return '';\r\n    return `<section class=\"classic-bundle\"><h2>Birlikte iyi gider</h2><p>Seçtiklerini birlikte sepete ekle. Fiyatlar tek tek toplanır; ek paket indirimi yoktur.</p><div>${list.map(x=>`<label><input type=\"checkbox\" name=\"classic-bundle-product\" value=\"${esc(x.id)}\" ${x.stock?'checked':'disabled'}>${photo(x)}<strong>${esc(x.name)}</strong>${priceMarkup(x)}</label>`).join('')}</div><p><strong data-classic-bundle-total></strong><button class=\"button\" data-action=\"classic-bundle-add\" data-id=\"${esc(p.id)}\">Seçilenleri sepete ekle</button></p><p data-classic-bundle-status role=\"status\"></p></section>`;\r\n  }\r\n  function classicAccount(){\r\n    if(hostBridge)return classicPageBanner('Hesabım')+`<div class=\"container classic-account\"><section><h2>${hostBridge.snapshot().session.status==='authenticated'?'Hoş geldin'+(hostBridge.snapshot().session.user?.fullName?', '+esc(hostBridge.snapshot().session.user.fullName):''):'Giriş yap'}</h2><p>Hesap, adres ve sipariş bilgilerin mağazanın güvenli hesap alanında korunur.</p><button class=\"button full\" data-action=\"host-account\">Mağaza hesabımı aç</button></section><section><h2>Birlikte daha kolay</h2><p>Siparişlerini takip et, favorilerini kaydet ve adreslerini yönet.</p><a class=\"button secondary\" href=\"#/favorites\">Favorilerime git</a></section></div>`;\r\n    if(state.session)return classicPageBanner('Hesabım')+legacyClassicAccount().replace(/<h1 class=\"page-title\">[\\s\\S]*?<\\/h1>/,'');\r\n    return classicPageBanner('Hesabım')+`<div class=\"container classic-account\"><section><h2>Giriş yap</h2><form id=\"classic-demo-login\"><p class=\"muted\">Şifre girmeden hesap görünümünü deneyebilirsin.</p><label class=\"field\">Örnek kullanıcı<input value=\"demo@novastore.example\" readonly autocomplete=\"off\"></label><label class=\"field\">Örnek parola<div class=\"classic-password\"><input id=\"classic-password\" type=\"password\" value=\"demo-oturum\" readonly autocomplete=\"off\"><button type=\"button\" data-action=\"classic-password\" aria-label=\"Örnek parolayı göster\">${icon('search')}</button></div></label><button class=\"button full\" type=\"submit\">Demo oturumunu aç</button><div class=\"classic-login-options\"><span>Gerçek giriş yapılmaz.</span><button type=\"button\" data-action=\"classic-forgot\">Parolamı unuttum</button></div></form></section><section><h2>Hesap oluştur</h2><p>Siparişlerini tek yerden takip et, beğendiğin ürünleri kaydet. Gerçek üyelik işlemleri mağazanın hesap altyapısıyla yönetilir.</p><button class=\"button secondary\" data-action=\"classic-register\">Kayıt görünümünü incele</button><div class=\"classic-register-preview\" hidden><h3>Yeni hesabın</h3><p>Bu demoda kişisel bilgi toplanmaz. Örnek hesapla üyelik sonrası ekranı inceleyebilirsin.</p><button class=\"button\" data-action=\"session\">Örnek hesapla devam et</button></div></section></div>`;\r\n  }\r\n  const classicQuestions=[['Siparişimi nereden takip ederim?','Hesabım bölümündeki siparişler alanından. Bu demoda kayıtlar yalnızca tarayıcındaki örnek siparişlerdir.'],['Ürünlerin ölçülerini nasıl kontrol ederim?','Ürün detayındaki Ek bilgiler ve Ölçü bilgisi alanlarını açabilirsin. Demo ölçüler temsilidir.'],['Kargoyu nasıl hesaplıyorsunuz?','Demo sepetinde ürün toplamı, kupon ve ücretsiz kargo eşiği birlikte hesaplanır. Canlı mağazada son fiyat mağazanın ödeme adımından alınır.'],['Stokta olmayan ürünleri alabilir miyim?','Stok tükenen üründe satın alma düğmesi kapanır. Sepet adedi ürünün mevcut stok sınırını aşamaz.'],['İade işlemini nereden yaparım?','Gerçek mağazada hesabının sipariş alanından. Bu demoda gerçek iade veya gönderim yapılmaz.']];\r\n  function classicFaqList(){return classicQuestions.map(([q,a],i)=>`<details ${i===0?'open':''}><summary>${esc(q)}</summary><p>${esc(hostBridge?(i===1?'Ürün detayındaki Ek bilgiler alanında mağaza kataloğundan gelen ölçüleri inceleyebilirsin. Eksik ölçüler için mağazaya danış.':'Sipariş ve teslimat bilgilerini mağazanın güvenli hesap alanında inceleyebilirsin.'):a)}</p></details>`).join('');}\r\n  function classicContact(){return `<section class=\"classic-map-section\"><div class=\"classic-map\" data-classic-map><div><span>${icon('pin')}</span><h2>${hostBridge?'Mağaza konumu':'Örnek konum · İstanbul'}</h2><p>${hostBridge?'Mağazanın doğrulanmış konum bilgisi henüz bağlanmadı.':'İsteğinle OpenStreetMap açılır. Bu nokta gerçek bir Nova Store mağazası değildir.'}</p>${hostBridge?'':`<button class=\"button\" data-action=\"classic-map-load\">Etkileşimli haritayı aç</button>`}</div></div><aside><span class=\"eyebrow\">NOVA STORE</span><h1>Birlikte<br>güzel seçimler.</h1><p>${hostBridge?'Mağaza iletişim bilgileri yönetim panelinden bağlanmalıdır.':'Temsili mağaza iletişim alanı. Gerçek adres ve telefon henüz tanımlanmadı.'}</p><a class=\"text-link\" href=\"#/about\">Bizi daha yakından tanı</a></aside></section><div class=\"container classic-contact-grid\"><section><span class=\"eyebrow\">AKLINA TAKILANLAR</span><h2>Sık sorulan sorular</h2>${classicFaqList()}</section><section><span class=\"eyebrow\">BİRLİKTE ÇÖZELİM</span><h2>Bize bir not bırak</h2><p>${hostBridge?'Mesaj gönderim bağlantısı henüz tanımlanmadı. NovaBot veya mağaza hesabını kullanabilirsin.':'Bu bir form önizlemesidir. Bilgiler gönderilmez veya kaydedilmez.'}</p><form id=\"classic-contact-form\"><div class=\"classic-contact-fields\"><label class=\"field\">Adın<input value=\"${hostBridge?'Mağaza hesabında yönetilir':'Demo Kullanıcı'}\" readonly></label><label class=\"field\">E-posta<input value=\"${hostBridge?'Mağaza hesabında yönetilir':'demo@novastore.example'}\" readonly></label><label class=\"field\">Konu<select name=\"topic\"><option>Ürün bilgisi</option><option>Sipariş</option><option>İade ve teslimat</option></select></label><label class=\"field\">Telefon<input value=\"${hostBridge?'Mağaza hesabında yönetilir':'Demo · telefon istenmez'}\" readonly></label></div><label class=\"field\">Mesajın<textarea name=\"message\" maxlength=\"2000\" placeholder=\"Örnek mesajını burada deneyebilirsin.\" ${hostBridge?'disabled':''}></textarea></label><button class=\"button\" ${hostBridge?'disabled':''}>Taslağı önizle</button><p role=\"status\" data-classic-contact-status></p></form></section></div>`;}\r\n  function classicHelp(){return classicPageBanner('Yardım merkezi')+`<div class=\"container classic-help\"><h2>Alışverişinde yanındayız.</h2>${classicFaqList()}<a class=\"button\" href=\"#/contact\">İletişime geç</a></div>`;}\r\n  function classicAbout(){return classicPageBanner('Nova Store hakkında')+`<div class=\"container classic-about\"><div><span class=\"eyebrow\">DAHA SADE BİR YAŞAM</span><h2>Her gün kullanılan,<br>iyi düşünülmüş parçalar.</h2><p>Nova Store'da yaşam alanına yakışan seçimleri bir araya getiriyoruz. İşlev, doğal doku ve sade çizgiler; bu koleksiyonun başlangıç noktası.</p><p>${hostBridge?'Mağazanın ürünlerini ve güncel bilgilerini katalogdan inceleyebilirsin.':'Classic, bağımsız bir tema adayıdır. Görseller bu çalışma için özgün üretilmiştir; ürün ve fiyatlar örnektir.'}</p><a class=\"button\" href=\"#/catalog\">Koleksiyonu keşfet</a></div>${!hostBridge&&T.storyImage?`<img src=\"${esc(T.storyImage)}\" alt=\"Doğal dokularla Nova Store yaşam alanı\">`:''}</div>`;}\r\n  function classicJournal(id){const entry=classicArticles.find(a=>a[0]===id);return classicPageBanner(entry?entry[1]:'Yaşam rehberi')+`<div class=\"container classic-journal-page\">${entry?`<article><span class=\"eyebrow\">NOVA STORE · YAŞAM REHBERİ</span><h2>${esc(entry[2])}</h2><p>${esc(entry[3])}</p><a class=\"button\" href=\"${routeLink('catalog',{category:entry[4]})}\">İlgili koleksiyonu keşfet</a><a href=\"#/journal\" class=\"text-link\">Tüm yazılar</a></article>`:classicArticles.map(a=>`<article><span class=\"eyebrow\">${esc(a[4])}</span><h2><a href=\"#/journal/${a[0]}\">${esc(a[1])}</a></h2><p>${esc(a[2])}</p><a class=\"text-link\" href=\"#/journal/${a[0]}\">Devamını oku ${icon('arrow')}</a></article>`).join('')}</div>`;}\r\n  function classicUpdateCounters(){\r\n    document.querySelectorAll('[data-classic-compare-count]').forEach(e=>{e.hidden=!comparedProducts.size;e.textContent=comparedProducts.size;});\r\n    document.querySelectorAll('[data-classic-cart-subtotal]').forEach(e=>e.textContent=money(state.cart.reduce((n,l)=>n+(products.get(l.productId)?.price||0)*l.qty,0)));\r\n  }\r\n  function classicUpdateBundle(){let sum=0,count=0;document.querySelectorAll('[name=classic-bundle-product]:checked').forEach(el=>{sum+=products.get(el.value)?.price||0;count++;});const label=document.querySelector('[data-classic-bundle-total]');if(label)label.textContent=`${count} ürün · ${money(sum)}`;const b=document.querySelector('[data-action=classic-bundle-add]');if(b)b.disabled=!count;}\r\n  function classicAddQuantity(id,variant,quantity){const p=products.get(id);if(!p||!p.variants.includes(variant)||!Number.isSafeInteger(quantity)||quantity<1||quantity>p.stock-productInCart(id)){toast('Seçeneği, adedi ve kalan stoğu kontrol et.');return false;}for(let i=0;i<quantity;i++)addToCart(id,variant);return true;}\r\n  function classicSelectImage(id,index,zoom=false){const p=products.get(id);if(!p)return;const images=classicImages(p),i=Math.max(0,Math.min(index,images.length-1));if(!images[i])return;if(zoom){showDialog(p.name,`<div class=\"classic-lightbox\"><img src=\"${esc(images[i])}\" alt=\"${esc(p.name)}\">${images.length>1?`<div><button data-action=\"classic-zoom-step\" data-id=\"${esc(id)}\" data-index=\"${(i+images.length-1)%images.length}\" aria-label=\"Önceki görsel\">‹</button><span>${i+1} / ${images.length}</span><button data-action=\"classic-zoom-step\" data-id=\"${esc(id)}\" data-index=\"${(i+1)%images.length}\" aria-label=\"Sonraki görsel\">›</button></div>`:''}</div>`);document.getElementById('info-dialog').classList.add('classic-lightbox-dialog');return;}const box=document.querySelector('.classic-detail-image'),img=box?.querySelector('img');if(img){img.src=images[i];box.dataset.index=i;}document.querySelectorAll('[data-action=classic-image]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.index)===i)));}\r\n  function classicSetDetailTab(key,focus=false){document.querySelectorAll('.classic-detail-tabs [role=tab]').forEach(b=>{const active=b.dataset.tab===key;b.setAttribute('aria-selected',String(active));b.tabIndex=active?0:-1;if(active&&focus)b.focus();});document.querySelectorAll('.classic-detail-tabs [role=tabpanel]').forEach(e=>e.hidden=e.id!=='classic-panel-'+key);}\r\n  function enhanceClassic(){classicSetupHero();classicUpdateCounters();classicUpdateBundle();document.querySelectorAll('.classic-main-nav a').forEach(a=>{const active=a.getAttribute('href')==='#/'+currentRoute().name;a.toggleAttribute('aria-current',active);if(active)a.setAttribute('aria-current','page');});const selector=document.getElementById('classic-search-category');if(selector)selector.value=currentRoute().params.get('category')||'';}\r\n  document.addEventListener('click',e=>{\r\n    if(T.style!=='classic')return;const b=e.target.closest('[data-action]');if(!b||b.disabled)return;const a=b.dataset.action,id=b.dataset.id;\r\n    if(a==='classic-compare-open')openComparison();\r\n    else if(a==='classic-filter-category'){const form=b.closest('form');form.elements.category.value=b.dataset.category;classicUpdateFilterCount();}\r\n    else if(a==='classic-price-range'){const form=b.closest('form');form.elements.min.value=b.dataset.min;form.elements.max.value=b.dataset.max;classicUpdateFilterCount();}\r\n    else if(a==='classic-columns'){classicColumns=['3','4','list'].includes(b.dataset.columns)?b.dataset.columns:'4';const grid=document.querySelector('.catalog-products .product-grid');if(grid)grid.dataset.classicColumns=classicColumns;document.querySelectorAll('[data-action=classic-columns]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));}\r\n    else if(a==='classic-image')classicSelectImage(id,Number(b.dataset.index));\r\n    else if(a==='classic-zoom'||a==='classic-zoom-step')classicSelectImage(id,a==='classic-zoom'?Number(document.querySelector('.classic-detail-image')?.dataset.index||0):Number(b.dataset.index),true);\r\n    else if(a==='classic-detail-tab')classicSetDetailTab(b.dataset.tab);\r\n    else if(a==='classic-size'){const p=products.get(id);if(p)showDialog('Ölçü ve ürün bilgisi',hostBridge?'<p>Doğrulanmış ölçü bilgisi için mağazanın ürün sayfasını kullan.</p>':`<dl class=\"classic-specs\">${p.details.map(([k,v])=>`<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`).join('')}</dl><p>Demo ölçüler temsilidir.</p>`);}\r\n    else if(a==='classic-host-product'&&hostBridge)runHost(()=>hostBridge.openProduct(id),b);\r\n    else if(a==='classic-quantity'){const input=b.parentElement.querySelector('input');input.value=String(Math.max(1,Math.min(Number(input.max)||99,(Number(input.value)||1)+Number(b.dataset.delta))));}\r\n    else if(a==='classic-back-to-purchase'){document.getElementById('product-form')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth',block:'center'});document.querySelector('#product-form button[type=submit]')?.focus({preventScroll:true});}\r\n    else if(a==='classic-password'){const input=document.getElementById('classic-password');input.type=input.type==='password'?'text':'password';b.setAttribute('aria-label',input.type==='password'?'Örnek parolayı göster':'Örnek parolayı gizle');}\r\n    else if(a==='classic-register'){const panel=document.querySelector('.classic-register-preview');panel.hidden=!panel.hidden;b.setAttribute('aria-expanded',String(!panel.hidden));}\r\n    else if(a==='classic-forgot')showDialog('Parola yardımı','<p>Bu demoda gerçek parola bulunmaz. Canlı mağazada parola yenileme mevcut hesap altyapısı üzerinden yapılır.</p>');\r\n    else if(a==='classic-bundle-add'&&!hostBridge){const selected=[...document.querySelectorAll('[name=classic-bundle-product]:checked')].map(x=>products.get(x.value)).filter(Boolean),form=document.getElementById('product-form');const chosen=new FormData(form).get('variant');const invalid=selected.find(p=>p.stock-productInCart(p.id)<1||p.variants.length>1&&p.id!==id);if(invalid){toast(`${invalid.name} için stok veya seçenek kontrolü gerekli.`);return;}for(const p of selected)addToCart(p.id,p.id===id?String(chosen||p.variants[0]):p.variants[0],1);const status=document.querySelector('[data-classic-bundle-status]');if(status)status.textContent=`${selected.length} ürün sepete eklendi.`;}\r\n    else if(a==='classic-map-load'&&!hostBridge){cons