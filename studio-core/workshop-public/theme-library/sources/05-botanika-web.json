>NOVA STORE KOLEKSİYONU</span><h2 id=\"classic-category-preview-title\">${esc(category)}</h2><p>${list.length} ürün</p><a class=\"text-link\" href=\"${routeLink('catalog',{category})}\">Tüm koleksiyonu gör ${icon('arrow')}</a></div><div class=\"classic-category-picks\">${list.slice(0,3).map(p=>`<a class=\"classic-category-pick\" href=\"${productURL(p.id)}\"><span class=\"classic-category-pick-media\">${photo(p)}</span><strong>${esc(p.name)}</strong><span class=\"classic-category-pick-prices\">${priceMarkup(p)}</span></a>`).join('')||'<p class=\"classic-category-preview-empty\">Bu kategoriye henüz ürün eklenmemiş.</p>'}</div>`;\r\n    const rect=rail.getBoundingClientRect(),top=Math.max(0,12-rect.top);\r\n    panel.style.setProperty('--classic-menu-left',Math.max(0,rect.right)+'px');\r\n    panel.style.setProperty('--classic-menu-top',top+'px');\r\n    panel.style.setProperty('--classic-menu-height',Math.max(80,innerHeight-rect.top-top-12)+'px');\r\n    panel.hidden=false;\r\n    rail.querySelectorAll('[data-classic-category]').forEach(a=>{a.setAttribute('aria-controls',panel.id);a.setAttribute('aria-expanded',String(a===link));});\r\n  }\r\n  document.addEventListener('pointerover',e=>{if(!isApplicationSurface()&&T.style==='classic'){const a=e.target.closest('[data-classic-category]');if(a)classicOpenCategory(a);}});\r\n  document.addEventListener('focusin',e=>{if(!isApplicationSurface()&&T.style==='classic'){const a=e.target.closest('[data-classic-category]');if(a)classicOpenCategory(a);}});\r\n  let classicGesture=null,classicSuppressClickUntil=0;\r\n  document.addEventListener('pointerdown',e=>{if(T.style!=='classic'||e.pointerType==='mouse'||!e.target.closest('.classic-hero'))return;classicGesture={id:e.pointerId,x:e.clientX,y:e.clientY,panel:e.target.closest('.classic-hero')};},{passive:true});\r\n  document.addEventListener('pointerup',e=>{const g=classicGesture;classicGesture=null;if(!g||g.id!==e.pointerId||!g.panel.isConnected)return;const dx=e.clientX-g.x,dy=e.clientY-g.y;if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)*1.4){classicSuppressClickUntil=Date.now()+500;classicChangeHero(classicHeroIndex+(dx<0?1:-1));}},{passive:true});\r\n  document.addEventListener('pointercancel',()=>{classicGesture=null;},{passive:true});\r\n  document.addEventListener('click',e=>{if(T.style==='classic'&&Date.now()<classicSuppressClickUntil&&e.target.closest('.classic-hero')){e.preventDefault();e.stopImmediatePropagation();}},true);\r\n  document.addEventListener('keydown',e=>{if(T.style!=='classic'||!e.target.closest('.classic-hero')||!['ArrowLeft','ArrowRight'].includes(e.key))return;e.preventDefault();classicChangeHero(classicHeroIndex+(e.key==='ArrowRight'?1:-1));});\r\n\r\n  // Four independent sector presentations. This snippet lives inside the existing\r\n  // controller closure and never owns auth/cart/checkout/backend persistence.\r\n  const isSectorNext = () => ['paper','garage','voyage','flora'].includes(T.nextSector);\r\n  const sectorNextState = {group:'all',list:new Set()};\r\n  if(isSectorNext())document.body.dataset.sectorNext=T.nextSector;\r\n  const nextSelected = () => T.products.filter(p=>hostBridge||sectorNextState.group==='all'||p.nextGroup===sectorNextState.group);\r\n  const nextPhoto = p => p ? photo(p,'loading=\"lazy\" decoding=\"async\"') : '<span class=\"next-no-image\">Görsel bekleniyor</span>';\r\n  const nextHeroPhoto = () => hostBridge ? nextPhoto(T.products[0]) : `<img src=\"${esc(T.heroImage)}\" alt=\"Nova Store ${esc(T.sector)} için özgün temsili koleksiyon fotoğrafı\" fetchpriority=\"high\">`;\r\n  const nextTitle = () => hostBridge ? 'Mağazandan yeni seçimler.' : T.hero;\r\n  const nextSubtitle = () => hostBridge ? 'Ürün, fiyat ve stok bilgileri mağaza kataloğundan alınır.' : T.sub;\r\n  const nextHeading = (title,eyebrow='KOLEKSİYONU KEŞFET') => `<div class=\"next-heading\"><div><span class=\"next-eyebrow\">${esc(eyebrow)}</span><h2>${esc(title)}</h2></div><a href=\"#/catalog\">Tüm ürünler ${icon('arrow')}</a></div>`;\r\n  function sectorNextHeader(){\r\n    const search=`<form id=\"search-form\" class=\"search-form next-search\" role=\"search\"><label class=\"sr-only\" for=\"search-input\">Ürün veya kategori ara</label><input id=\"search-input\" name=\"q\" type=\"search\" maxlength=\"100\" autocomplete=\"off\" placeholder=\"${T.nextSector==='garage'?'Ürün adı veya kategori ara…':T.nextSector==='paper'?'Fikrindeki ürünü ara…':T.nextSector==='flora'?'Bitki, saksı veya bakım ara…':'Bir sonraki yol arkadaşını ara…'}\"><button aria-label=\"Ara\">${icon('search')}</button></form>`;\r\n    const brand=`<a class=\"next-brand\" href=\"#/home\" aria-label=\"Nova Store ana sayfa\">Nova Store<span>${esc(T.sector)}</span></a>`;\r\n    const categories=`<nav class=\"next-nav\" aria-label=\"Koleksiyonlar\">${T.cats.map(category=>`<span class=\"next-nav-item\"><a href=\"${routeLink('catalog',{category})}\" data-next-category=\"${esc(category)}\">${esc(category)}</a><button data-next-category-toggle=\"${esc(category)}\" aria-label=\"${esc(category)} alt seçkilerini aç\" aria-expanded=\"false\">${icon('chevron')}</button></span>`).join('')}</nav>`;\r\n    const actions=`<nav class=\"next-actions\" aria-label=\"Hesap ve alışveriş\"><a href=\"#/account\" aria-label=\"Hesabım\">${icon('user')}<span>Hesabım</span></a><a href=\"#/favorites\" aria-label=\"Favorilerim\">${icon('heart')}<span class=\"count\" data-badge=\"favorite\" hidden>0</span></a><a href=\"#/cart\" aria-label=\"Sepetim\">${icon('bag')}<span class=\"next-cart-label\">Sepetim</span><span class=\"count\" data-badge=\"cart\" hidden>0</span></a></nav>`;\r\n    const menu=`<button class=\"next-menu\" data-action=\"category-menu\" aria-label=\"Kategorileri aç\">${icon('menu')}<span>Kategoriler</span></button>`;\r\n    return `<a href=\"#main-content\" class=\"skip-link\">İçeriğe atla</a><div class=\"next-announcement\"><span>${hostBridge?'Nova Store · Mağaza koleksiyonu':`${esc(T.name)} · Bağımsız tasarım demosu`}</span><button data-action=\"theme-library\">Tema koleksiyonu ${icon('arrow')}</button></div><button hidden class=\"compare-tray\" data-action=\"compare-open\">Karşılaştır</button><header class=\"site-header next-header next-header-${esc(T.nextSector)}\"><div class=\"next-header-grid next-container\">${menu}${brand}${search}${actions}${categories}</div></header><section id=\"next-category-panel\" class=\"next-category-panel\" aria-label=\"Kategori alt seçkileri\" hidden></section>`;\r\n  }\r\n  function nextCategories(){\r\n    return `<nav class=\"next-categories\" aria-label=\"Sektör kategorileri\">${T.cats.map((category,index)=>{const p=T.products.find(item=>item.category===category)||T.products[index];return `<a href=\"${routeLink('catalog',{category})}\"><span class=\"next-category-media\">${nextPhoto(p)}</span><strong>${esc(category)}</strong><span class=\"next-category-arrow\">${icon('arrow')}</span></a>`;}).join('')}</nav>`;\r\n  }\r\n  function nextGroups(){\r\n    if(hostBridge)return '';\r\n    const groups={paper:[['all','Tümü'],['school','Okula dönüş'],['study','Plan & not'],['creative','Yaratıcı işler'],['desk','Masa düzeni']],garage:[['all','Tümü'],['road','Yol hazırlığı'],['care','Bakım'],['interior','Araç içi']],voyage:[['all','Tüm yolculuklar'],['city','Şehirde bir gün'],['weekend','Hafta sonu'],['long','Uzun yolculuk']],flora:[['all','Tüm seçimler'],['bright','Aydınlık köşe'],['shade','Az ışıklı köşe'],['care','Bakımı tamamla']]}[T.nextSector];\r\n    return `<div class=\"next-groups\" role=\"group\" aria-label=\"${T.nextSector==='flora'?'Alanına göre keşfet':'Kullanımına göre keşfet'}\">${groups.map(([value,label])=>`<button data-next-group=\"${value}\" aria-pressed=\"${sectorNextState.group===value}\">${esc(label)}</button>`).join('')}</div>`;\r\n  }\r\n  function nextProducts(title){\r\n    const list=nextSelected();\r\n    return `<section class=\"next-products\" id=\"next-products\">${nextHeading(title)}${nextGroups()}<p class=\"next-result-count\" role=\"status\">${list.length} ürün ${sectorNextState.group==='all'?'koleksiyonda':'seçiminde'}</p>${list.length?productGrid(list):empty('Bu seçimde ürün bulunmuyor.','Diğer koleksiyonlara göz atabilirsin.','Kataloğu aç','#/catalog','search')}</section>`;\r\n  }\r\n  function nextGuide(){\r\n    if(hostBridge)return '';\r\n    const copy={paper:['LİSTEN HAZIR OLSUN','Birlikte tamamlanan\\nküçük hazırlıklar.','Ürün kartlarındaki “Listeme ekle” seçeneğiyle kendi okul veya masa listeni oluştur. Liste yalnızca bu sayfa açıkken tutulur.'],garage:['ÜRÜN SEÇİM REHBERİ','Ölç. Karşılaştır.\\nSonra yola çık.','Ürün ölçülerini ve bağlantı biçimini kendi aracınla karşılaştır. Bu demodaki seçimler gerçek araç uyumluluğunu doğrulamaz.'],voyage:['YOLCULUK REHBERİ','Az eşya.\\nDaha çok hareket.','Ürün ölçülerini karşılaştır, yanına alacaklarına göre hacim seç. Kabin bagajı kurallarını kendi havayolundan ayrıca doğrula.'],flora:['YAŞAYAN BİR KÖŞE','Alanını tanı.\\nYeşile yer aç.','Buradaki ışık ve bakım etiketleri temsili katalog bilgileridir. Canlı bitki seçerken satıcının tür ve bakım bilgilerini incele.']}[T.nextSector];\r\n    return `<section class=\"next-guide\"><div><span class=\"next-eyebrow\">${copy[0]}</span><h2>${copy[1]}</h2><p>${copy[2]}</p><button class=\"next-link-button\" data-next-guide>${T.nextSector==='paper'?'Listemi aç':'Seçim rehberini aç'} ${icon('arrow')}</button></div><div class=\"next-guide-photo\">${nextPhoto(T.products[T.nextSector==='voyage'?2:T.nextSector==='flora'?5:6]||T.products[0])}</div></section>`;\r\n  }\r\n  function sectorNextHome(){\r\n    const copy=`<span class=\"next-eyebrow\">${hostBridge?'NOVA STORE KOLEKSİYONU':esc(T.name).toLocaleUpperCase('tr-TR')}</span><h1>${esc(nextTitle())}</h1><p>${esc(nextSubtitle())}</p><a class=\"next-button\" href=\"#/catalog\">${esc(T.cta)} ${icon('arrow')}</a>`;\r\n    const media=`<div class=\"next-hero-media\">${nextHeroPhoto()}</div>`;\r\n    if(!T.products.length)return `<div class=\"next-container page\">${empty('Mağaza koleksiyonu hazırlanıyor.','Ürünler hazır olduğunda burada görünecek.','Kataloğu aç','#/catalog','box')}</div>`;\r\n    let hero;\r\n    if(T.nextSector==='paper')hero=`<section class=\"next-hero paper-hero\"><div class=\"paper-copy\">${copy}<span class=\"paper-footnote\">01 / FİKİRDEN İLK SAYFAYA</span></div>${media}<div class=\"paper-stamp\" aria-hidden=\"true\">Bir fikir<br>yeter.</div></section>${nextCategories()}${!hostBridge?`<section class=\"paper-list-bar\"><div>${icon('check')}<span><strong>Kendi hazırlık listeni oluştur</strong><small>Defter, kalem, çanta… Bir arada hatırla.</small></span></div><button class=\"next-button secondary\" data-next-list-open>Listem <span data-next-list-count>${sectorNextState.list.size}</span> ${icon('arrow')}</button></section>`:''}`;\r\n    else if(T.nextSector==='garage')hero=`<section class=\"next-hero garage-hero\">${media}<div class=\"garage-copy\">${copy}<div class=\"garage-ticks\"><span>${icon('check')}Kullanım odaklı seçim</span><span>${icon('check')}Açık ürün bilgileri</span></div></div></section>${!hostBridge?`<form id=\"next-garage-finder\" class=\"garage-finder\"><div><span class=\"next-eyebrow\">NEYE HAZIRLANIYORSUN?</span><h2>İhtiyacından başla.</h2></div><label>Kullanım alanı<select name=\"purpose\"><option value=\"all\">Tüm ihtiyaçlar</option value=\"road\" ${sectorNextState.group==='road'?'selected':''}>Yol hazırlığı</option><option value=\"care\" ${sectorNextState.group==='care'?'selected':''}>Araç bakımı</option><option value=\"interior\" ${sectorNextState.group==='interior'?'selected':''}>Araç içi ve düzen</option></select></label><button class=\"next-button\">Ürünleri bul ${icon('search')}</button><p>Örnek ürün rehberi · Araç modeli veya parça uyumluluğu doğrulanmaz.</p></form>`:''}${nextCategories()}`;\r\n    else if(T.nextSector==='voyage')hero=`<section class=\"next-hero voyage-hero\">${media}<div class=\"voyage-copy\">${copy}<span class=\"voyage-coordinate\">KOLEKSİYON 01 / YENİ ROTALAR</span></div><a class=\"voyage-ticket\" href=\"${productURL(T.products[0].id)}\"><span>YOL ARKADAŞIN</span><strong>${esc(T.products[0].name)}</strong><span>Yakından incele ${icon('arrow')}</span></a></section>${nextCategories()}`;\r\n    else hero=`<section class=\"next-hero flora-hero\"><div class=\"flora-copy\">${copy}<a class=\"flora-care-link\" href=\"#next-products\">Alanına göre keşfet ${icon('arrow')}</a></div>${media}<div class=\"flora-caption\"><span>YAVAŞLA, BÜYÜSÜN.</span><span>Nova Store / Yeşil koleksiyon</span></div></section>${nextCategories()}`;\r\n    const titles={paper:'Masanda yer aç.',garage:'İhtiyacın olan ekipmanlar.',voyage:'Rotana göre bir yol arkadaşı.',flora:'Sana iyi gelen yeşili bul.'};\r\n    return `<div class=\"next-container next-home next-home-${esc(T.nextSector)}\">${hero}${nextProducts(titles[T.nextSector])}${nextGuide()}</div>`;\r\n  }\r\n  function sectorNextProductCard(p){\r\n    const id=String(p.id),fav=state.favorites.includes(id),compared=comparedProducts.has(id),remaining=Math.max(0,p.stock-productInCart(id));\r\n    const needsSelection=p.variants.length>1||p.purchaseRequiresHostSelection;\r\n    const unavailable=remaining===0||!!(hostBridge&&p.purchaseRequiresHostSelection&&!p.canOpenProduct);\r\n    const buy=`<button class=\"add-button next-add\" data-action=\"quick-add\" data-id=\"${esc(id)}\" aria-label=\"${esc(p.name)}: ${needsSelection?'seçenekleri gör':'sepete ekle'}\" ${unavailable?'disabled':''}>${icon('bag')}<span>${remaining===0?'Tükendi':needsSelection?'Seçenekleri gör':'Sepete ekle'}</span></button>`;\r\n    const compare=`<button class=\"compare-button next-compare\" data-action=\"compare-toggle\" data-id=\"${esc(id)}\" aria-label=\"${esc(p.name)} karşılaştır\" aria-pressed=\"${compared}\">${icon('refresh')}</button>`;\r\n    const quick=`<button class=\"quick-view next-quick\" data-action=\"quick-view\" data-id=\"${esc(id)}\" aria-label=\"${esc(p.name)} hızlı görünüm\">${icon('search')}</button>`;\r\n    const favorite=`<button class=\"favorite-button next-favorite\" data-action=\"favorite\" data-id=\"${esc(id)}\" aria-label=\"${esc(p.name)}: ${fav?'favorilerden çıkar':'favorilere ekle'}\" aria-pressed=\"${fav}\">${icon('heart')}</button>`;\r\n    const discount=p.oldPrice>p.price?Math.round((1-p.price/p.oldPrice)*100):0;\r\n    const media=`<div class=\"next-card-media\"><a class=\"product-visual-link\" href=\"${productURL(id)}\" aria-label=\"${esc(p.name)} ürününü incele\"><div class=\"product-visual\">${nextPhoto(p)}</div></a>${favorite}${p.stock===0?'<span class=\"next-sale\">Tükendi</span>':discount?`<span class=\"next-sale\">−%${discount}</span>`:p.badge?`<span class=\"next-sale\">${esc(p.badge)}</span>`:''}${quick}</div>`;\r\n    const note=hostBridge?'Mağaza ürün bilgileri':p.nextNote||p.category;\r\n    const meta=`<div class=\"next-card-body\"><a class=\"next-card-category\" href=\"${routeLink('catalog',{category:p.category})}\">${esc(p.category)}</a><h3><a href=\"${productURL(id)}\">${esc(p.name)}</a></h3><p class=\"next-card-note\">${esc(note)}</p>${T.nextSector==='garage'?`<span class=\"next-sku\">KOD / ${esc(id)}</span>`:''}<div class=\"next-card-price\">${priceMarkup(p)}</div></div>`;\r\n    const extra=T.nextSector==='paper'&&!hostBridge?`<label class=\"next-school-check\"><input type=\"checkbox\" data-next-check=\"${esc(id)}\" ${sectorNextState.list.has(id)?'checked':''}><span>Listeme ekle</span></label>`:'';\r\n    return `<article class=\"product-card next-card next-card-${esc(T.nextSector)}\" data-product-id=\"${esc(id)}\" data-price=\"${p.price}\">${media}${meta}<div class=\"next-card-controls\">${buy}${compare}</div>${extra}</article>`;\r\n  }\r\n  function sectorNextFooter(){\r\n    const sentence={paper:'Güzel fikirler burada başlar.',garage:'Bir sonraki yolculuğa hazır.',voyage:'Bir sonraki güzel yolculuğa.',flora:'Yeşile biraz daha yer aç.'}[T.nextSector];\r\n    return `<footer class=\"site-footer next-footer next-footer-${esc(T.nextSector)}\"><div class=\"next-container\"><div class=\"next-footer-message\"><span class=\"next-eyebrow\">NOVA STORE</span><h2>${sentence}</h2><a href=\"#/catalog\">Keşfetmeye devam et ${icon('arrow')}</a></div><div class=\"next-footer-grid\"><div><a class=\"next-brand\" href=\"#/home\">Nova Store</a><p>${esc(T.tag)}</p><small>${hostBridge?'Mağaza koleksiyonu':'Bağımsız tasarım demosu · Temsili ürünler'}</small></div><nav aria-label=\"Alt kategori bağlantıları\"><h3>Koleksiyon</h3>${categoryLinks()}</nav><nav aria-label=\"Müşteri bağlantıları\"><h3>Yanındayız</h3><a href=\"#/account\">Hesabım</a><a href=\"#/orders\">${hostBridge?'Siparişlerim':'Demo siparişlerim'}</a><button data-action=\"delivery-info\">Teslimat ve iade</button><a href=\"#/help\">Yardım merkezi</a></nav></div><div class=\"next-footer-bottom\"><span>© 2026 Nova Store</span><button data-action=\"privacy-info\">${hostBridge?'Gizlilik bilgisi':'Demo ve gizlilik bilgisi'}</button><span>${hostBridge?'Son fiyat ve stok mağazada doğrulanır.':'Bu demoda gerçek ödeme alınmaz.'}</span></div></div></footer>`;\r\n  }\r\n  function nextOpenList(){\r\n    const list=T.products.filter(p=>sectorNextState.list.has(String(p.id)));\r\n    showDialog('Hazırlık listem',list.length?`<div class=\"next-list-dialog\">${list.map(p=>`<article>${nextPhoto(p)}<div><strong>${esc(p.name)}</strong>${priceMarkup(p)}<a href=\"${productURL(p.id)}\">Ürünü ve seçenekleri aç ${icon('arrow')}</a></div><button data-next-remove=\"${esc(p.id)}\" aria-label=\"${esc(p.name)} listeden çıkar\">${icon('close')}</button></article>`).join('')}<p>Bu liste yalnızca bu sayfa açıkken tutulur; sepeti değiştirmez.</p><button class=\"next-button secondary\" data-next-list-clear>Listeyi temizle</button></div>`:'<p>Ürün kartlarındaki “Listeme ekle” kutularını seçerek hazırlık listeni oluştur.</p>');\r\n  }\r\n  function enhanceSectorNext(){\r\n    if(!isSectorNext())return;\r\n    document.querySelectorAll('[data-next-list-count]').forEach(el=>el.textContent=sectorNextState.list.size);\r\n    document.querySelectorAll('[data-next-check]').forEach(el=>el.checked=sectorNextState.list.has(el.dataset.nextCheck));\r\n    document.querySelectorAll('.next-header a[href^=\"#/\"]').forEach(el=>{const active=el.getAttribute('href')===location.hash;el.toggleAttribute('aria-current',active);if(active)el.setAttribute('aria-current','page');});\r\n  }\r\n  const nextSubcategoryQueries={\r\n    paper:{'Defterler':[['A5 defterler','defter'],['Planlayıcılar','planlayıcı'],['Çizim blokları','çizim']],'Kalemler':[['Ahşap kalemler','ahşap'],['Pastel kalemler','pastel']],'Okul çantaları':[['Sırt çantaları','sırt']],'Masa düzeni':[['Kalemlikler','kalemlik'],['Düzenleyiciler','düzenleyici']]},\r\n    garage:{'Yol ekipmanı':[['Lastik ekipmanı','lastik'],['Aydınlatma','lambası'],['Takviye kabloları','takviye']],'Araç bakımı':[['Temizlik bezleri','bez'],['Eldivenler','eldiven']],'Araç içi':[['Telefon tutucular','telefon']],'Düzen ve koruma':[['Bagaj düzeni','bagaj'],['Paspaslar','paspas']]},\r\n    voyage:{'Valizler':[['Kabin boy','kabin'],['Büyük boy','büyük']],'Seyahat çantaları':[['Hafta sonu','hafta'],['Sırt çantaları','sırt']],'Düzenleyiciler':[['Valiz içi','set'],['Pasaport kılıfları','pasaport']],'Yol konforu':[['Boyun yastıkları','boyun'],['Bakım çantaları','bakım']]},\r\n    flora:{'Yeşil bitkiler':[['Monstera','monstera'],['Kauçuk','kauçuk'],['Eğrelti','eğrelti'],['Paşa kılıcı','paşa']],'Saksılar':[['Terracotta saksılar','terracotta']],'Bakım araçları':[['Sulama kapları','sulama'],['Sprey şişeleri','sprey']],'Toprak ve destek':[['Toprak karışımları','toprağı']]}\r\n  };\r\n  let nextCategoryOpener=null,nextCategoryTimer=null,nextSuppressCategoryFocus=false;\r\n  function nextCloseCategory(restore=false){\r\n    clearTimeout(nextCategoryTimer);const panel=document.getElementById('next-category-panel');if(panel)panel.hidden=true;\r\n    document.querySelectorAll('[data-next-category],[data-next-category-toggle]').forEach(el=>el.setAttribute('aria-expanded','false'));\r\n    if(restore&&nextCategoryOpener?.isConnected){nextSuppressCategoryFocus=true;nextCategoryOpener.focus();queueMicrotask(()=>nextSuppressCategoryFocus=false);}\r\n  }\r\n  function nextOpenCategory(opener){if(isApplicationSurface())return;\r\n    if(!isSectorNext())return;const category=opener.dataset.nextCategory||opener.dataset.nextCategoryToggle;\r\n    if(!T.cats.includes(category))return;clearTimeout(nextCategoryTimer);nextCategoryOpener=opener;\r\n    const panel=document.getElementById('next-category-panel');if(!panel)return;\r\n    const subset=T.products.filter(p=>p.category===category);\r\n    let links=hostBridge?[]:(nextSubcategoryQueries[T.nextSector]?.[category]||[]).map(([label,q])=>({label,url:routeLink('catalog',{category,q})}));\r\n    if(hostBridge){const categories=hostBridge.snapshot().categories||[],parent=categories.find(c=>c.name===category);links=categories.filter(c=>parent&&c.parentId===parent.id).map(c=>({label:c.name,url:routeLink('catalog',{category:c.name})}));}\r\n    panel.innerHTML=`<div class=\"next-category-links\"><span class=\"next-eyebrow\">${esc(category)}</span><h2>Alt seçkiler</h2><nav aria-label=\"${esc(category)} alt seçkileri\">${links.map(link=>`<a href=\"${link.url}\">${esc(link.label)} ${icon('arrow')}</a>`).join('')}<a href=\"${routeLink('catalog',{category})}\">Tüm ${esc(category)} ${icon('arrow')}</a></nav></div><div class=\"next-category-picks\"><span class=\"next-eyebrow\">BU KATEGORİDE</span>${subset.slice(0,3).map(p=>`<a href=\"${productURL(p.id)}\"><span class=\"next-category-pick-photo\">${nextPhoto(p)}</span><span><strong>${esc(p.name)}</strong><small>${money(p.price)}</small></span>${icon('arrow')}</a>`).join('')||'<p>Ürünler hazır olduğunda burada görünecek.</p>'}</div>`;\r\n    panel.hidden=false;document.querySelectorAll('[data-next-category],[data-next-category-toggle]').forEach(el=>el.setAttribute('aria-expanded',String((el.dataset.nextCategory||el.dataset.nextCategoryToggle)===category)));\r\n    opener.setAttribute('aria-controls','next-category-panel');\r\n    const frame=document.body.dataset.mode==='app'?document.body.getBoundingClientRect():{left:0,right:innerWidth,width:innerWidth};\r\n    const width=Math.min(760,frame.width-32),height=Math.min(400,innerHeight-48),rect=opener.getBoundingClientRect();\r\n    panel.style.width=width+'px';panel.style.maxHeight=height+'px';panel.style.left=Math.max(frame.left+16,Math.min(rect.left,frame.right-width-16))+'px';\r\n    const actual=Math.min(panel.scrollHeight,height);panel.style.top=(rect.bottom+8+actual<=innerHeight-16?rect.bottom+8:Math.max(16,rect.top-actual-8))+'px';\r\n  }\r\n  document.addEventListener('pointerover',event=>{if(!isSectorNext()||event.pointerType==='touch')return;const opener=event.target.closest('[data-next-category],[data-next-category-toggle]');if(opener)nextOpenCategory(opener);else if(event.target.closest('#next-category-panel'))clearTimeout(nextCategoryTimer);});\r\n  document.addEventListener('pointerout',event=>{if(!isSectorNext()||!event.target.closest('[data-next-category],[data-next-category-toggle],#next-category-panel'))return;if(event.relatedTarget?.closest?.('[data-next-category],[data-next-category-toggle],#next-category-panel'))return;nextCategoryTimer=setTimeout(()=>nextCloseCategory(),180);});\r\n  document.addEventListener('focusin',event=>{if(!isSectorNext()||nextSuppressCategoryFocus)return;const opener=event.target.closest('[data-next-category],[data-next-category-toggle]');if(opener)nextOpenCategory(opener);else if(!event.target.closest('#next-category-panel'))nextCloseCategory();});\r\n  document.addEventListener('pointerdown',event=>{if(isSectorNext()&&!event.target.closest('[data-next-category],[data-next-category-toggle],#next-category-panel'))nextCloseCategory();});\r\n  document.addEventListener('keydown',event=>{if(!isSectorNext())return;const panel=document.getElementById('next-category-panel');if(!panel||panel.hidden)return;if(event.key==='Escape'){event.preventDefault();nextCloseCategory(true);}else if(event.key==='ArrowDown'&&event.target.closest('[data-next-category],[data-next-category-toggle]')){event.preventDefault();panel.querySelector('a')?.focus();}});\r\n  document.addEventListener('click',event=>{if(!isSectorNext())return;const button=event.target.closest('[data-next-category-toggle]');if(button){event.preventDefault();nextOpenCategory(button);}else if(event.target.closest('#next-category-panel a'))nextCloseCategory();});\r\n  document.addEventListener('click',event=>{if(!isSectorNext())return;if(event.target.closest('.flora-care-link')){event.preventDefault();const section=document.getElementById('next-products');if(section){section.tabIndex=-1;section.focus({preventScroll:true});section.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});}}});\r\n  window.addEventListener('hashchange',()=>{if(isSectorNext())nextCloseCategory();});\r\n  document.addEventListener('change',event=>{\r\n    if(!isSectorNext()||hostBridge)return;\r\n    const input=event.target.closest('[data-next-check]');if(!input||!products.has(input.dataset.nextCheck))return;\r\n    input.checked?sectorNextState.list.add(input.dataset.nextCheck):sectorNextState.list.delete(input.dataset.nextCheck);enhanceSectorNext();\r\n  });\r\n  document.addEventListener('submit',event=>{\r\n    if(!isSectorNext()||hostBridge||event.target.id!=='next-garage-finder')return;\r\n    event.preventDefault();const value=new FormData(event.target).get('purpose');if(!['all','road','care','interior'].includes(value))return;\r\n    sectorNextState.group=value;renderKeepingPosition('#next-garage-finder');document.getElementById('next-products')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});\r\n  });\r\n  document.addEventListener('click',event=>{\r\n    if(!isSectorNext()||hostBridge)return;\r\n    const button=event.target.closest('[data-next-group],[data-next-list-open],[data-next-guide],[data-next-remove],[data-next-list-clear]');if(!button)return;\r\n    if(button.hasAttribute('data-next-group')){const group=button.dataset.nextGroup;if(!['all','school','study','creative','desk','road','care','interior','city','weekend','long','bright','shade'].includes(group))return;sectorNextState.group=group;renderKeepingPosition(`[data-next-group=\"${group}\"]`);enhanceSectorNext();}\r\n    else if(button.hasAttribute('data-next-remove')){sectorNextState.list.delete(button.dataset.nextRemove);nextOpenList();enhanceSectorNext();}\r\n    else if(button.hasAttribute('data-next-list-clear')){sectorNextState.list.clear();nextOpenList();enhanceSectorNext();}\r\n    else if(button.hasAttribute('data-next-list-open')||T.nextSector==='paper')nextOpenList();\r\n    else {const copy={garage:'Ürünün ölçülerini, bağlantı biçimini ve üretici kullanım bilgisini kontrol et. Bu demo bir araç veya OEM uyumluluk servisine bağlı değildir; seçim bir uygunluk garantisi vermez.',voyage:'Valizin dış ölçülerini kendi havayolunun güncel kabin bagajı kurallarıyla karşılaştır. Seyahat süresi etiketleri örnek seçim yardımıdır; gerçek bagaj kabulü doğrulanmaz.',flora:'Bitkinin türünü, bulunduğu alanın ışığını ve satıcının bakım bilgisini birlikte değerlendir. Buradaki bilgiler temsili ürün kartı verisidir; gerçek tür teşhisi veya bakım garantisi sunulmaz.'}[T.nextSector];showDialog('Seçim rehberi',`<p>${copy}</p><a class=\"next-button\" href=\"#/catalog\">Ürün bilgilerini karşılaştır ${icon('arrow')}</a>`);}\r\n  });\r\n\r\n// Inject into the shared renderer closure; call enhanceSectorCategoryHover() after each render.\r\n// Classic and the next-generation themes keep their own navigation controller.\r\nlet sectorCategoryController=null;\r\nfunction enhanceSectorCategoryHover(){\r\n  if(isApplicationSurface()||T.style==='classic'||(typeof isSectorNext==='function'&&isSectorNext()))return;\r\n  if(!sectorCategoryController)sectorCategoryController=createSectorCategoryController();\r\n  sectorCategoryController.refresh();\r\n}\r\nfunction createSectorCategoryController(){\r\n  const selector='.expansion-category-nav a[href],.abp-category-nav a[href],.site-header .header-collection a[href],.site-header .nav-row a[href],.visual-categories a[href],.coffee-filters a[href],.category-strip a[href]';\r\n  const popup=document.createElement('section');popup.id='sector-category-popover';popup.className='sector-category-popover';popup.hidden=true;popup.setAttribute('role','dialog');popup.setAttribute('aria-modal','false');popup.setAttribute('aria-label','Kategori seçkisi');document.body.append(popup);\r\n  let opener=null,timer=0,touchLink=null,ignoreFocus=false;\r\n  const categoryOf=link=>{if(!link?.matches?.(selector))return null;const href=link.getAttribute('href');if(!href?.startsWith('#/catalog'))return null;const value=new URLSearchParams(href.split('?')[1]||'').get('category');return Array.isArray(T.cats)&&T.cats.includes(value)?value:null;};\r\n  const candidate=target=>{const link=target?.closest?.(selector);return categoryOf(link)?link:null;};\r\n  const stop=()=>{clearTimeout(timer);timer=0;};\r\n  function close(restore=false){stop();const previous=opener;opener=null;popup.hidden=true;popup.replaceChildren();if(previous)previous.setAttribute('aria-expanded','false');if(restore&&previous?.isConnected){ignoreFocus=true;previous.focus({preventScroll:true});ignoreFocus=false;}}\r\n  const later=()=>{stop();timer=setTimeout(()=>close(false),240);};\r\n  function position(){if(!opener?.isConnected){close();return;}const r=opener.getBoundingClientRect(),margin=10,vw=document.documentElement.clientWidth,vh=innerHeight;\r\n    popup.style.width=Math.min(620,vw-margin*2)+'px';popup.style.maxHeight=Math.max(120,vh-margin*2)+'px';\r\n    const width=popup.offsetWidth,height=popup.offsetHeight,vertical=!!opener.closest('.tech-directory,.categories-list,.categories-editorial');\r\n    let left=r.left,top=r.bottom+6;\r\n    if(vertical&&vw>760&&(vw-r.right>=width+margin||r.left>=width+margin)){left=vw-r.right>=width+margin?r.right+6:r.left-width-6;top=r.top;}\r\n    else if(top+height>vh-margin&&r.top-height-6>=margin)top=r.top-height-6;\r\n    left=Math.max(margin,Math.min(left,vw-width-margin));top=Math.max(margin,Math.min(top,vh-height-margin));\r\n    popup.style.left=left+'px';popup.style.top=top+'px';\r\n  }\r\n  function open(link){const category=categoryOf(link);if(!category)return;stop();if(opener===link&&!popup.hidden)return;\r\n    if(opener)opener.setAttribute('aria-expanded','false');opener=link;opener.setAttribute('aria-expanded','true');\r\n    const matches=(Array.isArray(T.products)?T.products:[]).filter(p=>p.category===category),others=T.cats.filter(c=>c!==category);\r\n    popup.innerHTML=`<div class=\"sector-category-heading\"><div><span>KATEGORİ SEÇKİSİ</span><h2>${esc(category)}</h2></div><button type=\"button\" class=\"sector-category-close\" aria-label=\"Kategori seçkisini kapat\">${icon('close')}</button></div><div class=\"sector-category-columns\"><nav aria-label=\"Diğer kategoriler\"><h3>Diğer kategoriler</h3>${others.map(c=>`<a href=\"${routeLink('catalog',{category:c})}\">${esc(c)}${icon('chevron')}</a>`).join('')}<a class=\"sector-category-all\" href=\"#/catalog\">Tüm kategoriler ${icon('arrow')}</a></nav><div class=\"sector-category-picks\"><h3>${matches.length?'Bu kategoriden seçimler':'Kategorinin ürünleri'}</h3>${matches.length?matches.slice(0,3).map(p=>`<a class=\"sector-category-product\" href=\"${productURL(p.id)}\"><span class=\"sector-category-product-media\">${photo(p,'loading=\"eager\" decoding=\"async\"')}</span><span><strong>${esc(p.name)}</strong><small>${money(p.price)}</small></span>${icon('arrow')}</a>`).join(''):'<p class=\"sector-category-empty\">Bu kategoride henüz ürün bulunmuyor.</p>'}<a class=\"sector-category-more\" href=\"${routeLink('catalog',{category})}\">${esc(category)} · tümünü gör ${icon('arrow')}</a></div></div>`;\r\n    popup.hidden=false;position();\r\n  }\r\n  function refresh(){close();document.querySelectorAll(selector).forEach(link=>{if(!categoryOf(link))return;link.dataset.sectorCategoryTrigger='';link.setAttribute('aria-haspopup','dialog');link.setAttribute('aria-expanded','false');link.setAttribute('aria-controls',popup.id);});}\r\n  document.addEventListener('pointerover',event=>{if(event.pointerType==='touch')return;if(popup.contains(event.target)){stop();return;}const link=candidate(event.target);if(link)open(link);});\r\n  document.addEventListener('pointerout',event=>{if(!opener)return;if((opener.contains(event.target)||popup.contains(event.target))&&!opener.contains(event.relatedTarget)&&!popup.contains(event.relatedTarget))later();});\r\n  document.addEventListener('pointerdown',event=>{touchLink=event.pointerType==='touch'?candidate(event.target):null;if(!popup.hidden&&!popup.contains(event.target)&&!candidate(event.target))close();},true);\r\n  document.addEventListener('focusin',event=>{if(ignoreFocus)return;const link=candidate(event.target);if(link)open(link);else if(!popup.contains(event.target))close();});\r\n  document.addEventListener('click',event=>{if(event.target.closest('.sector-category-close')){event.preventDefault();close(true);return;}const link=candidate(event.target);if(link&&touchLink===link){event.preventDefault();event.stopImmediatePropagation();open(link);touchLink=null;return;}if(popup.contains(event.target)&&event.target.closest('a[href]'))close();},true);\r\n  document.addEventListener('keydown',event=>{\r\n    const link=candidate(event.target);if(link&&event.key==='ArrowDown'){event.preventDefault();open(link);popup.querySelector('button,a[href]')?.focus();return;}\r\n    if(popup.hidden)return;\r\n    if(event.key==='Escape'){event.preventDefault();event.stopPropagation();close(true);return;}\r\n    if(event.key==='Tab'&&event.target===opener){if(event.shiftKey){close();return;}event.preventDefault();popup.querySelector('button,a[href]')?.focus();}\r\n  });\r\n  window.addEventListener('resize',()=>{if(!popup.hidden)position();});\r\n  window.addEventListener('scroll',event=>{if(popup.hidden||popup.contains(event.target))return;const r=opener?.getBoundingClientRect();if(!r||r.bottom<0||r.top>innerHeight)close();else position();},true);\r\n  window.addEventListener('hashchange',()=>close());window.addEventListener('pagehide',()=>close());\r\n  return{refresh,close};\r\n}\r\n\r\n  // Campaigns reuse the current theme cards and the already scoped catalog.\r\n  window.NovaStoreThemeView=Object.freeze({renderProductCards(ids){\r\n    if(!Array.isArray(ids)||ids.length>24||ids.some(id=>typeof id!=='string'&&typeof id!=='number'))throw Error('En fazla 24 ürün seç.');\r\n    return [...new Set(ids.map(String))].map(id=>T.products.find(p=>String(p.id)===id)).filter(Boolean).map(p=>productCard(p)).join('');\r\n  },refresh(){enhanceInteractions();decorateHostedPage();}});\r\n// Nova Store theme expansion presentations. Inserted into the host controller closure.\r\n// These functions render only; cart, account, auth, routing, and persistence stay in core.\r\n\r\nfunction abpProducts() {\r\n  return Array.isArray(T && T.products) ? T.products.filter(Boolean) : [];\r\n}\r\n\r\nfunction abpCats() {\r\n  return Array.isArray(T && T.cats) ? T.cats.filter(Boolean) : [];\r\n}\r\n\r\nfunction abpPick(index) {\r\n  const items = abpProducts();\r\n  return items[index] || items[0] || null;\r\n}\r\n\r\nfunction abpId(product) {\r\n  return product && product.id != null ? String(product.id) : '';\r\n}\r\n\r\nfunction abpPhoto(product, extra) {\r\n  if (!product) return '<span class=\"expansion-missing-media\" aria-hidden=\"true\">Görsel bekleniyor</span>';\r\n  return photo(product, extra || 'loading=\"lazy\" decoding=\"async\"');\r\n}\r\n\r\nfunction abpHref(category) {\r\n  return routeLink('catalog', {category: category});\r\n}\r\n\r\nfunction abpEmpty(title, body) {\r\n  if (typeof empty === 'function') return empty(title, body, 'Kataloğu aç', '#/catalog', 'box');\r\n  return `<div class=\"expansion-empty\"><strong>${esc(title)}</strong><p>${esc(body)}</p><a href=\"#/catalog\">Kataloğu aç</a></div>`;\r\n}\r\n\r\nfunction abpIsFavorite(id) {\r\n  return !!(state && Array.isArray(state.favorites) && state.favorites.includes(id));\r\n}\r\n\r\nfunction abpIsCompared(id) {\r\n  return typeof comparedProducts !== 'undefined' && comparedProducts && typeof comparedProducts.has === 'function' && comparedProducts.has(id);\r\n}\r\n\r\nfunction abpCard(product, variant) {\r\n  if (!product) return '';\r\n  const id = abpId(product);\r\n  const fav = abpIsFavorite(id);\r\n  const compared = abpIsCompared(id);\r\n  const variants = Array.isArray(product.variants) ? product.variants : [];\r\n  const stock = Number(product.stock);\r\n  const unavailable = Number.isFinite(stock) && stock <= 0;\r\n  const selectionLabel = variants.length > 1 ? 'Seçenekleri gör' : 'Sepete ekle';\r\n  const discount = Number(product.oldPrice) > Number(product.price) ? Math.round((1 - Number(product.price) / Number(product.oldPrice)) * 100) : 0;\r\n  const visual = `<a class=\"product-visual-link\" href=\"${productURL(id)}\" aria-label=\"${esc(product.name || 'Ürün')} ürününü incele\"><div class=\"product-visual\">${abpPhoto(product)}${product.badge ? `<span class=\"product-badge\">${esc(product.badge)}</span>` : discount ? `<span class=\"product-badge\">−%${discount}</span>` : ''}</div></a>`;\r\n  const favorite = `<button type=\"button\" class=\"favorite-button\" data-action=\"favorite\" data-id=\"${esc(id)}\" aria-label=\"${esc(product.name || 'Ürün')}: ${fav ? 'favorilerden çıkar' : 'favorilere ekle'}\" aria-pressed=\"${fav}\">${icon('heart')}</button>`;\r\n  const quick = `<button type=\"button\" class=\"quick-view\" data-action=\"quick-view\" data-id=\"${esc(id)}\" aria-label=\"${esc(product.name || 'Ürün')} hızlı görünüm\">${icon('search')}</button>`;\r\n  const compare = `<button type=\"button\" class=\"compare-button\" data-action=\"compare-toggle\" data-id=\"${esc(id)}\" aria-label=\"${esc(product.name || 'Ürün')} karşılaştır\" aria-pressed=\"${compared}\">${icon('refresh')}</button>`;\r\n  const buy = `<button type=\"button\" class=\"add-button\" data-action=\"quick-add\" data-id=\"${esc(id)}\" aria-label=\"${esc(product.name || 'Ürün')}: ${selectionLabel.toLocaleLowerCase('tr-TR')}\" ${unavailable ? 'disabled' : ''}>${icon('bag')}<span>${unavailable ? 'Stokta yok' : selectionLabel}</span></button>`;\r\n  const category = product.category || 'Nova Store seçkisi';\r\n  const rating = Number(product.rating);\r\n  const ratingMarkup = Number.isFinite(rating) ? `<span class=\"card-rating\">${icon('star')}${rating.toFixed(1)}</span>` : '';\r\n  const note = variant === 'bento' ? (product.description || product.details?.[0]?.[1] || 'Günlük kullanım için seçildi.') : variant === 'pantry' ? (product.unit || product.details?.[0]?.[1] || 'Sepete eklemek için hazır.') : (product.seller || 'Nova Store seçkisi');\r\n  return `<article class=\"product-card expansion-card expansion-card-${esc(variant || 'agora')}\" data-product-id=\"${esc(id)}\" data-price=\"${esc(product.price == null ? '' : product.price)}\">${visual}<div class=\"expansion-card-tools\">${favorite}${quick}</div><div class=\"product-meta\"><a class=\"card-category\" href=\"${abpHref(category)}\">${esc(category)}</a><h3><a href=\"${productURL(id)}\">${esc(product.name || 'Ürün')}</a></h3><p class=\"card-note\">${esc(note)}</p>${ratingMarkup}<div class=\"product-bottom\">${priceMarkup(product)}${buy}</div></div><div class=\"card-compare\">${compare}</div></article>`;\r\n}\r\n\r\nfunction abpCategoryNav(className) {\r\n  const cats = abpCats();\r\n  if (!cats.length) return '<span class=\"expansion-no-categories\">Kategoriler hazırlanıyor</span>';\r\n  return cats.map(function(category) {\r\n    return `<a href=\"${abpHref(category)}\">${esc(category)}</a>`;\r\n  }).join('');\r\n}\r\n\r\nfunction abpHeaderBase(theme, label, searchPlaceholder, className) {\r\n  return `<a href=\"#main-content\" class=\"skip-link\">İçeriğe atla</a><div class=\"expansion-ribbon\"><span>Nova Store · ${esc(label)}</span><button type=\"button\" data-action=\"theme-library\">Tema koleksiyonuna dön ${icon('arrow')}</button></div><header class=\"site-header expansion-header ${className || ''}\"><div class=\"expansion-header-top\"><a class=\"expansion-brand\" href=\"#/home\" aria-label=\"Nova Store ana sayfa\">Nova Store<small>iyi seçimler, tek yerde</small></a><form id=\"search-form\" class=\"search-form\" role=\"search\"><label class=\"sr-only\" for=\"search-input\">Ürün veya kategori ara</label><input id=\"search-input\" name=\"q\" type=\"search\" maxlength=\"100\" autocomplete=\"off\" placeholder=\"${esc(searchPlaceholder)}\" required><button type=\"submit\" aria-label=\"Ara\">${icon('search')}</button></form><nav class=\"expansion-actions\" aria-label=\"Hesap ve alışveriş\"><a href=\"#/account\" aria-label=\"Hesabım\">${icon('user')}<span>Hesabım</span></a><a href=\"#/favorites\" aria-label=\"Favorilerim\">${icon('heart')}<span class=\"count\" data-badge=\"favorite\" hidden>0</span></a><a href=\"#/cart\" aria-label=\"Sepetim\">${icon('bag')}<span>Sepetim</span><span class=\"count\" data-badge=\"cart\" hidden>0</span></a></nav></div><nav class=\"expansion-nav\" aria-label=\"Kategoriler\">${abpCategoryNav()}</nav></header><button type=\"button\" hidden class=\"compare-tray\" data-action=\"compare-open\">Karşılaştır</button>`;\r\n}\r\n\r\nfunction abpHeroImage(product, alt) {\r\n  if (hostBridge || !T.heroImage) return abpPhoto(product, 'loading=\"eager\" fetchpriority=\"high\"');\r\n  return `<img src=\"${esc(T.heroImage)}\" alt=\"${esc(alt)}\" fetchpriority=\"high\">`;\r\n}\r\n\r\nfunction expansionAgoraHeader() {\r\n  return abpHeaderBase('20-nova-agora', 'Agora · çok kategorili pazar', 'Ürün, kategori veya marka ara', 'agora-header');\r\n}\r\n\r\nfunction expansionAgoraCard(product) {\r\n  return abpCard(product, 'agora');\r\n}\r\n\r\nfunction expansionAgoraHome() {\r\n  const products = abpProducts();\r\n  if (!products.length) return `<div class=\"expansion-main agora-main\"><div class=\"expansion-container\">${abpEmpty('Mağaza seçkisi hazırlanıyor.', 'Ürünler yayınlandığında fırsatlar ve kampanyalar burada görünecek.')}</div></div>`;\r\n  const lead = abpPick(0), side = abpPick(1), third = abpPick(2), fourth = abpPick(3);\r\n  const cards = products.slice(0, 4).map(expansionAgoraCard).join('');\r\n  const deal = function(product, eyebrow) {\r\n    return product ? `<a class=\"agora-deal\" href=\"${productURL(abpId(product))}\"><span>${esc(eyebrow)}</span><strong>${esc(product.name || 'Seçili ürün')}</strong>${abpPhoto(product)}${priceMarkup(product)}<em>İncele ${icon('arrow')}</em></a>` : '';\r\n  };\r\n  const campaign = function(product, title, copy, category) {\r\n    return product ? `<a class=\"agora-campaign\" href=\"${abpHref(category || product.category || '')}\"><div><span class=\"agora-overline\">${esc(category || 'NOVA STORE')}</span><h3>${esc(title)}</h3><p>${esc(copy)}</p><span>Seçkiyi aç ${icon('arrow')}</span></div>${abpPhoto(product)}</a>` : '';\r\n  };\r\n  return `<div class=\"expansion-main agora-main\"><div class=\"expansion-container\"><section class=\"agora-hero\"><div class=\"agora-hero-copy\"><span class=\"agora-overline\">NOVA STORE / BUGÜNÜN PAZARI</span><h1>${esc((T && T.hero) || 'Aradığın güzel seçimler burada.')}</h1><p>${esc((T && T.sub) || 'Ev, teknoloji, bakım ve günlük ihtiyaçlar için seçilmiş ürünleri tek akışta keşfet.')}</p><div class=\"agora-hero-actions\"><a class=\"agora-button\" href=\"#/catalog\">Alışverişe başla ${icon('arrow')}</a><a class=\"agora-text-link\" href=\"#agora-deals\">Günün fırsatları</a></div><div class=\"agora-proof-points\"><span>${icon('check')} Doğrulanabilir ürün bilgisi</span><span>${icon('check')} Güvenli mağaza akışı</span></div></div><div class=\"agora-hero-media\">${abpHeroImage(lead, 'Nova Store Agora seçkisi')}</div></section><section class=\"agora-deal-rail\" id=\"agora-deals\" aria-label=\"Günün fırsatları\">${deal(lead, 'ÖNE ÇIKAN')}${deal(side, 'HAFTANIN SEÇİMİ')}${deal(third, 'SEPETE EKLE')}</section><section class=\"agora-campaign-board\" aria-labelledby=\"agora-board-title\"><div class=\"agora-section-head\"><div><span class=\"agora-overline\">KATEGORİDEN KATEGORİYE</span><h2 id=\"agora-board-title\">Bugün neye yer açıyorsun?</h2></div><a href=\"#/catalog\">Tüm kategoriler ${icon('arrow')}</a></div><div class=\"agora-bento\">${campaign(side, 'Çalışma alanını yenile.', 'Küçük dokunuşlarla daha akışkan bir gün.', side && side.category)}${campaign(third, 'Evde iyi hissettirenler.', 'İşlevi güzel detaylarla birleştiren seçimler.', third && third.category)}${campaign(fourth, 'Yeni bir favori bul.', 'Nova Store seçkilerinden sana yakın parçalar.', fourth && fourth.category)}</div></section><section class=\"agora-shelf\" aria-labelledby=\"agora-shelf-title\"><div class=\"agora-section-head\"><div><span class=\"agora-overline\">NOVA STORE SEÇKİSİ</span><h2 id=\"agora-shelf-title\">Kısa listene ekle</h2></div><a href=\"#/catalog\">Daha fazlasını gör ${icon('arrow')}</a></div><div class=\"agora-grid\">${cards}</div></section></div></div>`;\r\n}\r\n\r\nfunction expansionAgoraFooter() {\r\n  return `<footer class=\"site-footer expansion-footer agora-footer\"><div class=\"expansion-container\"><section class=\"agora-footer-cta\"><span class=\"agora-overline\">NOVA STORE</span><h2>İyi seçimler, günün akışına karışır.</h2><a class=\"agora-button\" href=\"#/catalog\">Koleksiyona dön ${icon('arrow')}</a></section><div class=\"expansion-footer-grid\"><div><a class=\"expansion-brand\" href=\"#/home\">Nova Store</a><p>Farklı ihtiyaçlar, ortak bir alışveriş deneyimi.</p></div><nav aria-label=\"Agora kategorileri\"><h3>Kategoriler</h3>${abpCategoryNav('agora-footer-links')}</nav><nav aria-label=\"Nova Store destek\"><h3>Yanındayız</h3><a href=\"#/help\">Yardım merkezi</a><a href=\"#/orders\">Siparişlerim</a><button type=\"button\" data-action=\"delivery-info\">Teslimat ve iade</button></nav></div><div class=\"expansion-footer-bottom\"><span>© 2026 Nova Store</span><button type=\"button\" data-action=\"privacy-info\">Gizlilik ve demo bilgisi</button><span>Son fiyat ve stok mağazada doğrulanır.</span></div></div></footer>`;\r\n}\r\n\r\nfunction expansionBentoHeader() {\r\n  return abpHeaderBase('21-nova-bento', 'Bento · teknoloji çalışma alanı', 'Ürün adı, özellik veya kategori ara', 'bento-header');\r\n}\r\n\r\nfunction expansionBentoCard(product) {\r\n  return abpCard(product, 'bento');\r\n}\r\n\r\nfunction expansionBentoHome() {\r\n  const products = abpProducts();\r\n  if (!products.length) return `<div class=\"expansion-main bento-main\"><div class=\"expansion-container\">${abpEmpty('Çalışma alanı hazırlanıyor.', 'Teknoloji ürünleri yayınlandığında özellikleri burada karşılaştırabilirsin.')}</div></div>`;\r\n  const lead = abpPick(0), side = abpPick(1), third = abpPick(2), fourth = abpPick(3);\r\n  const spec = function(product, label, value) {\r\n    return product ? `<a class=\"bento-module\" href=\"${productURL(abpId(product))}\"><span class=\"bento-index\">${esc(label)}</span><strong>${esc(value)}</strong><small>${esc(product.name || 'Ürün')} · teknik seçki</small>${abpPhoto(product)}</a>` : '';\r\n  };\r\n  return `<div class=\"expansion-main bento-main\"><div class=\"expansion-container\"><section class=\"bento-hero\"><div class=\"bento-hero-panel\"><span class=\"bento-overline\">NOVA STORE / WORKSPACE 21</span><h1>${esc((T && T.hero) || 'Daha iyi çalışan bir masa.')}</h1><p>${esc((T && T.sub) || 'Performans, bağlantı ve düzen için ihtiyaç duyduğun parçaları özellikleriyle birlikte seç.')}</p><a class=\"bento-button\" href=\"#/catalog\">Teknolojiyi keşfet ${icon('arrow')}</a><div class=\"bento-status\"><span></span><strong>Hazır akış</strong><small>Ürün özelliklerini yan yana incele</small></div></div><div class=\"bento-hero-product\">${abpHeroImage(lead, 'Nova Store Bento teknoloji seçkisi')}<div class=\"bento-hero-label\"><span>01 / ÖNE ÇIKAN</span><strong>${esc(lead.name || 'Teknoloji seçkisi')}</strong>${priceMarkup(lead)}</div></div></section><section class=\"bento-modules\" aria-label=\"Teknoloji modülleri\"><div class=\"bento-module-intro\"><span class=\"bento-overline\">SEÇİM PANELİ</span><h2>İhtiyacın kadar teknik.</h2><p>Gürültüyü azaltan, karar vermeyi kolaylaştıran özellik satırları.</p></div>${spec(side, '02', side && (side.details?.[0]?.[1] || 'Günlük performans'))}${spec(third, '03', third && (third.details?.[1]?.[1] || 'Bağlantı hazır'))}${spec(fourth, '04', fourth && (fourth.details?.[0]?.[1] || 'Masa düzeni'))}</section><section class=\"bento-spec-shelf\" aria-labelledby=\"bento-spec-title\"><div class=\"bento-section-head\"><div><span class=\"bento-overline\">ÜRÜN LABORATUVARI</span><h2 id=\"bento-spec-title\">Özellikleriyle seç.</h2></div><a href=\"#/catalog\">Tüm teknoloji ${icon('arrow')}</a></div><div class=\"bento-product-list\">${products.slice(0, 4).map(expansionBentoCard).join('')}</div></section></div></div>`;\r\n}\r\n\r\nfunction expansionBentoFooter() {\r\n  return `<footer class=\"site-footer expansion-footer bento-footer\"><div class=\"expansion-container\"><section class=\"bento-footer-cta\"><div><span class=\"bento-overline\">NOVA STORE / SONRAKİ ADIM</span><h2>Masanın iyi çalışsın.</h2><p>İhtiyacına göre filtrele, detayları karşılaştır, seçimini netleştir.</p></div><a class=\"bento-button\" href=\"#/catalog\">Ürünleri karşılaştır ${icon('arrow')}</a></section><div class=\"expansion-footer-grid\"><div><a class=\"expansion-brand\" href=\"#/home\">Nova Store</a><p>Teknolojiyi daha anlaşılır seç.</p></div><nav aria-label=\"Bento kategorileri\"><h3>Çalışma alanı</h3>${abpCategoryNav('bento-footer-links')}</nav><nav aria-label=\"Nova Store destek\"><h3>Destek</h3><a href=\"#/help\">Ürün rehberi</a><a href=\"#/account\">Hesabım</a><button type=\"button\" data-action=\"delivery-info\">Teslimat bilgileri</button></nav></div><div class=\"expansion-footer-bottom\"><span>© 2026 Nova Store</span><button type=\"button\" data-action=\"privacy-info\">Gizlilik ve demo bilgisi</button><span>Son fiyat ve stok mağazada doğrulanır.</span></div></div></footer>`;\r\n}\r\n\r\nfunction expansionPantryHeader() {\r\n  return abpHeaderBase('22-nova-pantry', 'Pantry · tariften sepete', 'Malzeme, kategori veya tarif ara', 'pantry-header');\r\n}\r\n\r\nfunction expansionPantryCard(product) {\r\n  return abpCard(product, 'pantry');\r\n}\r\n\r\nfunction abpPantryHomeRaw() {\r\n  const products = abpProducts();\r\n  if (!products.length) return `<div class=\"expansion-main pantry-main\"><div class=\"expansion-container\">${abpEmpty('Kiler seçkisi hazırlanıyor.', 'Ürünler yayınlandığında tariflerini ve alışveriş listenizi burada kurabilirsin.')}</div></div>`;\r\n  const lead = abpPick(0), side = abpPick(1), third = abpPick(2), fourth = abpPick(3);\r\n  const categoryTabs = abpCats().slice(0, 6).map(function(category, index) {\r\n    return `<a class=\"pantry-tab${index === 0 ? ' is-active' : ''}\" href=\"${abpHref(category)}\">${esc(category)}</a>`;\r\n  }).join('');\r\n  const recipe = function(product, label, title, copy) {\r\n    return product ? `<a class=\"pantry-recipe\" href=\"${productURL(abpId(product))}\"><div><span class=\"pantry-overline\">${esc(label)}</span><h3>${esc(title)}</h3><p>${esc(copy)}</p><span>Sepete ekle ${icon('arrow')}</span></div>${abpPhoto(product)}</a>` : '';\r\n  };\r\n  const checklist = products.slice(0, 3).map(function(product, index) {\r\n    return `<li><span class=\"pantry-check\">${index + 1}</span><span><strong>${esc(product.name || 'Ürün')}</strong><small>${esc(product.category || 'Nova Store mutfağı')}</small></span>${priceMarkup(product)}</li>`;\r\n  }).join('');\r\n  return `<section class=\"expansion-main pantry-main\"><div class=\"expansion-container\"><section class=\"pantry-hero\"><div class=\"pantry-hero-copy\"><span class=\"pantry-overline\">NOVA STORE / PANTRY 22</span><h1>${esc((T && T.hero) || 'Tarifini kur, sepetini tamamla.')}</h1><p>${esc((T && T.sub) || 'Günün mutfağı için taze seçimleri, kolay tarif fikirleri ve düzenli bir alışveriş akışında buluştur.')}</p><a class=\"pantry-button\" href=\"#/catalog\">Alışveriş listeni aç ${icon('arrow')}</a><div class=\"pantry-tabs\" role=\"tablist\" aria-label=\"Kiler kategorileri\">${categoryTabs || '<span>Kategoriler hazırlanıyor</span>'}</div></div><div class=\"pantry-checklist\"><div class=\"pantry-list-heading\"><span>BUGÜNÜN LİSTESİ</span><strong>Mutfağa iyi başlangıç</strong></div><ul>${checklist}</ul><a href=\"#/cart\">Sepetimi gör ${icon('arrow')}</a></div></section><section class=\"pantry-recipe-board\" aria-labelledby=\"pantry-board-title\"><div class=\"pantry-section-head\"><div><span class=\"pantry-overline\">TARİFE GÖRE KEŞFET</span><h2 id=\"pantry-board-title\">Bir akşam yemeği fikri.</h2></div><a href=\"#/catalog\">Tüm mutfak seçkisi ${icon('arrow')}</a></div><div class=\"pantry-recipes\">${recipe(side, '15 DAKİKADA', 'Tavada hızlı bir akşam.', 'Az malzeme, bol lezzet; temel mutfak seçkisiyle başla.')}${recipe(third, 'HAFTA SONU', 'Sofraya biraz renk.', 'Paylaşmalık ürünleri tek sepette topla.')}${recipe(fourth, 'KİLERİ DOLDUR', 'Her gün kullanılanlar.', 'Kahvaltıdan hazırlığa, eksikleri tamamla.')}</div></section><section class=\"pantry-basket-shelf\" aria-labelledby=\"pantry-shelf-title\"><div class=\"pantry-section-head\"><div><span class=\"pantry-overline\">SEPET ODAKLI SEÇKİ</span><h2 id=\"pantry-shelf-title\">Alışverişe hazır.</h2></div><a href=\"#/catalog\">Daha fazlasını gör ${icon('arrow')}</a></div><div class=\"pantry-product-list\">${products.slice(0, 4).map(expansionPantryCard).join('')}</div></section></div></section>`;\r\n}\r\n\r\nfunction expansionPantryHome() {\r\n  return abpPantryHomeRaw().replace('<section', '<div').replace('</section>', '</div>');\r\n}\r\n\r\nfunction expansionPantryFooter() {\r\n  return `<footer class=\"site-footer expansion-footer pantry-footer\"><div class=\"expansion-container\"><section class=\"pantry-footer-cta\"><span class=\"pantry-overline\">NOVA STORE / MUTFAKTA</span><h2>Bugünün sepeti, yarının tarifine dönüşür.</h2><a class=\"pantry-button\" href=\"#/catalog\">Kileri keşfet ${icon('arrow')}</a></section><div class=\"expansion-footer-grid\"><div><a class=\"expansion-brand\" href=\"#/home\">Nova Store</a><p>Tarif, alışveriş ve iyi seçimler.</p></div><nav aria-label=\"Pantry kategorileri\"><h3>Kiler</h3>${abpCategoryNav('pantry-footer-links')}</nav><nav aria-label=\"Nova Store destek\"><h3>Yanındayız</h3><a href=\"#/help\">Alışveriş rehberi</a><a href=\"#/orders\">Siparişlerim</a><button type=\"button\" data-action=\"delivery-info\">Teslimat bilgileri</button></nav></div><div class=\"expansion-footer-bottom\"><span>© 2026 Nova Store</span><button type=\"button\" data-action=\"privacy-info\">Gizlilik ve demo bilgisi</button><span>Son fiyat ve stok mağazada doğrulanır.</span></div></div></footer>`;\r\n}\r\n\r\n/*\r\n * Candidate presentation functions for the three 2026 expansion themes.\r\n *\r\n * This file is intentionally a plain source fragment. The integration step\r\n * injects these declarations inside shared/core.js, where T, hostBridge,\r\n * state, esc, icon, photo, priceMarkup, productURL, routeLink, productGrid\r\n * and empty already exist. No commerce state or transport is defined here.\r\n */\r\n\r\nfunction amsProducts() {\r\n  return Array.isArray(T?.products) ? T.products.filter(Boolean) : [];\r\n}\r\n\r\nfunction amsCategories() {\r\n  return Array.isArray(T?.cats) ? T.cats.filter(value => typeof value === 'string' && value.trim()) : [];\r\n}\r\n\r\nfunction amsProductCard(product, variant = 'archive') {\r\n  if (!product) return '';\r\n  const favorite = Array.isArray(state?.favorites) && state.favorites.includes(product.id);\r\n  const unavailable = product.stock === 0 || Boolean(hostBridge && product.purchaseRequiresHostSelection && !product.canOpenProduct);\r\n  const choice = product.purchaseRequiresHostSelection || (Array.isArray(product.variants) && product.variants.length > 1);\r\n  const label = unavailable ? 'Stokta yok' : choice ? 'Seçenekleri gör' : 'Sepete ekle';\r\n  const image = photo(product, 'loading=\"lazy\" decoding=\"async\"');\r\n  return `<article class=\"product-card expansion-card expansion-card-${variant}\" data-product-id=\"${esc(product.id)}\" data-price=\"${product.price}\">\r\n    <div class=\"expansion-card-media\"><a class=\"product-visual-link\" href=\"${productURL(product.id)}\" aria-label=\"${esc(product.name)} ürününü incele\">${image}</a>${product.badge ? `<span class=\"product-badge\">${esc(product.badge)}</span>` : ''}<button type=\"button\" class=\"favorite-button\" data-action=\"favorite\" data-id=\"${esc(product.id)}\" aria-label=\"${esc(product.name)}: ${favorite ? 'favorilerden çıkar' : 'favorilere ekle'}\" aria-pressed=\"${favorite}\">${icon('heart')}</button></div>\r\n    <div class=\"expansion-card-body\"><div class=\"expansion-card-kicker\"><span>${esc(product.category || '')}</span>${product.rating ? `<span>${icon('star')} ${Number(product.rating).toFixed(1)}</span>` : ''}</div><h3><a href=\"${productURL(product.id)}\">${esc(product.name)}</a></h3>${product.description ? `<p>${esc(product.description)}</p>` : ''}<div class=\"expansion-card-bottom\">${priceMarkup(product)}<button type=\"button\" class=\"add-button\" data-action=\"quick-add\" data-id=\"${esc(product.id)}\" aria-label=\"${esc(product.name)}: ${label.toLocaleLowerCase('tr-TR')}\" ${unavailable ? 'disabled' : ''}>${icon(unavailable ? 'close' : 'bag')}<span>${label}</span></button></div></div>\r\n    <button type=\"button\" class=\"quick-view\" data-action=\"quick-view\" data-id=\"${esc(product.id)}\" aria-label=\"${esc(product.name)} hızlı görünüm\">${icon('search')}</button><button type=\"button\" class=\"expansion-compare\" data-action=\"compare-toggle\" data-id=\"${esc(product.id)}\" aria-label=\"${esc(product.name)} karşılaştır\">${icon('refresh')}</button>\r\n  </article>`;\r\n}\r\n\r\nfunction amsHeroImage(className, alt) {\r\n  const products = amsProducts();\r\n  if (hostBridge) return products[0] ? photo(products[0], `class=\"${className}\" loading=\"eager\" fetchpriority=\"high\"`) : '<div class=\"expansion-hero-empty\" role=\"img\" aria-label=\"Mağazada henüz ürün görseli yok\">Ürün görseli bekleniyor</div>';\r\n  if (T?.heroImage) return `<img class=\"${className}\" src=\"${esc(T.heroImage)}\" alt=\"${esc(alt)}\" loading=\"eager\" fetchpriority=\"high\">`;\r\n  return products[0] ? photo(products[0], `class=\"${className}\" loading=\"eager\" fetchpriority=\"high\"`) : '<div class=\"expansion-hero-empty\" role=\"img\" aria-label=\"Henüz ürün görseli yok\">Koleksiyon hazırlanıyor</div>';\r\n}\r\n\r\nfunction amsHeaderBase(className, eyebrow) {\r\n  const categories = amsCategories();\r\n  return `<a class=\"skip-link\" href=\"#main-content\">İçeriğe atla</a><div class=\"expansion-ribbon\"><span>${esc(hostBridge ? 'Nova Store · Mağaza' : (T?.tag || 'Nova Store koleksiyonu'))}</span><span>${esc(eyebrow)}</span></div><header class=\"expansion-header ${className}\"><div class=\"expansion-header-main\"><a class=\"expansion-menu\" href=\"#/catalog\" aria-label=\"Kategorileri aç\">${icon('menu')}</a><a class=\"expansion-brand\" href=\"#/home\" aria-label=\"Nova Store ana sayfa\">Nova Store</a><form id=\"search-form\" class=\"search-form expansion-search\" role=\"search\"><label class=\"sr-only\" for=\"search-input\">Ürün veya kategori ara</label><input id=\"search-input\" name=\"q\" type=\"search\" maxlength=\"100\" autocomplete=\"off\" placeholder=\"${esc(hostBridge ? 'Mağazada ara' : 'Ürün, kategori veya koleksiyon ara')}\"><button type=\"submit\" aria-label=\"Ara\">${icon('search')}</button></form><nav class=\"expansion-header-actions\" aria-label=\"Hesap ve alışveriş\"><a class=\"header-action\" href=\"#/account\" aria-label=\"Hesabım\">${icon('user')}</a><a class=\"header-action\" href=\"#/favorites\" aria-label=\"Favorilerim\">${icon('heart')}<span class=\"count\" data-badge=\"favorite\" hidden>0</span></a><a class=\"header-action\" href=\"#/cart\" aria-label=\"Sepetim\">${icon('bag')}<span class=\"count\" data-badge=\"cart\" hidden>0</span></a><button type=\"button\" class=\"header-action\" data-action=\"compare-open\" aria-label=\"Ürünleri karşılaştır\">${icon('refresh')}</button></nav></div><nav class=\"expansion-category-nav\" aria-label=\"Koleksiyon gezinmesi\"><a href=\"#/catalog\">Tüm ürünler</a>${categories.map(category => `<a href=\"${routeLink('catalog', {category})}\">${esc(category)}</a>`).join('')}</nav></header>`;\r\n}\r\n\r\nfunction expansionArchiveHeader() {\r\n  return amsHeaderBase('expansion-header-archive', 'ARŞİV / SEÇİLİ NESNELER');\r\n}\r\n\r\nfunction expansionMonogramHeader() {\r\n  return amsHeaderBase('expansion-header-monogram', 'MONOGRAM / SESSİZ İMZA');\r\n}\r\n\r\nfunction expansionSoundHeader() {\r\n  return amsHeaderBase('expansion-header-sound', 'SOUND / STÜDYO EKİPMANI');\r\n}\r\n\r\nfunction expansionArchiveHome() {\r\n  const products = amsProducts();\r\n  if (!products.length) return `<div class=\"expansion-empty expansion-empty-archive\">${empty('Henüz ürün bulunmuyor.', 'Mağaza ürünleri hazır olduğunda arşiv burada görünecek.', 'Koleksiyonu aç', '#/catalog', 'book')}</div>`;\r\n  const rows = products.slice(0, 6).map((product, index) => `<a class=\"archive-numbered-row\" href=\"${productURL(product.id)}\"><span class=\"archive-number\">${String(index + 1).padStart(2, '0')}</span><span class=\"archive-row-image\">${photo(product, 'loading=\"lazy\"')}</span><span class=\"archive-row-copy\"><small>${esc(product.category || '')}</small><strong>${esc(product.name)}</strong><span>${esc(product.badge || 'Nova Store arşivi')}</span></span>${priceMarkup(product)}${icon('arrow')}</a>`).join('');\r\n  return `<section class=\"expansion-home expansion-home-archive\"><section class=\"archive-hero\"><div class=\"archive-hero-copy\"><span class=\"expansion-eyebrow\">${esc(T?.eyebrow || 'NOVA STORE / YENİ KAYIT')}</span><h1>${esc(T?.hero || 'Yeni bir sayfa.\\nYeni bir nesne.')}</h1><p>${esc(T?.sub || 'Dikkatle seçilmiş ürünler, açık bir arşiv düzeninde.')}</p><a class=\"expansion-primary-button\" href=\"#/catalog\">${esc(T?.cta || 'Arşivi gez')} ${icon('arrow')}</a><div class=\"archive-fact-list\"><span><b>${products.length}</b> kayıt</span><span><b>${amsCategories().length}</b> koleksiyon</span><span>${hostBridge ? 'Mağaza kataloğu' : 'Temsili seçki'}</span></div></div><div class=\"archive-hero-art\">${amsHeroImage('archive-hero-image', T?.name || 'Nova Store arşiv görseli')}<span class=\"archive-stamp\">NOVA<br>STORE<br><em>01</em></span></div></section><section class=\"archive-index\"><header><span class=\"expansion-eyebrow\">İÇİNDEKİLER</span><h2>Arşivde öne çıkanlar</h2><a href=\"#/catalog\">Tümünü gör ${icon('arrow')}</a></header><div class=\"archive-numbered-list\">${rows}</div></section><section class=\"archive-featured\"><div><span class=\"expansion-eyebrow\">KAYIT NOTU</span><h2>${esc(T?.tag || 'Her gün kullanılan iyi bir ayrıntı.')}</h2><p>${esc(T?.desc || 'Nova Store seçkisini ürün bilgileriyle birlikte incele.')}</p></div>${products[1] ? `<a class=\"archive-featured-object\" href=\"${productURL(products[1].id)}\">${photo(products[1], 'loading=\"lazy\"')}<span>${esc(products[1].name)} ${icon('arrow')}</span></a>` : ''}</section></section>`;\r\n}\r\n\r\nfunction expansionMonogramHome() {\r\n  const products = amsProducts();\r\n  if (!products.length) return `<div class=\"expansion-empty expansion-empty-monogram\">${empty('Koleksiyon hazırlanıyor.', 'Mağaza ürünleri hazır olduğunda monogram seçkisi burada görünecek.', 'Koleksiyonu aç', '#/catalog', 'spark')}</div>`;\r\n  const left = products[0], right = products[1] || products[0], lower = products.slice(2, 6);\r\n  return `<section class=\"expansion-home expansion-home-monogram\"><section class=\"monogram-hero\"><div class=\"monogram-hero-copy\"><span class=\"expansion-eyebrow\">${esc(T?.eyebrow || 'NOVA STORE / İMZA KOLEKSİYONU')}</span><h1>${esc(T?.hero || 'Sana ait bir<br>ışıltı.')}</h1><p>${esc(T?.sub || 'Sessiz, zarif ve her güne eşlik eden parçalar.')}</p><a class=\"expansion-primary-button\" href=\"${routeLink('catalog', {category: amsCategories()[0] || ''})}\">${esc(T?.cta || 'Koleksiyonu keşfet')} ${icon('arrow')}</a></div><div class=\"monogram-hero-photo\">${amsHeroImage('monogram-hero-image', T?.name || 'Nova Store monogram koleksiyonu')}</div></section><section class=\"monogram-intro\"><span class=\"monogram-mark\" aria-hidden=\"true\">N</span><p>${esc(hostBridge ? 'Mağaza kataloğundan seçilen parçalar.' : (T?.tag || 'Bir parçanın hikâyesi, onu nasıl taşıdığınla başlar.'))}</p><span class=\"monogram-rule\"></span></section><section class=\"monogram-grid\" aria-label=\"Öne çıkan ürünler\"><a class=\"monogram-grid-feature\" href=\"${productURL(left.id)}\">${photo(left, 'loading=\"lazy\"')}<span><small>${esc(left.category || '')}</small><strong>${esc(left.name)}</strong>${priceMarkup(left)}</span></a><a class=\"monogram-grid-tall\" href=\"${productURL(right.id)}\">${photo(right, 'loading=\"lazy\"')}<span><small>${esc(right.category || '')}</small><strong>${esc(right.name)}</strong></span></a><div class=\"monogram-grid-note\"><span class=\"expansion-eyebrow\">DETAYDA SAKLI</span><h2>Az ama<br>özenli.</h2><p>${esc(T?.desc || 'Her ürün, koleksiyonun sakin ritmine eşlik eder.')}</p><a href=\"#/catalog\">Tüm seçki ${icon('arrow')}</a></div></section><section class=\"monogram-quiet-cards\"><header><span class=\"expansion-eyebrow\">YENİ GELENLER</span><h2>Koleksiyonun sessiz parçaları</h2></header><div class=\"expansion-card-grid\">${lower.length ? lower.map(product => amsProductCard(product, 'monogram')).join('') : amsProductCard(left, 'monogram')}</div></section></section>`;\r\n}\r\n\r\nfunction amsSoundSpecs(product) {\r\n  const details = Array.isArray(product?.details) ? product.details.slice(0, 4) : [];\r\n  if (!details.length) return '<span class=\"sound-spec-empty\">Teknik bilgiler mağaza ürün sayfasında doğrulanır.</span>';\r\n  return details.map(([label, value]) => `<span><small>${esc(label)}</small><strong>${esc(value)}</strong></span>`).join('');\r\n}\r\n\r\nfunction expansionSoundHome() {\r\n  const products = amsProducts();\r\n  if (!products.length) return `<div class=\"expansion-empty expansion-empty-sound\">${empty('Stüdyo sessiz.', 'Mağaza ürünleri hazır olduğunda ekipman seçkisi burada görünecek.', 'Kataloğu aç', '#/catalog', 'headphones')}</div>`;\r\n  const lead = products[0], secondary = products[1] || products[0], rows = products.slice(0, 6);\r\n  return `<section class=\"expansion-home expansion-home-sound\"><section class=\"sound-stage\"><div class=\"sound-stage-copy\"><span class=\"expansion-eyebrow\">${esc(T?.eyebrow || 'NOVA STORE / AUDIO EDITION')}</span><h1>${esc(T?.hero || 'Sesi<br>yerine koy.')}</h1><p>${esc(T?.sub || 'Dinleme, üretme ve hareket için ekipman.')}</p><a class=\"expansion-primary-button\" href=\"#/catalog\">${esc(T?.cta || 'Sistemi kur')} ${icon('arrow')}</a><div class=\"sound-meter\" aria-label=\"Nova Store stüdyo ölçer\"><span></span><span></span><span></span><span></span><span></span><b>${hostBridge ? 'MAĞAZA' : 'NOVA / 03'}</b></div></div><div class=\"sound-stage-product\"><span class=\"sound-channel\">CH 01</span>${photo(lead, 'loading=\"eager\" fetchpriority=\"high\"')}<a href=\"${productURL(lead.id)}\"><small>${esc(lead.category || 'Ses')}</small><strong>${esc(lead.name)}</strong>${priceMarkup(lead)}</a></div></section><section class=\"sound-console\"><header><span class=\"expansion-eyebrow\">KONTROL PANELİ</span><h2>Kurulumunu tamamla.</h2><a href=\"#/catalog\">Tüm ekipman ${icon('arrow')}</a></header><div class=\"sound-console-grid\"><a class=\"sound-console-lead\" href=\"${productURL(lead.id)}\"><span class=\"sound-knob\" aria-hidden=\"true\"></span><div>${photo(lead, 'loading=\"lazy\"')}<small>ÖNE ÇIKAN SİNYAL</small><strong>${esc(lead.name)}</strong></div>${priceMarkup(lead)}</a><a class=\"sound-console-side\" href=\"${productURL(secondary.id)}\">${photo(secondary, 'loading=\"lazy\"')}<span><small>SONRAKİ PARÇA</small><strong>${esc(secondary.name)}</strong></span>${icon('arrow')}</a></div></section><section class=\"sound-spec-table\" aria-labelledby=\"sound-spec-title\"><header><span class=\"expansion-eyebrow\">TEKNİK NOTLAR</span><h2 id=\"sound-spec-title\">Yatay özellik satırları</h2></header>${rows.map((product, index) => `<a class=\"sound-spec-row\" href=\"${productURL(product.id)}\"><span class=\"sound-index\">${String(index + 1).padStart(2, '0')}</span><span class=\"sound-product\"><strong>${esc(product.name)}</strong><small>${esc(product.category || 'Ekipman')}</small></span><span class=\"sound-spec-values\">${amsSoundSpecs(product)}</span>${priceMarkup(product)}${icon('arrow')}</a>`).join('')}</section></section>`;\r\n}\r\n\r\nfunction expansionArchiveFooter() {\r\n  return `<footer class=\"expansion-footer expansion-footer-archive\"><div><span class=\"expansion-eyebrow\">NOVA STORE / ARŞİV</span><h2>${esc(T?.footerTitle || 'Bir sonraki iyi kayıt.')}</h2></div><nav aria-label=\"Nova Store bağlantıları\"><a href=\"#/catalog\">Koleksiyon</a><a href=\"#/favorites\">Favorilerim</a><a href=\"#/account\">Hesabım</a><a href=\"#/help\">Yardım merkezi</a></nav><span class=\"expansion-footer-note\">${hostBridge ? 'Son fiyat ve stok mağazada doğrulanır.' : 'Temsili ürünler · Gerçek ödeme yok'}</span></footer>`;\r\n}\r\n\r\nfunction expansionMonogramFooter() {\r\n  return `<footer class=\"expansion-footer expansion-footer-monogram\"><div class=\"monogram-footer-mark\">N</div><div><span class=\"expansion-eyebrow\">NOVA STORE / MONOGRAM</span><h2>${esc(T?.footerTitle || 'Hikâyenin bir parçası.')}</h2></div><nav aria-label=\"Nova Store bağlantıları\"><a href=\"#/catalog\">Koleksiyon</a><a href=\"#/favorites\">Favorilerim</a><a href=\"#/account\">Hesabım</a><a href=\"#/help\">Yardım</a></nav><span class=\"expansion-footer-note\">${hostBridge ? 'Mağaza koleksiyonu' : 'Bağımsız tema demosu'}</span></footer>`;\r\n}\r\n\r\nfunction expansionSoundFooter() {\r\n  return `<footer class=\"expansion-footer expansion-footer-sound\"><div><span class=\"expansion-eyebrow\">NOVA STORE / SOUND</span><h2>${esc(T?.footerTitle || 'Sistemi kendi ritmine göre kur.')}</h2></div><nav aria-label=\"Nova Store bağlantıları\"><a href=\"#/catalog\">Ekipman</a><a href=\"#/favorites\">Favorilerim</a><a href=\"#/account\">Hesabım</a><a href=\"#/help\">Yardım</a></nav><span class=\"expansion-footer-note\">${hostBridge ? 'Son fiyat ve stok mağazada doğrulanır.' : 'Temsili ekipman · Gerçek ödeme yok'}</span></footer>`;\r\n}\r\n\r\nfunction amsPresentationFor(expansionId) {\r\n  const id = expansionId || T?.expansionId || '';\r\n  return ({\r\n    archive: {header: expansionArchiveHeader, home: expansionArchiveHome, card: p => amsProductCard(p, 'archive'), footer: expansionArchiveFooter},\r\n    monogram: {header: expansionMonogramHeader, home: expansionMonogramHome, card: p => amsProductCard(p, 'monogram'), footer: expansionMonogramFooter},\r\n    sound: {header: expansionSoundHeader, home: expansionSoundHome, card: p => amsProductCard(p, 'sound'), footer: expansionSoundFooter}\r\n  })[id] || null;\r\n}\r\n\r\n/* Nova Store expansion presentations. Inject inside the existing core closure. */\r\n\r\nfunction tpProducts() {\r\n  return Array.isArray(T?.products) ? T.products.filter(Boolean) : [];\r\n}\r\n\r\nfunction tpCategories() {\r\n  return Array.isArray(T?.cats) ? T.cats.filter(value => typeof value === 'string' && value.trim()) : [];\r\n}\r\n\r\nfunction tpPick(index) {\r\n  const products = tpProducts();\r\n  return products[index] || products[0] || null;\r\n}\r\n\r\nfunction tpPhoto(product, extra = 'loading=\"lazy\" decoding=\"async\"') {\r\n  return product ? photo(product, extra) : '<span class=\"expansion-missing-media\" aria-hidden=\"true\">Görsel bekleniyor</span>';\r\n}\r\n\r\nfunction tpCategoryHref(category) {\r\n  return routeLink('catalog', {category: category || ''});\r\n}\r\n\r\nfunction tpEmpty(title, body, kind = 'mountain') {\r\n  return typeof empty === 'function'\r\n    ? empty(title, body, 'Kataloğu aç', '#/catalog', kind)\r\n    : `<div class=\"expansion-empty\"><strong>${esc(title)}</strong><p>${esc(body)}</p><a href=\"#/catalog\">Kataloğu aç</a></div>`;\r\n}\r\n\r\nfunction tpFavorite(id) {\r\n  return !!(state && Array.isArray(state.favorites) && state.favorites.includes(id));\r\n}\r\n\r\nfunction tpCompared(id) {\r\n  return typeof comparedProducts !== 'undefined' && comparedProducts && typeof comparedProducts.has === 'function' && comparedProducts.has(id);\r\n}\r\n\r\nfunction tpProductCard(product, variant) {\r\n  if (!product || product.id == null) return '';\r\n  const id = String(product.id);\r\n  const name = product.name || 'Ürün';\r\n  const variants = Array.isArray(product.variants) ? product.variants : [];\r\n  const unavailable = Number(product.stock) === 0 || Boolean(hostBridge && product.purchaseRequiresHostSelection && !product.canOpenProduct);\r\n  const purchaseLabel = unavailable ? 'Stokta yok' : (variants.length > 1 || product.purchaseRequiresHostSelection ? 'Seçenekleri gör' : 'Sepete ekle');\r\n  const favorite = tpFavorite(id);\r\n  const compared = tpCompared(id);\r\n  return `<article class=\"product-card expansion-card expansion-card-${variant}\" data-product-id=\"${esc(id)}\" data-price=\"${esc(product.price == null ? '' : product.price)}\">\r\n    <div class=\"expansion-card-media\"><a class=\"product-visual-link\" href=\"${productURL(id)}\" aria-label=\"${esc(name)} ürününü incele\">${tpPhoto(product)}</a>${product.badge ? `<span class=\"product-badge\">${esc(product.badge)}</span>` : ''}<button type=\"button\" class=\"favorite-button\" data-action=\"favorite\" data-id=\"${esc(id)}\" aria-label=\"${esc(name)}: ${favorite ? 'favorilerden çıkar' : 'favorilere ekle'}\" aria-pressed=\"${favorite}\">${icon('heart')}</button></div>\r\n    <div class=\"expansion-card-body\"><a class=\"expansion-card-category\" href=\"${tpCategoryHref(product.category)}\">${esc(product.category || 'Nova Store seçkisi')}</a><h3><a href=\"${productURL(id)}\">${esc(name)}</a></h3><p>${esc(product.description || product.details?.[0]?.[1] || 'Günlük kullanıma eşlik eden seçili ürün.')}</p><div class=\"expansion-card-bottom\">${priceMarkup(product)}<button type=\"button\" class=\"add-button\" data-action=\"quick-add\" data-id=\"${esc(id)}\" aria-label=\"${esc(name)}: ${purchaseLabel.toLocaleLowerCase('tr-TR')}\" ${unavailable ? 'disabled' : ''}>${icon(unavailable ? 'close' : 'bag')}<span>${purchaseLabel}</span></button></div></div>\r\n    <div class=\"expansion-card-tools\"><button type=\"button\" class=\"quick-view\" data-action=\"quick-view\" data-id=\"${esc(id)}\" aria-label=\"${esc(name)} hızlı görünüm\">${icon('search')}</button><button type=\"button\" class=\"expansion-compare\" data-action=\"compare-toggle\" data-id=\"${esc(id)}\" aria-label=\"${esc(name)} karşılaştır\" aria-pressed=\"${compared}\">${icon('refresh')}</button></div>\r\n  </article>`;\r\n}\r\n\r\nfunction expansionTerraCard(product) {\r\n  return tpProductCard(product, 'terra');\r\n}\r\n\r\nfunction expansionPopCard(product) {\r\n  return tpProductCard(product, 'pop');\r\n}\r\n\r\nfunction tpHeaderBase(className, label, placeholder) {\r\n  const categories = tpCategories();\r\n  return `<a class=\"skip-link\" href=\"#main-content\">İçeriğe atla</a><div class=\"expansion-ribbon\"><span>Nova Store · ${esc(label)}</span><button type=\"button\" data-action=\"theme-library\">Tema koleksiyonuna dön ${icon('arrow')}</button></div><header class=\"site-header expansion-header ${className}\"><div class=\"expansion-header-top\"><a class=\"expansion-menu\" href=\"#/catalog\" aria-label=\"Kategorileri aç\">${icon('menu')}</a><a class=\"expansion-brand\" href=\"#/home\" aria-label=\"Nova Store ana sayfa\">Nova Store<small>iyi seçimler, tek yerde</small></a><form id=\"search-form\" class=\"search-form\" role=\"search\"><label class=\"sr-only\" for=\"search-input\">Ürün veya kategori ara</label><input id=\"search-input\" name=\"q\" type=\"search\" maxlength=\"100\" autocomplete=\"off\" placeholder=\"${esc(placeholder)}\"><button type=\"submit\" aria-label=\"Ara\">${icon('search')}</button></form><nav class=\"expansion-actions\" aria-label=\"Hesap ve alışveriş\"><a href=\"#/account\" aria-label=\"Hesabım\">${icon('user')}<span>Hesabım</span></a><a href=\"#/favorites\" aria-label=\"Favorilerim\">${icon('heart')}<span class=\"count\" data-badge=\"favorite\" hidden>0</span></a><a href=\"#/cart\" aria-label=\"Sepetim\">${icon('bag')}<span>Sepetim</span><span class=\"count\" data-badge=\"cart\" hidden>0</span></a><button type=\"button\" data-action=\"compare-open\" aria-label=\"Ürünleri karşılaştır\">${icon('refresh')}</button></nav></div><nav class=\"expansion-category-nav\" aria-label=\"Koleksiyon gezinmesi\"><a href=\"#/catalog\">Tüm ürünler</a>${categories.map(category => `<a href=\"${tpCategoryHref(category)}\">${esc(category)}</a>`).join('')}</nav></header>`;\r\n}\r\n\r\nfunction expansionTerraHeader() {\r\n  return tpHeaderBase('expansion-header-terra', 'TERRA · AÇIK HAVA REHBERİ', 'Rota, ekipman veya kategori ara');\r\n}\r\n\r\nfunction expansionPopHeader() {\r\n  return tpHeaderBase('expansion-header-pop', 'POP · KIRTASİYE VE HEDİYE', 'Renk, hediye veya kategori ara');\r\n}\r\n\r\nfunction expansionTerraHome() {\r\n  const products = tpProducts();\r\n  if (!products.length) return `<section class=\"expansion-home expansion-home-terra\"><div class=\"expansion-container\">${tpEmpty('Rota hazırlanıyor.', 'Mağaza ürünleri yayınlandığında outdoor seçkisi burada görünecek.')}</div></section>`;\r\n  const lead = tpPick(0);\r\n  const second = tpPick(1);\r\n  const third = tpPick(2);\r\n  const categories = tpCategories().slice(0, 4).map((category, index) => `<a class=\"terra-route\" href=\"${tpCategoryHref(category)}\"><span>0${index + 1}</span><strong>${esc(category)}</strong>${icon('arrow')}</a>`).join('');\r\n  return `<section class=\"expansion-home expansion-home-terra\"><div class=\"expansion-container\"><section class=\"terra-hero\"><div class=\"terra-hero-copy\"><span class=\"expansion-eyebrow\">${esc(T?.eyebrow || 'NOVA STORE / FIELD GUIDE')}</span><h1>${esc(T?.hero || 'Dışarıda iyi yaşa.')}</h1><p>${esc(T?.sub || 'Rotana, mevsime ve günlük macerana eşlik edecek güvenilir ekipmanları seç.')}</p><a class=\"terra-button\" href=\"#/catalog\">Rotanı seç ${icon('arrow')}</a><dl class=\"terra-facts\"><div><dt>01</dt><dd>Sağlam seçim</dd></div><div><dt>02</dt><dd>Net ürün bilgisi</dd></div><div><dt>03</dt><dd>Yeni rota</dd></div></dl></div><div class=\"terra-hero-media\">${tpPhoto(lead, 'loading=\"eager\" fetchpriority=\"high\"')}<span class=\"terra-coordinate\">${hostBridge ? 'MAĞAZA KATALOĞU' : 'NOVA STORE SEÇKİSİ'}</span></div></section><section class=\"terra-routes\" aria-labelledby=\"terra-routes-title\"><header><span class=\"expansion-eyebrow\">SAHADAN SEÇİM</span><h2 id=\"terra-routes-title\">Bugünkü rotanı kur.</h2><a href=\"#/catalog\">Tüm ekipman ${icon('arrow')}</a></header><div class=\"terra-route-grid\">${categories || '<span class=\"terra-route-empty\">Kategoriler hazırlanıyor.</span>'}</div></section><section class=\"terra-field-grid\" aria-label=\"Öne çıkan outdoor ürünleri\"><a class=\"terra-feature\" href=\"${productURL(lead.id)}\">${tpPhoto(lead)}<span><small>ÖNE ÇIKAN / 01</small><strong>${esc(lead.name || 'Seçili ekipman')}</strong>${priceMarkup(lead)}</span></a>${second ? `<a class=\"terra-tall\" href=\"${productURL(second.id)}\">${tpPhoto(second)}<span><small>ÇANTA VE TAŞIMA</small><strong>${esc(second.name || 'İkinci seçim')}</strong></span></a>` : ''}<div class=\"terra-note\"><span class=\"expansion-eyebrow\">NOVA STORE / TERRA</span><h2>${esc(T?.tag || 'Her iyi rota, hazırlıkla başlar.')}</h2><p>${esc(T?.desc || 'Açık havada geçirilen zaman için sakin, işlevli ve güvenilir seçimler.')}</p><a href=\"#/catalog\">Sahayı keşfet ${icon('arrow')}</a></div>${third ? `<a class=\"terra-wide\" href=\"${productURL(third.id)}\"><span><small>03 / GÜNÜN EKİPMANI</small><strong>${esc(third.name || 'Ürün seçkisi')}</strong></span>${tpPhoto(third)}</a>` : ''}</section></div></section>`;\r\n}\r\n\r\nfunction expansionPopHome() {\r\n  const products = tpProducts();\r\n  if (!products.length) return `<section class=\"expansion-home expansion-home-pop\"><div class=\"expansion-container\">${tpEmpty('Renkli raf hazırlanıyor.', 'Mağaza ürünleri yayınlandığında kırtasiye ve hediye seçkisi burada görünecek.', 'gift')}</div></section>`;\r\n  const lead = tpPick(0);\r\n  const second = tpPick(1);\r\n  const third = tpPick(2);\r\n  const fourth = tpPick(3);\r\n  const cards = products.slice(0, 4).map(expansionPopCard).join('');\r\n  return `<section class=\"expansion-home expansion-home-pop\"><div class=\"expansion-container\"><section class=\"pop-hero\"><div class=\"pop-hero-copy\"><span class=\"expansion-eyebrow\">${esc(T?.eyebrow || 'NOVA STORE / KÜÇÜK MUTLULUKLAR')}</span><h1>${esc(T?.hero || 'Bugüne biraz renk.')}</h1><p>${esc(T?.sub || 'Masana, çantana ve sevdiklerine neşe katacak kırtasiye ve hediye fikirleri.')}</p><a class=\"pop-button\" href=\"#/catalog\">Rafları karıştır ${icon('arrow')}</a><span class=\"pop-sticker\">BİR FİKİR<br><strong>YETER.</strong></span></div><div class=\"pop-hero-media\">${tpPhoto(lead, 'loading=\"eager\" fetchpriority=\"high\"')}<span class=\"pop-media-label\">01 / YENİ GELEN</span></div></section><section class=\"pop-swatch-row\" aria-label=\"Koleksiyon kategorileri\">${tpCategories().slice(0, 5).map((category, index) => `<a href=\"${tpCategoryHref(category)}\"><span class=\"pop-swatch pop-swatch-${(index % 5) + 1}\">${String(index + 1).padStart(2, '0')}</span><strong>${esc(category)}</strong>${icon('arrow')}</a>`).join('') || '<span class=\"pop-route-empty\">Kategoriler hazırlanıyor.</span>'}</section><section class=\"pop-board\" aria-labelledby=\"pop-board-title\"><header><div><span class=\"expansion-eyebrow\">KÜÇÜK ŞEYLER, İYİ GÜNLER</span><h2 id=\"pop-board-title\">Hediye gibi fikirler.</h2></div><a href=\"#/catalog\">Tüm seçki ${icon('arrow')}</a></header><div class=\"pop-collage\">${second ? `<a class=\"pop-collage-card pop-collage-yellow\" href=\"${productURL(second.id)}\"><span>ÇANTANA</span><strong>${esc(second.name || 'Renkli bir seçim')}</strong>${tpPhoto(second)}</a>` : ''}${third ? `<a class=\"pop-collage-card pop-collage-blue\" href=\"${productURL(third.id)}\">${tpPhoto(third)}<span>MASANA</span><strong>${esc(third.name || 'Güzel bir ayrıntı')}</strong></a>` : ''}<div class=\"pop-collage-copy\"><span class=\"pop-number\">02</span><h3>${esc(T?.tag || 'Kullanırken gülümsetecek ayrıntılar.')}</h3><p>${esc(T?.desc || 'Renkli, kullanışlı ve paylaşmaya hazır bir Nova Store seçkisi.')}</p><a href=\"#/catalog\">Fikri bul ${icon('arrow')}</a></div>${fourth ? `<a class=\"pop-collage-card pop-collage-coral\" href=\"${productURL(fourth.id)}\"><span>HEDİYEYE</span><strong>${esc(fourth.name || 'Bir başkasına iyi gelsin')}</strong>${tpPhoto(fourth)}</a>` : ''}</div></section><section class=\"pop-shelf\" aria-labelledby=\"pop-shelf-title\"><header><div><span class=\"expansion-eyebrow\">NOVA STORE / POP</span><h2 id=\"pop-shelf-title\">Seç, karıştır, paylaş.</h2></div><a href=\"#/catalog\">Kırtasiye rafı ${icon('arrow')}</a></header><div class=\"pop-product-grid\">${cards}</div></section></div></section>`;\r\n}\r\n\r\nfunction expansionTerraFooter() {\r\n  return `<footer class=\"site-footer expansion-footer expansion-footer-terra\"><div class=\"expansion-container\"><section class=\"terra-footer-cta\"><span class=\"expansion-eyebrow\">NOVA STORE / TERRA</span><h2>Bir sonraki rotaya hazırlan.</h2><a class=\"terra-button\" href=\"#/catalog\">Ekipmanı keşfet ${icon('arrow')}</a></section><div class=\"expansion-footer-grid\"><div><a class=\"expansion-brand\" href=\"#/home\">Nova Store</a><p>Dışarıda iyi yaşamak için seçili ekipman.</p></div><nav aria-label=\"Terra kategorileri\"><h3>Rotalar</h3>${tpCategories().slice(0, 5).map(category => `<a href=\"${tpCategoryHref(category)}\">${esc(category)}</a>`).join('')}</nav><nav aria-label=\"Nova Store destek\"><h3>Yanındayız</h3><a href=\"#/account\">Hesabım</a><a href=\"#/orders\">Siparişlerim</a><button type=\"button\" data-action=\"delivery-info\">Teslimat ve iade</button></nav></div><div class=\"expansion-footer-bottom\"><span>© 2026 Nova Store</span><button type=\"button\" data-action=\"privacy-info\">Gizlilik ve demo bilgisi</button><span>${hostBridge ? 'Son fiyat ve stok mağazada doğrulanır.' : 'Temsili ürünler · Gerçek ödeme yok'}</span></div></div></footer>`;\r\n}\r\n\r\nfunction expansionPopFooter() {\r\n  return `<footer class=\"site-footer expansion-footer expansion-footer-pop\"><div class=\"expansion-container\"><section class=\"pop-footer-cta\"><span class=\"expansion-eyebrow\">NOVA STORE / POP</span><h2>İyi fikirler çoğalsın.</h2><p>Masana, çantana veya bir arkadaşına yakışacak seçimi bul.</p><a class=\"pop-button\" href=\"#/catalog\">Renkli rafa dön ${icon('arrow')}</a></section><div class=\"expansion-footer-grid\"><div><a class=\"expansion-brand\" href=\"#/home\">Nova Store</a><p>Günlük hayata küçük bir renk.</p></div><nav aria-label=\"Pop kategorileri\"><h3>Koleksiyon</h3>${tpCategories().slice(0, 5).map(category => `<a href=\"${tpCategoryHref(category)}\">${esc(category)}</a>`).join('')}</nav><nav aria-label=\"Nova Store destek\"><h3>Yanındayız</h3><a href=\"#/favorites\">Favorilerim</a><a href=\"#/help\">Yardım merkezi</a><button type=\"button\" data-action=\"delivery-info\">Teslimat bilgileri</button></nav></div><div class=\"expansion-footer-bottom\"><span>© 2026 Nova Store</span><button type=\"button\" data-action=\"privacy-info\">Gizlilik ve demo bilgisi</button><span>${hostBridge ? 'Son fiyat ve stok mağazada doğrulanır.' : 'Temsili ürünler · Gerçek ödeme yok'}</span></div></div></footer>`;\r\n}\r\n\r\nfunction tpPresentationFor(expansionId) {\r\n  const id = expansionId || T?.expansionId || '';\r\n  return ({\r\n    terra: {header: expansionTerraHeader, home: expansionTerraHome, card: expansionTerraCard, footer: expansionTerraFooter},\r\n    pop: {header: expansionPopHeader, home: expansionPopHome, card: expansionPopCard, footer: expansionPopFooter}\r\n  })[id] || null;\r\n}\r\n\r\nfunction expansionArchiveCard(p){return amsProductCard(p,'archive');}\r\nfunction expansionMonogramCard(p){return amsProductCard(p,'monogram');}\r\nfunction expansionSoundCard(p){return amsProductCard(p,'sound');}\r\n// Shared application shell: touch navigation, compact top bar, no desktop footer.\r\nfunction isApplicationSurface(){return document.body.dataset.mode==='app';}\r\nfunction applicationHeader(){\r\n  const editorial=['interior','editorial','jewelry','books','archive','monogram'].includes(T.expansionId||T.style);\r\n  return `<header class=\"application-header ${editorial?'is-editorial':'is-shopping'}\"><div class=\"application-topline\"><a class=\"application-brand\" href=\"#/home\" aria-label=\"Nova Store ana sayfa\">Nova Store<span>${esc(T.sector||'Senin mağazan')}</span></a><nav aria-label=\"Uygulama araçları\"><a href=\"#/support\" aria-label=\"Destek merkezi\">${icon('info')}</a><a href=\"#/cart\" aria-label=\"Sepetim\">${icon('bag')}<span class=\"count\" data-badge=\"cart\" hidden>0</span></a></nav></div><form id=\"search-form\" class=\"application-search\" role=\"search\"><label class=\"sr-only\" for=\"search-input\">Ürün veya kategori ara</label>${icon('search')}<input id=\"search-input\" name=\"q\" type=\"search\" placeholder=\"Mağazada ara\" autocomplete=\"off\" maxlength=\"100\"><button type=\"submit\" aria-label=\"Ara\">${icon('arrow')}</button></form><nav class=\"application-categories\" aria-label=\"Uygulama kategorileri\"><a href=\"#/catalog\">Tümü</a>${T.cats.map(c=>`<a href=\"${routeLink('catalog',{category:c})}\">${esc(c)}</a>`).join('')}</nav></header>`;\r\n}\r\nfunction bindApplicationCategories(){\r\n  document.addEventListener('click',event=>{\r\n    if(!isApplicationSurface())return;\r\n    const link=event.target.closest('a[href^=\"#/catalog?\"]');\r\n    if(!link||link.closest('#info-dialog,.filter-sidebar,.filter-panel,.filters,.filter-chips,.active-filters,.catalog-toolbar'))return;\r\n    const category=new URLSearchParams(link.getAttribute('href').split('?')[1]).get('category');\r\n    if(!category||!T.cats.includes(category))return;\r\n    event.preventDefault();event.stopImmediatePropagation();\r\n    const items=T.products.filter(p=>p.category===category).slice(0,4);\r\n    showDialog(category,`<div class=\"application-category-sheet\"><p>İlgini çeken ürüne dokun veya kategorinin tamamını keşfet.</p>${items.map(p=>`<a href=\"${productURL(p.id)}\" data-app-category-destination><span>${photo(p,'loading=\"lazy\"')}</span><span><strong>${esc(p.name)}</strong>${priceMarkup(p)}</span>${icon('arrow')}</a>`).join('')}<a href=\"${routeLink('catalog',{category})}\" class=\"button\" data-app-category-destination>${esc(category)} · tümünü gör ${icon('arrow')}</a></div>`);\r\n  },true);\r\n  document.addEventListener('click',event=>{if(event.target.closest('[data-app-category-destination]'))closeDialog();},true);\r\n}\r\n\r\nbindApplicationCategories();\r\n/* Support-center closure fragment. Inject after support-contract.js and before core render wiring. */\r\n\r\nconst supportSampleThreads = [\r\n  {id: 'local-welcome', scope: {tenantId: 'local-demo', storeId: 'local-demo'}, storeId: 'local-demo', title: 'Örnek destek akışı', status: 'open', messages: [{id: 'local-1', from: 'support', message: 'Merhaba. Bu yerel demoda destek ekranını ve konu başlıklarını inceleyebilirsin.', createdAt: '2026-09-15T09:00:00Z'}]}\r\n];\r\n\r\nfunction supportHostPort() {\r\n  return hostBridge && (hostBridge.support || hostBridge.supportPort || null);\r\n}\r\n\r\nfunction supportRuntime() {\r\n  const api = window.NovaStoreSupportRuntime;\r\n  if (!api || typeof api.create !== 'function') return null;\r\n  if (!hostBridge) return api.create({mode: 'local', platform: document.body?.dataset?.mode === 'app' ? 'app' : 'web', sampleThreads: supportSampleThreads});\r\n  return api.create({mode: 'host', hostBridge, port: supportHostPort()});\r\n}\r\n\r\nfunction supportText(value, fallback = '') {\r\n  const raw = String(value == null ? '' : value).trim();\r\n  return raw || fallback;\r\n}\r\n\r\nfunction supportFaqMarkup() {\r\n  const items = [\r\n    ['Siparişimi nasıl takip ederim?', 'Hesabım bölümünden siparişini ve teslimat durumunu görebilirsin.'],\r\n    ['İade veya değişim nasıl başlatılır?', 'Siparişinin içinden İade veya değişim seçeneğini açıp adımları izleyebilirsin.'],\r\n    ['Destek mesajlarıma nasıl ulaşırım?', 'Yardım ve Destek bölümünde önceki görüşmelerini görebilir, seçtiğin görüşmeden devam edebilirsin.']\r\n  ];\r\n  return items.map(([question, answer], index) => `<details${index === 0 ? ' open' : ''}><summary>${esc(question)}</summary><p>${esc(answer)}</p></details>`).join('');\r\n}\r\n\r\nfunction supportStatusMarkup(runtime) {\r\n  const stateNow = runtime?.state?.() || {phase: 'idle', mode: 'host', context: null};\r\n  if (!runtime) return '<p class=\"support-center-status\" role=\"status\">Destek ekranı bu yüzeyde kullanılamıyor.</p>';\r\n  if (stateNow.mode === 'local') return '<p class=\"support-center-status is-demo\" role=\"status\">Yerel demo · mesaj veya destek kaydı gönderilmez.</p>';\r\n  if (!runtime.available) return '<p class=\"support-center-status\" role=\"status\">Bu mağazada destek bağlantısı henüz etkin değil.</p>';\r\n  if (stateNow.phase !== 'ready' || !stateNow.context) return '<p class=\"support-center-status\" role=\"status\">Mağaza ve kullanıcı bağlamı sunucudan doğrulanıyor.</p>';\r\n  return `<p class=\"support-center-status is-ready\" role=\"status\">${esc(stateNow.context.recipient.name)} · ${esc(stateNow.context.store.name)} · ${stateNow.context.platform === 'app' ? 'Uygulama' : 'Web'} desteği</p>`;\r\n}\r\n\r\nfunction renderSupportCenter() {\r\n  const runtime = supportRuntime();\r\n  const hostReady = Boolean(runtime?.available && runtime.state?.().phase === 'ready' && runtime.state?.().context);\r\n  const disabled = !runtime || (runtime.mode === 'host' && !hostReady);\r\n  return `<section id=\"support-center\" class=\"support-center\" aria-labelledby=\"support-center-title\"><header class=\"support-center-head\"><div><span class=\"support-kicker\">NOVA STORE / YARDIM</span><h1 id=\"support-center-title\">Yardım ve Destek</h1><p>Sorunu anlat, doğru mağaza bağlamında ilerleyelim.</p></div><a class=\"support-back\" href=\"#/home\">Mağazaya dön</a></header>${supportStatusMarkup(runtime)}<nav class=\"support-tabs\" aria-label=\"Destek bölümleri\"><button type=\"button\" data-support-view=\"chat\" aria-selected=\"true\">Destek mesajları</button><button type=\"button\" data-support-view=\"help\" aria-selected=\"false\">Sık sorulanlar</button><button type=\"button\" data-support-view=\"ticket\" aria-selected=\"false\">Yeni konu</button></nav><div class=\"support-panel\" data-support-panel=\"chat\"><div class=\"support-context\" data-support-context>Mağaza bağlamı doğrulanıyor.</div><label class=\"support-thread-picker\" for=\"support-thread-select\">Görüşme<select id=\"support-thread-select\" data-support-thread-select ${disabled ? 'disabled' : ''}><option value=\"\">Görüşme yükleniyor...</option></select></label><div class=\"support-thread\" data-support-thread role=\"log\" aria-live=\"polite\" aria-label=\"Destek görüşmesi\"><p class=\"support-empty\">Destek geçmişi yükleniyor.</p></div><form class=\"support-composer\" data-support-form=\"chat\"><label for=\"support-message\">Mesajın</label><textarea id=\"support-message\" name=\"message\" maxlength=\"2000\" rows=\"4\" placeholder=\"Sorunu veya merakını yaz...\" ${disabled ? 'disabled' : ''}></textarea><button type=\"submit\" ${disabled ? 'disabled' : ''}>${runtime?.mode === 'local' ? 'Demo yanıtını gör' : 'Mesajı gönder'}</button><small>Şifre, kart bilgisi veya erişim anahtarı paylaşma.</small></form></div><div class=\"support-panel\" data-support-panel=\"help\" hidden><div class=\"support-faq\">${supportFaqMarkup()}</div></div><div class=\"support-panel\" data-support-panel=\"ticket\" hidden><form class=\"support-ticket-form\" data-support-form=\"ticket\"><label for=\"support-ticket-title\">Konu<input id=\"support-ticket-title\" name=\"title\" maxlength=\"120\" required placeholder=\"Örn. Sipariş teslimatı\"></label><label for=\"support-ticket-detail\">Açıklama<textarea id=\"support-ticket-detail\" name=\"detail\" maxlength=\"2000\" rows=\"6\" required placeholder=\"Nasıl yardımcı olabiliriz?\" ${disabled ? 'disabled' : ''}></textarea></label><button type=\"submit\" ${disabled ? 'disabled' : ''}>${runtime?.mode === 'local' ? 'Demo formunu incele' : 'Destek kaydı oluştur'}</button><small>Yerel demoda kayıt gönderilmez. Bağlı mağazada işlem sunucu yanıtı ile doğrulanır.</small></form></div><p class=\"support-center-feedback\" data-support-feedback role=\"status\"></p></section>`;\r\n}\r\n\r\nfunction initializeSupportCenter() {\r\n  const root = document.getElementById('support-center');\r\n  if (!root) return () => {};\r\n  const runtime = supportRuntime();\r\n  let generation = 0;\r\n  let activeView = 'chat';\r\n  let selectedThreadId = '';\r\n  let submitPending = false;\r\n  let submitOperation = 0;\r\n  const cleanups = [];\r\n  const feedback = root.querySelector('[data-support-feedback]');\r\n  const thread = root.querySelector('[data-support-thread]');\r\n  const contextLabel = root.querySelector('[data-support-context]');\r\n  const setFeedback = value => { if (feedback) feedback.textContent = supportText(value); };\r\n  const renderState = current => {\r\n    if (!current) return;\r\n    const context = current.context;\r\n    if (contextLabel) contextLabel.textContent = current.mode === 'local' ? 'Yerel demo · örnek görüşme; gerçek mesaj gönderilmez.' : context ? `${context.recipient.name} · ${context.store.name} · ${context.platform === 'app' ? 'Uygulama' : 'Web'} desteği` : 'Mağaza bağlamı doğrulanıyor.';\r\n    root.querySelector('.support-center-status')?.replaceWith(Object.assign(document.createElement('p'), {className: 'support-center-status', role: 'status', textContent: current.mode === 'local' ? 'Yerel demo · mesaj veya destek kaydı gönderilmez.' : current.phase === 'ready' && context ? `${context.recipient.name} · ${context.store.name} · ${context.platform === 'app' ? 'Uygulama' : 'Web'} desteği` : 'Mağaza ve kullanıcı bağlamı sunucudan doğrulanıyor.'}));\r\n    const disabled = submitPending || current.mode === 'host' && (current.phase !== 'ready' || !context);\r\n    root.querySelectorAll('[data-support-form] textarea,[data-support-form] button').forEach(element => { element.disabled = disabled; });\r\n    const picker = root.querySelector('[data-support-thread-select]');\r\n    if (picker) picker.disabled = disabled || !Array.isArray(current.threads) || current.threads.length === 0;\r\n  };\r\n  const appendThread = current => {\r\n    if (!thread) return;\r\n    thread.replaceChildren();\r\n    const threads = Array.isArray(current?.threads) ? current.threads : [];\r\n    const picker = root.querySelector('[data-support-thread-select]');\r\n    if (!selectedThreadId || !threads.some(item => item.id === selectedThreadId)) selectedThreadId = threads[0]?.id || '';\r\n    if (picker) {\r\n      picker.replaceChildren();\r\n      threads.forEach(item => { const option = document.createElement('option'); option.value = item.id; option.textContent = item.title; option.selected = item.id === selectedThreadId; picker.append(option); });\r\n      if (!threads.length) { const option = document.createElement('option'); option.value = ''; option.textContent = 'Henüz görüşme yok'; picker.append(option); }\r\n    }\r\n    const selected = threads.find(item => item.id === selectedThreadId);\r\n    const messages = selected && Array.isArray(selected.messages) ? selected.messages : [];\r\n    if (!messages.length) { const emptyNode = document.createElement('p'); emptyNode.className = 'support-empty'; emptyNode.textContent = current?.mode === 'local' ? 'Yerel demoda örnek görüşme bulunmuyor.' : 'Henüz destek mesajı yok.'; thread.append(emptyNode); return; }\r\n    messages.slice(-30).forEach(message => { const article = document.createElement('article'); article.className = `support-message is-${message.from === 'customer' ? 'customer' : 'support'}`; const title = document.createElement('strong'); title.textContent = message.from === 'customer' ? 'Sen' : 'Nova Store destek'; const body = document.createElement('p'); body.textContent = message.message; article.append(title, body); thread.append(article); });\r\n  };\r\n  const clearForIdentityChange = error => {\r\n    if (!['AUTH_CHANGED', 'AUTH_REQUIRED', 'SCOPE_MISMATCH', 'STALE_CONTEXT'].includes(error?.code)) return false;\r\n    runtime?.invalidate?.(); selectedThreadId = ''; appendThread({...runtime?.state?.(), threads: []}); generation += 1; return true;\r\n  };\r\n  const selectView = view => { activeView = ['chat', 'help', 'ticket'].includes(view) ? view : 'chat'; root.querySelectorAll('[data-support-view]').forEach(button => { const selected = button.dataset.supportView === activeView; button.setAttribute('aria-selected', String(selected)); }); root.querySelectorAll('[data-support-panel]').forEach(panel => { panel.hidden = panel.dataset.supportPanel !== activeView; }); };\r\n  root.querySelectorAll('[data-support-view]').forEach(button => { const handler = () => selectView(button.dataset.supportView); button.addEventListener('click', handler); cleanups.push(() => button.removeEventListener('click', handler)); });\r\n  const onHostState = snapshot => {\r\n    const before = runtime?.state?.();\r\n    runtime?.syncIdentity?.(snapshot);\r\n    const after = runtime?.state?.();\r\n    generation += 1;\r\n    if (before?.context !== after?.context || after?.phase !== 'ready') { selectedThreadId = ''; appendThread({...after, threads: []}); }\r\n    renderState(after);\r\n  };\r\n  if (hostBridge && typeof hostBridge.subscribe === 'function') cleanups.push(hostBridge.subscribe(onHostState));\r\n  if (runtime) cleanups.push(runtime.subscribe(renderState));\r\n  const start = async () => {\r\n    if (!runtime) { setFeedback('Destek bağlantısı bu yüzeyde hazır değil.'); return; }\r\n    const token = generation;\r\n    try { const current = await runtime.initialize(); if (token !== generation) return; renderState(current); await runtime.readThreads(); if (token !== generation) return; appendThread(runtime.state()); }\r\n    catch (error) { if (token === generation) { clearForIdentityChange(error); renderState(runtime.state()); setFeedback(error?.message || 'Destek bağlantısı hazır değil.'); } }\r\n  };\r\n  const chatForm = root.querySelector('[data-support-form=\"chat\"]');\r\n  const ticketForm = root.querySelector('[data-support-form=\"ticket\"]');\r\n  const threadPicker = root.querySelector('[data-support-thread-select]');\r\n  const selectThread = () => { selectedThreadId = threadPicker?.value || ''; appendThread(runtime?.state?.()); };\r\n  const submitChat = async event => {\r\n    event.preventDefault();\r\n    if (!runtime || submitPending) return;\r\n    const token = generation, operation = ++submitOperation; const form = new FormData(chatForm); const message = String(form.get('message') || '').trim(); if (!message) return; const threadId = selectedThreadId || runtime.state?.().threads?.[0]?.id || '';\r\n    submitPending = true; renderState(runtime.state()); setFeedback('Yanıt hazırlanıyor...');\r\n    try { const result = await runtime.sendMessage(threadId, message); if (token !== generation || operation !== submitOperation) return; chatForm.reset(); setFeedback(result.sent === true ? result.message : result.message || 'Yerel demo: mesaj gönderilmedi.'); }\r\n    catch (error) { if (token === generation && operation === submitOperation) { clearForIdentityChange(error); setFeedback(error?.message || 'Mesaj gönderilemedi.'); } }\r\n    finally { if (operation === submitOperation) { submitPending = false; renderState(runtime.state()); } }\r\n  };\r\n  const submitTicket = async event => {\r\n    event.preventDefault();\r\n    if (!runtime || submitPending) return;\r\n    const token = generation, operation = ++submitOperation; const form = new FormData(ticketForm);\r\n    submitPending = true; renderState(runtime.state()); setFeedback('Destek formu kontrol ediliyor...');\r\n    try { const result = await runtime.createTicket({title: form.get('title'), detail: form.get('detail')}); if (token !== generation || operation !== submitOperation) return; ticketForm.reset(); setFeedback(result.created === true ? result.message : result.message || 'Yerel demo: kayıt oluşturulmadı.'); }\r\n    catch (error) { if (token === generation && operation === submitOperation) { clearForIdentityChange(error); setFeedback(error?.message || 'Destek kaydı oluşturulamadı.'); } }\r\n    finally { if (operation === submitOperation) { submitPending = false; renderState(runtime.state()); } }\r\n  };\r\n  chatForm?.addEventListener('submit', submitChat); ticketForm?.addEventListener('submit', submitTicket); threadPicker?.addEventListener('change', selectThread); cleanups.push(() => chatForm?.removeEventListener('submit', submitChat), () => ticketForm?.removeEventListener('submit', submitTicket), () => threadPicker?.removeEventListener('change', selectThread));\r\n  window.NovaStoreSupportUI?.dispose?.();\r\n  window.NovaStoreSupportUI = Object.freeze({dispose() { generation += 1; ++submitOperation; submitPending = false; cleanups.splice(0).forEach(cleanup => { try { cleanup(); } catch (_) {} }); if (window.NovaStoreSupportUI?.dispose === this.dispose) delete window.NovaStoreSupportUI; }});\r\n  renderState(runtime?.state?.()); appendThread(runtime?.state?.()); void start();\r\n  return window.NovaStoreSupportUI.dispose;\r\n}\r\n\r\n  document.body.dataset.theme=T.id;document.body.dataset.style=T.style;\r\n  document.getElementById('app').innerHTML=`<div class=\"storefront\">${header()}<main id=\"main-content\" class=\"main-content\" tabindex=\"-1\"></main>${footer()}${bottomNav()}<button type=\"button\" hidden class=\"compare-tray application-compare-tray\" data-action=\"compare-open\">Karşılaştır</button></div><div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div><dialog id=\"info-dialog\" aria-labelledby=\"dialog-title\"></dialog>`;\r\n  const dialog=document.getElementById('info-dialog');\r\n  dialog.addEventListener('close',()=>{document.body.classList.remove('dialog-open');if(dialogOpener?.isConnected)dialogOpener.focus({preventScroll:true});});\r\n  dialog.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)closeDialog();}});\r\n  render();\r\n  initializeNovaBot();\r\n  if(hostBridge)hostBridge.subscribe(syncHostSnapshot);\r\n  if(storageWasReset)toast('Bozulmuş demo kaydı güvenle sıfırlandı.');\r\n  // Public read-only handoff adapter: no hidden API or backend integrations.\r\n  if(!hostBridge)window.NovaThemeDemo=Object.freeze({version:'1.0.0',themeId:T.id,storageKey:KEY,getSnapshot:()=>JSON.parse(JSON.stringify(state)),getTotals:()=>({...totals()}),navigate});\r\n})();\r\n\r\n</script></body></html>"