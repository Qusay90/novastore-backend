ewport; never hide overflow to fit. */\r\nbody[data-mode=\"app\"]:is([data-theme=\"23-nova-archive\"],[data-theme=\"24-nova-monogram\"],[data-theme=\"25-nova-sound\"]) .expansion-home {\r\n  width:calc(100% - 32px);\r\n  min-width:0;\r\n  padding:32px 0;\r\n}\r\nbody[data-mode=\"app\"]:is([data-theme=\"23-nova-archive\"],[data-theme=\"24-nova-monogram\"],[data-theme=\"25-nova-sound\"]) .expansion-home :is(section,header,a,div,span) {\r\n  min-width:0;\r\n}\r\nbody[data-mode=\"app\"]:is([data-theme=\"23-nova-archive\"],[data-theme=\"24-nova-monogram\"],[data-theme=\"25-nova-sound\"]) .expansion-home :is(h1,h2,h3,strong,p) {\r\n  overflow-wrap:anywhere;\r\n}\r\nbody[data-mode=\"app\"]:is([data-theme=\"23-nova-archive\"],[data-theme=\"24-nova-monogram\"],[data-theme=\"25-nova-sound\"]) :is(.archive-hero,.archive-featured,.monogram-hero,.monogram-grid,.expansion-card-grid,.sound-stage,.sound-console-grid,.sound-console-lead) {\r\n  grid-template-columns:minmax(0,1fr)!important;\r\n  min-height:0;\r\n  gap:24px;\r\n}\r\nbody[data-mode=\"app\"]:is([data-theme=\"23-nova-archive\"],[data-theme=\"24-nova-monogram\"],[data-theme=\"25-nova-sound\"]) :is(.archive-index,.archive-featured,.monogram-quiet-cards,.sound-console,.sound-spec-table) {\r\n  margin-top:48px;\r\n}\r\nbody[data-mode=\"app\"]:is([data-theme=\"23-nova-archive\"],[data-theme=\"24-nova-monogram\"],[data-theme=\"25-nova-sound\"]) :is(.archive-index,.monogram-quiet-cards,.sound-console,.sound-spec-table)>header {\r\n  display:flex!important;\r\n  flex-direction:column;\r\n  align-items:flex-start;\r\n  gap:12px;\r\n}\r\nbody[data-mode=\"app\"][data-theme=\"23-nova-archive\"] .archive-hero-art {\r\n  order:-1;\r\n  min-height:0;\r\n  aspect-ratio:1.25;\r\n}\r\nbody[data-mode=\"app\"][data-theme=\"23-nova-archive\"] .archive-hero-image {height:100%;max-height:none;object-fit:cover}\r\nbody[data-mode=\"app\"][data-theme=\"23-nova-archive\"] .archive-fact-list {gap:16px;margin-top:24px}\r\nbody[data-mode=\"app\"][da